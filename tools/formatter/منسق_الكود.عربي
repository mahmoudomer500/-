# منسق الكود - Arabic Code Formatter
# ينسق الكود العربي بإصلاح المسافات البادئة

دالة تنسيق_الكود(نص):
    مت نتيجة = ""
    مت مسافة = 0
    مت خطوط = نص.تقسيم("\n")
    
    لكل سطر في خطوط:
        مت مقطع = سطر.تقليم()
        
        إذا مقطع == "نهاية":
            مسافة = مسافة - 1
            إذا مسافة < 0:
                مسافة = 0
            نهاية
        
        مت بادئة = ""
        مت ع = 0
        بينما ع < مسافة:
            بادئة = بادئة + "    "
            ع = ع + 1
        نهاية
        
        إذا مقطع != "":
            نتيجة = نتيجة + بادئة + مقطع + "\n"
        نهاية
        
        إذا مقطع.يحتوي("دالة") أو مقطع.يحتوي("إذا") أو مقطع.يحتوي("وإلا") أو مقطع.يحتوي("بينما") أو مقطع.يحتوي("لكل") أو مقطع.يحتوي("صف") أو مقطع.يحتوي("صنف"):
            إذا ليس مقطع.يحتوي("نهاية"):
                مسافة = مسافة + 1
            نهاية
        نهاية
    نهاية
    
    أرجع نتيجة
