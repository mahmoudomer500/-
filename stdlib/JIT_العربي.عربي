دالة أزل_تعليمات_زائدة_x86_64(كود_آلي):
    # إزالة التعليمات الزائدة في x86-64
    مت أقسام_محسنة = {}
    
    لكل قسم في ["مقدمة", "جسم", "خاتمة"]
        مت تعليمات_محسنة = []
        مت تعليمة_سابقة = ""
        
        لكل تعليمة في كود_آلي[قسم]
            # إزالة التعليقات الفارغة
            إذا تعليمة.يبدأ_بـ("#") و تعليمة.تنظيف() == "#"
                استمر
            نهاية
            
            # إزالة MOV x, x
            إذا تعليمة.يحتوي("mov ") و تعليمة.يحتوي(", ")
                مت أجزاء = تعليمة.انقسم(", ")
                إذا أجزاء.طول == 2
                    مت مصدر = أجزاء[0].انقسم(" ")[1]
                    مت هدف = أجزاء[1].تنظيف()
                    إذا مصدر == هدف
                        استمر # تخطي هذه التعليمة
                    نهاية
                نهاية
            نهاية
            
            # إزالة التعليمات المتكررة
            إذا تعليمة != تعليمة_سابقة
                تعليمات_محسنة = أضف(تعليمات_محسنة, تعليمة)
                تعليمة_سابقة = تعليمة
            نهاية
        نهاية
        
        أقسام_محسنة[قسم] = تعليمات_محسنة
    نهاية
    
    كود_آلي["مقدمة"] = أقسام_محسنة["مقدمة"]
    كود_آلي["جسم"] = أقسام_محسنة["جسم"]
