دالة طبق_List_Scheduling(كود_مترجم، رسم_التبعيات):
    # تطبيق خوارزمية List Scheduling
    مت تعليمات_مجدولة = []
    مت تعليمات_جاهزة = []
    مت تعليمات_منتهية = {}
    
    # العثور على التعليمات الجاهزة (بدون تبعيات)
    لكل مؤشر في مفاتيح(كود_مترجم)
        مت لها_تبعيات = خطأ
        لكل حافة في رسم_التبعيات["حواف"]
            إذا حافة["إلى"] == مؤشر
                لها_تبعيات = صحيح
                اكسر
            نهاية
        نهاية
        
        إذا ليس لها_تبعيات
            تعليمات_جاهزة = أضف(تعليمات_جاهزة, مؤشر)
        نهاية
    نهاية
    
    # جدولة التعليمات
    طالما تعليمات_جاهزة.طول > 0
        # اختيار أفضل تعليمة
        مت تعليمة_مختارة = اختر_أفضل_تعليمة_للجدولة(تعليمات_جاهزة, كود_مترجم)
        
        # إضافة للجدولة
        تعليمات_مجدولة = أضف(تعليمات_مجدولة, كود_مترجم[تعليمة_مختارة])
        تعليمات_منتهية[تعليمة_مختارة] = صحيح
        
        # إزالة من الجاهزة
        تعليمات_جاهزة = أزل_من_القائمة(تعليمات_جاهزة, تعليمة_مختارة)
        
        # تحديث التعليمات الجاهزة
        تعليمات_جاهزة = حدث_التعليمات_الجاهزة_متقدم(تعليمات_جاهزة, تعليمة_مختارة, رسم_التبعيات, تعليمات_منتهية)
    نهاية
    
    ارجع تعليمات_مجدولة
نهاية

