دالة طبق_Linear_Scan_Algorithm(دورات_الحياة، معلومات_الدالة):
    # تطبيق خوارزمية Linear Scan لتخصيص السجلات
    اطبع("⚡ تطبيق خوارزمية Linear Scan...")
    
    مت تخصيص = {
        "متغيرات_في_سجلات": {},
        "متغيرات_مرسلة": [],
        "سجلات_نشطة": {},
        "إحصائيات": {
            "سجلات_مستخدمة": 0,
            "متغيرات_مرسلة": 0,
            "تحسينات_مطبقة": 0
        }
    }
    
    # ترتيب المتغيرات حسب نقطة البداية
    مت متغيرات_مرتبة = رتب_متغيرات_حسب_البداية(دورات_الحياة)
    
    # قائمة السجلات المتاحة (مرتبة حسب الأولوية)
    مت سجلات_متاحة = رتب_سجلات_حسب_الأولوية(معلومات_الدالة)
    مت سجلات_نشطة = []
    
    # معالجة كل متغير
    لكل متغير في متغيرات_مرتبة
        مت دورة_حياة = دورات_الحياة[متغير]
        
        # إزالة المتغيرات المنتهية من السجلات النشطة
        سجلات_نشطة = أزل_متغيرات_منتهية(سجلات_نشطة, دورة_حياة["بداية"])
        
        # محاولة تخصيص سجل
        مت سجل_مخصص = حاول_تخصيص_سجل(متغير, دورة_حياة, سجلات_متاحة, سجلات_نشطة)
        
        إذا سجل_مخصص != لا_شيء
            # تم التخصيص بنجاح
            تخصيص["متغيرات_في_سجلات"][متغير] = سجل_مخصص
            سجلات_نشطة = أضف(سجلات_نشطة, {
                "متغير": متغير,
                "سجل": سجل_مخصص,
                "نهاية": دورة_حياة["نهاية"]
            })
            تخصيص["إحصائيات"]["سجلات_مستخدمة"] = تخصيص["إحصائيات"]["سجلات_مستخدمة"] + 1
        وإلا
            # فشل التخصيص - تطبيق خوارزمية Spilling الذكية
            مت نتيجة_spilling = طبق_intelligent_spilling(متغير, دورة_حياة, سجلات_نشطة, تخصيص)
            
            إذا نتيجة_spilling["نجح"]
                تخصيص["متغيرات_في_سجلات"][متغير] = نتيجة_spilling["سجل"]
                سجلات_نشطة = نتيجة_spilling["سجلات_نشطة_جديدة"]
                تخصيص["متغيرات_مرسلة"] = أضف_قائمة(تخصيص["متغيرات_مرسلة"], نتيجة_spilling["متغيرات_مرسلة"])
                تخصيص["إحصائيات"]["تحسينات_مطبقة"] = تخصيص["إحصائيات"]["تحسينات_مطبقة"] + 1
            وإلا
                # إرسال المتغير للذاكرة
                تخصيص["متغيرات_مرسلة"] = أضف(تخصيص["متغيرات_مرسلة"], متغير)
                تخصيص["إحصائيات"]["متغيرات_مرسلة"] = تخصيص["إحصائيات"]["متغيرات_مرسلة"] + 1
            نهاية
        نهاية
    نهاية
    
    اطبع("  ✓ Linear Scan مكتمل - " + تخصيص["إحصائيات"]["سجلات_مستخدمة"] + " سجل مستخدم")
    
    ارجع تخصيص
