دالة حاول_دمج_x86_64(تعليمة1، تعليمة2):
    # محاولة دمج تعليمتين x86-64
    
    # دمج MOV + ADD إلى LEA
    إذا تعليمة1.يحتوي("mov ") و تعليمة2.يحتوي("add ")
        مت أجزاء_mov = تعليمة1.انقسم(" ")
        مت أجزاء_add = تعليمة2.انقسم(" ")
        
        إذا أجزاء_mov.طول >= 3 و أجزاء_add.طول >= 3
            مت سجل_mov = أجزاء_mov[1].استبدل(",", "")
            مت سجل_add = أجزاء_add[1].استبدل(",", "")
            
            إذا سجل_mov == سجل_add
                مت قيمة_mov = أجزاء_mov[2]
                مت قيمة_add = أجزاء_add[2]
                ارجع "lea " + سجل_mov + ", [" + قيمة_mov + " + " + قيمة_add + "]  # LEA fusion"
            نهاية
        نهاية
    نهاية
    
    # دمج PUSH + POP المتتاليين (إزالة)
    إذا تعليمة1.يحتوي("push ") و تعليمة2.يحتوي("pop ")
        مت سجل_push = تعليمة1.انقسم(" ")[1]
        مت سجل_pop = تعليمة2.انقسم(" ")[1]
        
        إذا سجل_push == سجل_pop
            ارجع "# removed redundant push/pop"
        نهاية
    نهاية
    
    ارجع لا_شيء
نهاية

دالة حسن_فروع_x86_64(كود_آلي):
