دالة أزل_التعليمات_الزائدة_متقدم():
    # إزالة التعليمات الزائدة والمتكررة
    مت تحسينات = 0
    مت كود_منظف = {}
    مت تعليمة_سابقة = لا_شيء
    
    لكل مؤشر في مفاتيح(كود_الآلة_متقدم)
        مت تعليمة = كود_الآلة_متقدم[مؤشر]
        
        # إزالة MOV x, x
        إذا تعليمة.كود.يبدأ_بـ("mov ") و تعليمة.كود.يحتوي(", ")
            مت أجزاء = تعليمة.كود.انقسم(", ")
            إذا أجزاء.طول == 2 و أجزاء[0].انقسم(" ")[1] == أجزاء[1]
                # تخطي هذه التعليمة
                تحسينات = تحسينات + 1
                استمر
            نهاية
        نهاية
        
        # إزالة التعليمات المتكررة المتتالية
        إذا تعليمة_سابقة != لا_شيء و تعليمة.كود == تعليمة_سابقة.كود
            تحسينات = تحسينات + 1
            استمر
        نهاية
        
        كود_منظف[مؤشر] = تعليمة
        تعليمة_سابقة = تعليمة
    نهاية
    
    كود_الآلة_متقدم = كود_منظف
    ارجع تحسينات
