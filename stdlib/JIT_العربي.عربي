دالة حدد_نوع_أنبوب_مطلوب(تعليمة):
    # تحديد نوع الأنبوب المطلوب للتعليمة
    إذا تعليمة.كود.يحتوي("add") أو تعليمة.كود.يحتوي("sub") أو تعليمة.كود.يحتوي("imul")
        ارجع "ALU"
    وإلا إذا تعليمة.كود.يحتوي("movsd") أو تعليمة.كود.يحتوي("addsd")
        ارجع "FPU"
    وإلا إذا تعليمة.كود.يحتوي("[") أو تعليمة.كود.يحتوي("]")
        ارجع "LOAD_STORE"
    وإلا إذا تعليمة.كود.يحتوي("jmp") أو تعليمة.كود.يحتوي("call")
        ارجع "BRANCH"
    وإلا
        ارجع "ALU"  # افتراضي
