دالة ولد_حلقة_من_x86_64(أمر، سياق_التحسين):
    # توليد تعليمات حلقة من محسنة
    مت تعليمات = []
    مت متغير_عداد = أمر["متغير_عداد"]
    مت قيمة_بداية = أمر["قيمة_بداية"] أو 0
    مت قيمة_نهاية = أمر["قيمة_نهاية"]
    مت خطوة = أمر["خطوة"] أو 1
    مت جسم = أمر["جسم"] أو []
    مت معرف = أمر["معرف"] أو ولد_معرف_فريد()
    
    مت سجل_عداد = احصل_على_سجل_متغير(متغير_عداد, سياق_التحسين)
    
    تعليمات = أضف(تعليمات, "# For loop")
    
    # تهيئة العداد
    تعليمات = أضف(تعليمات, "mov " + سجل_عداد + ", " + قيمة_بداية + "  # Initialize counter")
    
    تعليمات = أضف(تعليمات, ".for_start_" + معرف + ":")
    
    # فحص الشرط
    تعليمات = أضف(تعليمات, "cmp " + سجل_عداد + ", " + قيمة_نهاية + "  # Check loop condition")
    تعليمات = أضف(تعليمات, "jge .for_end_" + معرف + "  # Exit if counter >= end")
    
    # جسم الحلقة
    تعليمات = أضف(تعليمات, "# For loop body")
    لكل أمر_جسم في جسم
        مت تعليمات_جسم = ترجم_أمر_عربي_إلى_x86_64(أمر_جسم, سياق_التحسين)
        تعليمات = أضف_قائمة(تعليمات, تعليمات_جسم)
    نهاية
    
    # زيادة العداد
    إذا خطوة == 1
        تعليمات = أضف(تعليمات, "inc " + سجل_عداد + "  # Increment counter")
    وإلا
        تعليمات = أضف(تعليمات, "add " + سجل_عداد + ", " + خطوة + "  # Add step to counter")
    نهاية
    
    # العودة لبداية الحلقة
    تعليمات = أضف(تعليمات, "jmp .for_start_" + معرف + "  # Continue loop")
    تعليمات = أضف(تعليمات, ".for_end_" + معرف + ":")
    
    ارجع تعليمات
