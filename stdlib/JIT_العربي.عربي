        ارجع 0 # تعليق أو تسمية
    وإلا إذا تعليمة.يحتوي("mov ")
        ارجع 3 # MOV عادة 3 بايت
    وإلا إذا تعليمة.يحتوي("add ") أو تعليمة.يحتوي("sub ")
        ارجع 3 # ADD/SUB عادة 3 بايت
    وإلا إذا تعليمة.يحتوي("imul ")
        ارجع 4 # IMUL عادة 4 بايت
    وإلا إذا تعليمة.يحتوي("call ")
        ارجع 5 # CALL عادة 5 بايت
    وإلا إذا تعليمة.يحتوي("jmp ") أو تعليمة.يحتوي("jz ") أو تعليمة.يحتوي("jnz ")
        ارجع 2 # قفزات قصيرة عادة 2 بايت
    وإلا إذا تعليمة.يحتوي("push ") أو تعليمة.يحتوي("pop ")
        ارجع 1 # PUSH/POP عادة 1 بايت
    وإلا إذا تعليمة.يحتوي("ret")
        ارجع 1 # RET عادة 1 بايت
    وإلا إذا تعليمة.يحتوي("inc ") أو تعليمة.يحتوي("dec ")
        ارجع 2 # INC/DEC عادة 2 بايت
    وإلا إذا تعليمة.يحتوي("lea ")
        ارجع 4 # LEA عادة 4 بايت
    وإلا إذا تعليمة.يحتوي("test ") أو تعليمة.يحتوي("cmp ")
        ارجع 3 # TEST/CMP عادة 3 بايت
    وإلا
        ارجع 3 # حجم افتراضي
    نهاية
