دالة ترجم_إلى_آلة_x86_64_متقدم(أوامر_عربية، سياق_التحسين):
    # ترجمة الأوامر العربية إلى كود آلي x86-64 محسن مع دعم كامل للمعمارية
    اطبع("🔧 بدء ترجمة x86-64 المتقدمة...")
    
    مت كود_آلي_x86_64 = {
        "مقدمة": [],
        "جسم": [],
        "خاتمة": [],
        "بيانات": [],
        "رموز": {},
        "معلومات_التصحيح": {},
        "إحصائيات": {
            "تعليمات_مولدة": 0,
            "تحسينات_مطبقة": 0,
            "حجم_الكود": 0
        }
    }
    
    # إضافة مقدمة الدالة
    كود_آلي_x86_64["مقدمة"] = أضف_قائمة(كود_آلي_x86_64["مقدمة"], ولد_مقدمة_دالة_x86_64())
    
    # ترجمة كل أمر عربي
    لكل أمر في أوامر_عربية
        مت تعليمات_آلة = ترجم_أمر_عربي_إلى_x86_64(أمر, سياق_التحسين)
        كود_آلي_x86_64["جسم"] = أضف_قائمة(كود_آلي_x86_64["جسم"], تعليمات_آلة)
        كود_آلي_x86_64["إحصائيات"]["تعليمات_مولدة"] = كود_آلي_x86_64["إحصائيات"]["تعليمات_مولدة"] + تعليمات_آلة.طول
    نهاية
    
    # إضافة خاتمة الدالة
    كود_آلي_x86_64["خاتمة"] = أضف_قائمة(كود_آلي_x86_64["خاتمة"], ولد_خاتمة_دالة_x86_64())
    
    # تطبيق تحسينات x86-64 المتقدمة
    كود_آلي_x86_64 = طبق_تحسينات_x86_64_متقدمة(كود_آلي_x86_64, سياق_التحسين)
    
    # حساب حجم الكود النهائي
    كود_آلي_x86_64["إحصائيات"]["حجم_الكود"] = احسب_حجم_الكود_x86_64(كود_آلي_x86_64)
    
    اطبع("✅ انتهت ترجمة x86-64 - " + كود_آلي_x86_64["إحصائيات"]["تعليمات_مولدة"] + " تعليمة، " + كود_آلي_x86_64["إحصائيات"]["حجم_الكود"] + " بايت")
    
    ارجع كود_آلي_x86_64
نهاية

دالة ولد_مقدمة_دالة_x86_64():
    # توليد مقدمة دالة x86-64 مع إعداد الإطار
    مت مقدمة = [
        "# Function prologue - x86-64 calling convention",
        "push rbp          # Save old frame pointer",
        "mov rbp, rsp      # Set up new frame pointer",
        "sub rsp, 64       # Allocate stack space for locals",
        "# Save callee-saved registers",
        "push rbx",
        "push r12",
        "push r13",
        "push r14",
        "push r15"
    ]
    
    ارجع مقدمة
نهاية

دالة ولد_خاتمة_دالة_x86_64():
    # توليد خاتمة دالة x86-64 مع تنظيف الإطار
    مت خاتمة = [
        "# Function epilogue - restore and return",
        "# Restore callee-saved registers",
        "pop r15",
        "pop r14",
        "pop r13",
        "pop r12",
        "pop rbx",
        "# Restore stack and frame pointer",
        "mov rsp, rbp      # Restore stack pointer",
        "pop rbp           # Restore old frame pointer",
        "ret               # Return to caller"
    ]
    
    ارجع خاتمة
نهاية

دالة ترجم_أمر_عربي_إلى_x86_64(أمر، سياق_التحسين):
    # ترجمة أمر عربي واحد إلى تعليمات x86-64 محسنة
    
    إذا أمر["نوع"] == "إسناد"
        ارجع ولد_إسناد_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "عملية_ثنائية"
        ارجع ولد_عملية_ثنائية_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "استدعاء_دالة"
        ارجع ولد_استدعاء_دالة_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "شرط"
        ارجع ولد_شرط_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "حلقة_طالما"
        ارجع ولد_حلقة_طالما_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "حلقة_من"
        ارجع ولد_حلقة_من_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "إرجاع"
        ارجع ولد_إرجاع_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "مصفوفة_وصول"
        ارجع ولد_وصول_مصفوفة_x86_64(أمر, سياق_التحسين)
    وإلا إذا أمر["نوع"] == "كائن_خاصية"
        ارجع ولد_وصول_خاصية_x86_64(أمر, سياق_التحسين)
    نهاية
    
    # أمر غير معروف - توليد تعليق
    ارجع ["# Unknown command type: " + أمر["نوع"]]
نهاية

دالة ولد_إسناد_x86_64(أمر، سياق_التحسين):
    # توليد تعليمات إسناد محسنة
    مت تعليمات = []
    مت متغير = أمر["متغير"]
    مت قيمة = أمر["قيمة"]
    مت سجل_هدف = احصل_على_سجل_متغير(متغير, سياق_التحسين)
    
    # تحديد نوع القيمة وتوليد التعليمة المناسبة
    إذا هو_رقم_صحيح(قيمة)
        # إسناد رقم صحيح
        إذا قيمة == 0
            # تحسين: استخدام XOR بدلاً من MOV للصفر
            تعليمات = أضف(تعليمات, "xor " + سجل_هدف + ", " + سجل_هدف + "  # Clear register (optimized)")
        وإلا إذا قيمة >= -128 و قيمة <= 127
            # استخدام immediate byte
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + قيمة + "  # 8-bit immediate")
        وإلا إذا قيمة >= -2147483648 و قيمة <= 2147483647
            # استخدام immediate dword
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + قيمة + "  # 32-bit immediate")
        وإلا
            # استخدام immediate qword
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + قيمة + "  # 64-bit immediate")
        نهاية
    وإلا إذا هو_رقم_عشري(قيمة)
        # إسناد رقم عشري - استخدام SSE
        تعليمات = أضف(تعليمات, "# Load floating point constant")
        تعليمات = أضف(تعليمات, "movsd xmm0, [.float_const_" + قيمة + "]")
        تعليمات = أضف(تعليمات, "movq " + سجل_هدف + ", xmm0")
    وإلا إذا هو_نص(قيمة)
        # إسناد نص - تحميل عنوان النص
        تعليمات = أضف(تعليمات, "lea " + سجل_هدف + ", [.str_const_" + حساب_hash(قيمة) + "]  # Load string address")
    وإلا إذا هو_متغير(قيمة)
        # إسناد من متغير آخر
        مت سجل_مصدر = احصل_على_سجل_متغير(قيمة, سياق_التحسين)
        إذا سجل_مصدر != سجل_هدف
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + سجل_مصدر + "  # Copy variable")
        نهاية
    وإلا
        # قيمة عامة
        تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + قيمة + "  # General assignment")
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_عملية_ثنائية_x86_64(أمر، سياق_التحسين):
    # توليد تعليمات عملية ثنائية محسنة
    مت تعليمات = []
    مت معامل = أمر["المعامل"]
    مت طرف_أيسر = أمر["الطرف_الأيسر"]
    مت طرف_أيمن = أمر["الطرف_الأيمن"]
    مت سجل_هدف = احصل_على_سجل_متغير(أمر["متغير"] أو طرف_أيسر, سياق_التحسين)
    
    # تحميل الطرف الأيسر
    إذا هو_متغير(طرف_أيسر)
        مت سجل_أيسر = احصل_على_سجل_متغير(طرف_أيسر, سياق_التحسين)
        إذا سجل_أيسر != سجل_هدف
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", " + سجل_أيسر)
        نهاية
    وإلا
        تعليمات = أضف_قائمة(تعليمات, ولد_إسناد_x86_64({"متغير": "temp", "قيمة": طرف_أيسر}, سياق_التحسين))
    نهاية
    
    # تطبيق العملية
    إذا معامل == "+"
        تعليمات = أضف_قائمة(تعليمات, ولد_جمع_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "-"
        تعليمات = أضف_قائمة(تعليمات, ولد_طرح_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "*"
        تعليمات = أضف_قائمة(تعليمات, ولد_ضرب_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "/"
        تعليمات = أضف_قائمة(تعليمات, ولد_قسمة_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "%"
        تعليمات = أضف_قائمة(تعليمات, ولد_باقي_قسمة_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "=="
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_مساواة_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "!="
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_عدم_مساواة_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "<"
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_أصغر_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == ">"
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_أكبر_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "<="
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_أصغر_مساوي_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == ">="
        تعليمات = أضف_قائمة(تعليمات, ولد_مقارنة_أكبر_مساوي_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "&&"
        تعليمات = أضف_قائمة(تعليمات, ولد_و_منطقي_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    وإلا إذا معامل == "||"
        تعليمات = أضف_قائمة(تعليمات, ولد_أو_منطقي_x86_64(سجل_هدف, طرف_أيمن, سياق_التحسين))
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_جمع_x86_64(سجل_هدف، طرف_أيمن، سياق_التحسين):
    # توليد تعليمات جمع محسنة
    مت تعليمات = []
    
    إذا هو_رقم_صحيح(طرف_أيمن)
        إذا طرف_أيمن == 1
            # تحسين: استخدام INC بدلاً من ADD
            تعليمات = أضف(تعليمات, "inc " + سجل_هدف + "  # Optimized increment")
        وإلا إذا طرف_أيمن == 0
            # تحسين: لا حاجة لأي تعليمة
            تعليمات = أضف(تعليمات, "# No operation needed (add 0)")
        وإلا إذا سياق_التحسين.استخدم_LEA و طرف_أيمن > 0 و طرف_أيمن <= 8
            # تحسين: استخدام LEA للجمع الصغير
            تعليمات = أضف(تعليمات, "lea " + سجل_هدف + ", [" + سجل_هدف + " + " + طرف_أيمن + "]  # LEA optimization")
        وإلا
            تعليمات = أضف(تعليمات, "add " + سجل_هدف + ", " + طرف_أيمن)
        نهاية
    وإلا إذا هو_متغير(طرف_أيمن)
        مت سجل_أيمن = احصل_على_سجل_متغير(طرف_أيمن, سياق_التحسين)
        إذا سياق_التحسين.استخدم_LEA
            تعليمات = أضف(تعليمات, "lea " + سجل_هدف + ", [" + سجل_هدف + " + " + سجل_أيمن + "]  # LEA optimization")
        وإلا
            تعليمات = أضف(تعليمات, "add " + سجل_هدف + ", " + سجل_أيمن)
        نهاية
    وإلا
        تعليمات = أضف(تعليمات, "add " + سجل_هدف + ", " + طرف_أيمن)
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_طرح_x86_64(سجل_هدف، طرف_أيمن، سياق_التحسين):
    # توليد تعليمات طرح محسنة
    مت تعليمات = []
    
    إذا هو_رقم_صحيح(طرف_أيمن)
        إذا طرف_أيمن == 1
            # تحسين: استخدام DEC بدلاً من SUB
            تعليمات = أضف(تعليمات, "dec " + سجل_هدف + "  # Optimized decrement")
        وإلا إذا طرف_أيمن == 0
            # تحسين: لا حاجة لأي تعليمة
            تعليمات = أضف(تعليمات, "# No operation needed (sub 0)")
        وإلا
            تعليمات = أضف(تعليمات, "sub " + سجل_هدف + ", " + طرف_أيمن)
        نهاية
    وإلا إذا هو_متغير(طرف_أيمن)
        مت سجل_أيمن = احصل_على_سجل_متغير(طرف_أيمن, سياق_التحسين)
        تعليمات = أضف(تعليمات, "sub " + سجل_هدف + ", " + سجل_أيمن)
    وإلا
        تعليمات = أضف(تعليمات, "sub " + سجل_هدف + ", " + طرف_أيمن)
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_ضرب_x86_64(سجل_هدف، طرف_أيمن، سياق_التحسين):
    # توليد تعليمات ضرب محسنة
    مت تعليمات = []
    
    إذا هو_رقم_صحيح(طرف_أيمن)
        إذا طرف_أيمن == 0
            # تحسين: الضرب في صفر
            تعليمات = أضف(تعليمات, "xor " + سجل_هدف + ", " + سجل_هدف + "  # Multiply by 0")
        وإلا إذا طرف_أيمن == 1
            # تحسين: لا حاجة لأي تعليمة
            تعليمات = أضف(تعليمات, "# No operation needed (mul 1)")
        وإلا إذا طرف_أيمن == 2
            # تحسين: استخدام SHL بدلاً من IMUL
            تعليمات = أضف(تعليمات, "shl " + سجل_هدف + ", 1  # Multiply by 2 (shift left)")
        وإلا إذا هو_قوة_اثنين(طرف_أيمن)
            # تحسين: استخدام SHL لقوى الاثنين
            مت قوة = احسب_قوة_اثنين(طرف_أيمن)
            تعليمات = أضف(تعليمات, "shl " + سجل_هدف + ", " + قوة + "  # Multiply by " + طرف_أيمن + " (shift left)")
        وإلا
            تعليمات = أضف(تعليمات, "imul " + سجل_هدف + ", " + طرف_أيمن)
        نهاية
    وإلا إذا هو_متغير(طرف_أيمن)
        مت سجل_أيمن = احصل_على_سجل_متغير(طرف_أيمن, سياق_التحسين)
        تعليمات = أضف(تعليمات, "imul " + سجل_هدف + ", " + سجل_أيمن)
    وإلا
        تعليمات = أضف(تعليمات, "imul " + سجل_هدف + ", " + طرف_أيمن)
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_قسمة_x86_64(سجل_هدف، طرف_أيمن، سياق_التحسين):
    # توليد تعليمات قسمة محسنة
    مت تعليمات = []
    
    إذا هو_رقم_صحيح(طرف_أيمن)
        إذا طرف_أيمن == 1
            # تحسين: لا حاجة لأي تعليمة
            تعليمات = أضف(تعليمات, "# No operation needed (div 1)")
        وإلا إذا طرف_أيمن == 2
            # تحسين: استخدام SHR بدلاً من IDIV
            تعليمات = أضف(تعليمات, "shr " + سجل_هدف + ", 1  # Divide by 2 (shift right)")
        وإلا إذا هو_قوة_اثنين(طرف_أيمن)
            # تحسين: استخدام SHR لقوى الاثنين
            مت قوة = احسب_قوة_اثنين(طرف_أيمن)
            تعليمات = أضف(تعليمات, "shr " + سجل_هدف + ", " + قوة + "  # Divide by " + طرف_أيمن + " (shift right)")
        وإلا
            # قسمة عامة - تحتاج إعداد خاص
            تعليمات = أضف(تعليمات, "mov rax, " + سجل_هدف + "  # Prepare for division")
            تعليمات = أضف(تعليمات, "cqo                    # Sign extend RAX to RDX:RAX")
            تعليمات = أضف(تعليمات, "mov rcx, " + طرف_أيمن + "  # Load divisor")
            تعليمات = أضف(تعليمات, "idiv rcx               # Signed division")
            تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", rax  # Store quotient")
        نهاية
    وإلا
        # قسمة عامة
        تعليمات = أضف(تعليمات, "mov rax, " + سجل_هدف)
        تعليمات = أضف(تعليمات, "cqo")
        إذا هو_متغير(طرف_أيمن)
            مت سجل_أيمن = احصل_على_سجل_متغير(طرف_أيمن, سياق_التحسين)
            تعليمات = أضف(تعليمات, "idiv " + سجل_أيمن)
        وإلا
            تعليمات = أضف(تعليمات, "mov rcx, " + طرف_أيمن)
            تعليمات = أضف(تعليمات, "idiv rcx")
        نهاية
        تعليمات = أضف(تعليمات, "mov " + سجل_هدف + ", rax")
    نهاية
    
    ارجع تعليمات
نهاية

دالة ولد_استدعاء_دالة_x86_64(أمر، سياق_التحسين):
    # توليد تعليمات استدعاء دالة مع calling convention
    مت تعليمات = []
    مت اسم_الدالة = أمر["اسم"]
    مت معاملات = أمر["معاملات"] أو []
    
    # System V AMD64 ABI calling convention
    مت سجلات_معاملات = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    
    تعليمات = أضف(تعليمات, "# Function call: " + اسم_الدالة)
    
    # حفظ السجلات المتطايرة
    تعليمات = أضف(تعليمات, "# Save caller-saved registers")
    تعليمات = أضف(تعليمات, "push rax")
    تعليمات = أضف(تعليمات, "push rcx")
    تعليمات = أضف(تعليمات, "push rdx")
    تعليمات = أضف(تعليمات, "push r8")
    تعليمات = أضف(تعليمات, "push r9")
    تعليمات = أضف(تعليمات, "push r10")
    تعليمات = أضف(تعليمات, "push r11")
    
    # تحضير المعاملات
    مت معاملات_مكدس = 0
    لكل ع = 0 إلى معاملات.طول - 1
        مت معامل = معاملات[ع]
        
        إذا ع < سجلات_معاملات.طول
            # معامل في سجل
            مت سجل_معامل = سجلات_معاملات[ع]
            إذا هو_متغير(معامل)
                مت سجل_مصدر = احصل_على_سجل_متغير(معامل, سياق_التحسين)
                تعليمات = أضف(تعليمات, "mov " + سجل_معامل + ", " + سجل_مصدر + "  # Parameter " + (ع + 1))
            وإلا
                تعليمات = أضف(تعليمات, "mov " + سجل_معامل + ", " + معامل + "  # Parameter " + (ع + 1))
            نهاية
        وإلا
            # معامل في المكدس
            إذا هو_متغير(معامل)
                مت سجل_مصدر = احصل_على_سجل_متغير(معامل, سياق_التحسين)
                تعليمات = أضف(تعليمات, "push " + سجل_مصدر + "  # Stack parameter " + (ع + 1))
            وإلا
                تعليمات = أضف(تعليمات, "push " + معامل + "  # Stack parameter " + (ع + 1))
            نهاية
            معاملات_مكدس = معاملات_مكدس + 1
        نهاية
    نهاية
    
    # محاذاة المكدس (16-byte alignment)
    إذا (معاملات_مكدس % 2) != 0
        تعليمات = أضف(تعليمات, "sub rsp, 8  # Stack alignment")
    نهاية
    
    # الاستدعاء الفعلي
    تعليمات = أضف(تعليمات, "call " + اسم_الدالة)
    
    # تنظيف المكدس
    إذا معاملات_مكدس > 0
        مت حجم_تنظيف = معاملات_مكدس * 8
        إذا (معاملات_مكدس % 2) != 0
            حجم_تنظيف = حجم_تنظيف + 8 # محاذاة إضافية
        نهاية
        تعليمات = أضف(تعليمات, "add rsp, " + حجم_تنظيف + "  # Clean up stack parameters")
    نهاية
    
    # استعادة السجلات المتطايرة
    تعليمات = أضف(تعليمات, "# Restore caller-saved registers")
    تعليمات = أضف(تعليمات, "pop r11")
    تعليمات = أضف(تعليمات, "pop r10")
    تعليمات = أضف(تعليمات, "pop r9")
    تعليمات = أضف(تعليمات, "pop r8")
    تعليمات = أضف(تعليمات, "pop rdx")
    تعليمات = أضف(تعليمات, "pop rcx")
    تعليمات = أضف(تعليمات, "pop rax")
    
    ارجع تعليمات
نهاية

دالة ولد_شرط_x86_64(أمر، سياق_التحسين):
    # توليد تعليمات شرط محسنة
    مت تعليمات = []
    مت شرط = أمر["شرط"]
    مت جسم = أمر["جسم"] أو []
    مت جسم_وإلا = أمر["جسم_وإلا"] أو []
    مت معرف = أمر["معرف"] أو ولد_معرف_فريد()
    
    تعليمات = أضف(تعليمات, "# Conditional statement")
    
    # تقييم الشرط
    إذا هو_متغير(شرط)
        مت سجل_شرط = احصل_على_سجل_متغير(شرط, سياق_التحسين)
        تعليمات = أضف(تعليمات, "test " + سجل_شرط + ", " + سجل_شرط + "  # Test condition")
    وإلا
        تعليمات = أضف(تعليمات, "cmp " + شرط + ", 0  # Compare condition")
    نهاية
    
    # القفز الشرطي
    إذا جسم_وإلا.طول > 0
        تعليمات = أضف(تعليمات, "jz .else_" + معرف + "  # Jump to else if false")
    وإلا
        تعليمات = أضف(تعليمات, "jz .end_if_" + معرف + "  # Jump to end if false")
    نهاية
    
    # جسم الشرط الأساسي
    تعليمات = أضف(تعليمات, "# If body")
    لكل أمر_جسم في جسم
        مت تعليمات_جسم = ترجم_أمر_عربي_إلى_x86_64(أمر_جسم, سياق_التحسين)
        تعليمات = أضف_قائمة(تعليمات, تعليمات_جسم)
    نهاية
    
    # جسم وإلا (إن وجد)
    إذا جسم_وإلا.طول > 0
        تعليمات = أضف(تعليمات, "jmp .end_if_" + معرف + "  # Skip else body")
        تعليمات = أضف(تعليمات, ".else_" + معرف + ":")
        تعليمات = أضف(تعليمات, "# Else body")
        
        لكل أمر_وإلا في جسم_وإلا
            مت تعليمات_وإلا = ترجم_أمر_عربي_إلى_x86_64(أمر_وإلا, سياق_التحسين)
            تعليمات = أضف_قائمة(تعليمات, تعليمات_وإلا)
        نهاية
    نهاية
    
    # نهاية الشرط
    تعليمات = أضف(تعليمات, ".end_if_" + معرف + ":")
    
    ارجع تعليمات
نهاية

دالة ولد_حلقة_طالما_x86_64(أمر، سياق_التحسين):
