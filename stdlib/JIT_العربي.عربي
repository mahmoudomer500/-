دالة قيم_جودة_تخصيص_السجلات(نتيجة_التخصيص، معلومات_الدالة):
    # تقييم جودة تخصيص السجلات
    مت نقاط = 0
    
    # نقاط للمتغيرات في السجلات
    مت عدد_متغيرات_سجلات = مفاتيح(نتيجة_التخصيص["متغيرات_في_سجلات"]).طول
    مت عدد_متغيرات_مرسلة = نتيجة_التخصيص["متغيرات_مرسلة"].طول
    مت إجمالي_متغيرات = عدد_متغيرات_سجلات + عدد_متغيرات_مرسلة
    
    إذا إجمالي_متغيرات > 0
        مت نسبة_سجلات = (عدد_متغيرات_سجلات * 100) / إجمالي_متغيرات
        نقاط = نقاط + نسبة_سجلات * 0.6 # 60% من النقاط
    نهاية
    
    # نقاط لتحسين calling convention
    إذا معلومات_الدالة["معاملات"] != لا_شيء
        لكل معامل في معلومات_الدالة["معاملات"]
            إذا معامل في مفاتيح(نتيجة_التخصيص["متغيرات_في_سجلات"])
                نقاط = نقاط + 5 # 5 نقاط لكل معامل في سجل
            نهاية
        نهاية
    نهاية
    
    # نقاط لمتغير الإرجاع في RAX
    إذا معلومات_الدالة["متغير_الإرجاع"] في مفاتيح(نتيجة_التخصيص["متغيرات_في_سجلات"])
        إذا نتيجة_التخصيص["متغيرات_في_سجلات"][معلومات_الدالة["متغير_الإرجاع"]] == "rax"
            نقاط = نقاط + 10 # 10 نقاط لمتغير الإرجاع في RAX
        نهاية
    نهاية
    
    # نقاط للتحسينات المطبقة
    إذا نتيجة_التخصيص["إحصائيات"].يحتوي("تحسينات_calling_convention")
        نقاط = نقاط + نتيجة_التخصيص["إحصائيات"]["تحسينات_calling_convention"] * 2
    نهاية
    
    إذا نتيجة_التخصيص["إحصائيات"].يحتوي("تحسينات_حلقات")
        نقاط = نقاط + نتيجة_التخصيص["إحصائيات"]["تحسينات_حلقات"] * 3
    نهاية
    
    ارجع أصغر(نقاط, 100) # الحد الأقصى 100 نقطة
نهاية

