دالة حدد_نوع_التعليمة_متقدم(تعليمة):
    # تحديد نوع التعليمة للتحليل المتقدم
    إذا تعليمة.كود.يحتوي("add") أو تعليمة.كود.يحتوي("sub") أو تعليمة.كود.يحتوي("imul")
        ارجع "حسابي"
    وإلا إذا تعليمة.كود.يحتوي("mov") أو تعليمة.كود.يحتوي("lea")
        ارجع "نقل_بيانات"
    وإلا إذا تعليمة.كود.يحتوي("[") أو تعليمة.كود.يحتوي("]")
        ارجع "ذاكرة"
    وإلا إذا تعليمة.كود.يحتوي("jmp") أو تعليمة.كود.يحتوي("jz") أو تعليمة.كود.يحتوي("call")
        ارجع "فرع"
    وإلا
        ارجع "عام"
    نهاية
نهاية

دالة حلل_الموارد_المطلوبة(تعليمة):
    # تحليل الموارد المطلوبة للتعليمة
    مت موارد = []
    
    إذا تعليمة.كود.يحتوي("add") أو تعليمة.كود.يحتوي("sub")
        موارد = أضف(موارد, "ALU")
    وإلا إذا تعليمة.كود.يحتوي("imul") أو تعليمة.كود.يحتوي("idiv")
        موارد = أضف(موارد, "ALU")
        موارد = أضف(موارد, "MULTIPLIER")
    وإلا إذا تعليمة.كود.يحتوي("movsd") أو تعليمة.كود.يحتوي("addsd")
        موارد = أضف(موارد, "FPU")
    وإلا إذا تعليمة.كود.يحتوي("[") أو تعليمة.كود.يحتوي("]")
        موارد = أضف(موارد, "LOAD_STORE_UNIT")
    نهاية
    
    ارجع موارد
