        })
        
        # اختبار شرط الحلقة
        مت سجل_شرط = سياق_التحسين.سجلات[أمر["شرط"]] أو "rax"
        أضف_تعليمة_آلة_متقدمة("test " + سجل_شرط + ", " + سجل_شرط, {
            "حجم": 3,
            "نوع": "اختبار_حلقة",
            "تحسينات": ["loop_optimization"]
        })
        أضف_تعليمة_آلة_متقدمة("jz end_loop_" + معرف_حلقة, {
            "حجم": 6,
            "نوع": "فرع_حلقة",
            "تحسينات": ["loop_branch_prediction"]
        })
        
        # ترجمة جسم الحلقة
        كرر من أمر_جسم in أمر["جسم"]:
