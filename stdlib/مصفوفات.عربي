# ────────────────────────────────────────────────────────────────────
# 1️⃣  دالة حساب حجم/طول المصفوفة
# ────────────────────────────────────────────────────────────────────
# الوصف: الحصول على عدد العناصر في المصفوفة
# المدخل: المصفوفة
# المخرج: عدد العناصر
# ────────────────────────────────────────────────────────────────────

دالة حجم(مصفوفة):
    "حساب حجم المصفوفة"
    # إذا كانت مصفوفة عالية المستوى (ValueType::ARRAY)
    إذا نوع(مصفوفة) == "مصفوفة":
        # المحرك يوفر حجم المصفوفة الأصلية تلقائياً عبر الدالة الأصلية 
        # (بما أن الدالة الأصلية 'حجم' محجوزة كـ Native، فالسلوك يعتمد على ترتيب الاستدعاء)
        # في بيئة البيروني، إذا كان الكائن 'مصفوفة'، فإن محرك اللغة يعيد طولها مباشرة
        أرجع طول(مصفوفة)

    # إذا كانت مصفوفة منخفضة المستوى (Pointer / Number)
    إلا إذا نوع(مصفوفة) == "رقم":
        # مصفوفات البيروني تخزن الطول في أول 16 بايت (offset -16)
        # الرأس (Header) بحجم 16 بايت، وأول 4 بايتات هي الطول (length)
        عنوان_الطول = مصفوفة - 16
        أرجع اقرأ_ذاكرة(عنوان_الطول)
    
    أرجع 0

دالة طول_المصفوفة(مصفوفة):
    "alias for حجم"
    أرجع حجم(مصفوفة)

# ────────────────────────────────────────────────────────────────────
# 2️⃣  دالة إضافة عنصر للمصفوفة
# ────────────────────────────────────────────────────────────────────
# الوصف: إضافة عنصر جديد في نهاية المصفوفة مع إعادة تخصيص الذاكرة الكاملة
# المدخل: المصفوفة والعنصر المراد إضافته
# المخرج: المصفوفة بعد الإضافة
# ────────────────────────────────────────────────────────────────────

دالة أضف(مصفوفة، عنصر):
    "إضافة عنصر للمصفوفة مع إعادة تخصيص الذاكرة الكاملة التلقائي"
    # هذه الدالة منفذة داخل مولد الكود (CodeGenerator) باستخدام تعليمات الآلة
    # تنفيذ إعادة التخصيص الكامل للذاكرة عند الحاجة

    # هيكل المصفوفة: [الحجم: 8 بايت][السعة: 8 بايت][البيانات: الحجم * 8 بايت]
    # معامل مصفوفة يشير إلى قسم البيانات، لذا:
    # الحجم في [مصفوفة - 16]، السعة في [مصفوفة - 8]

    # التنفيذ الفعلي في CodeGenerator_fixed.cpp:
    # 1. قراءة الحجم الحالي من [مصفوفة - 16]
    # 2. قراءة السعة الحالية من [مصفوفة - 8]
    # 3. إذا الحجم >= السعة:
    #    - حساب السعة الجديدة (ضعف السعة الحالية أو 8 كحد أدنى)
    #    - تخصيص ذاكرة جديدة: 16 + (سعة_جديدة * 8)
    #    - نسخ البيانات من الموقع القديم للجديد
    #    - تحديث حقل السعة في الذاكرة الجديدة
    #    - تحرير الذاكرة القديمة
    # 4. إضافة العنصر الجديد في الموقع الحجم_الحالي
    # 5. زيادة حقل الحجم بـ 1
    # 6. إرجاع مؤشر المصفوفة (قد يكون محدثاً بعد إعادة التخصيص)

    # هذه الدالة مضمنة في وقت الترجمة وليست متوفرة كدالة عادية
    # لاستخدامها: أضف(مصفوفة، قيمة)

# ────────────────────────────────────────────────────────────────────
# 3️⃣  دالة الحصول على عنصر (مع التحقق)
# ────────────────────────────────────────────────────────────────────
# الوصف: الحصول على قيمة عنصر من المصفوفة بناءً على الفهرس
# المدخل: المصفوفة والفهرس
# المخرج: قيمة العنصر
# ────────────────────────────────────────────────────────────────────

دالة احصل(مصفوفة، فهرس):
    "الحصول على عنصر من المصفوفة"
    # TODO: Replace with proper bounds checking using حجم()
    إذا فهرس < 0:
        اطبع("❌ خطأ: الفهرس خارج النطاق!")
        أرجع 0
    أرجع مصفوفة[فهرس]

