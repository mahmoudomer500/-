# ────────────────────────────────────────────────────────────────────
# 5️⃣  دالة حساب المتوسط
# ────────────────────────────────────────────────────────────────────
# الوصف: حساب المتوسط الحسابي لجميع عناصر المصفوفة
# ────────────────────────────────────────────────────────────────────

دالة متوسط(مصفوفة):
    "حساب المتوسط الحسابي"
    المجموع = اجمع_العناصر(مصفوفة)
    ح = حجم(مصفوفة)
    إذا ح == 0:
        أرجع 0
    أرجع المجموع / ح

# ────────────────────────────────────────────────────────────────────
# 6️⃣  دالة البحث عن عنصر
# ────────────────────────────────────────────────────────────────────
# الوصف: البحث عن عنصر في المصفوفة وإرجاع موضعه
# المدخل: المصفوفة والقيمة المراد البحث عنها
# المخرج: الفهرس إذا وجد، -1 إذا لم يجد
# ────────────────────────────────────────────────────────────────────

دالة بحث(مصفوفة، قيمة):
    "البحث عن عنصر في المصفوفة"
    الفهرس = 0
    طالما الفهرس < حجم(مصفوفة):
        إذا مصفوفة[الفهرس] == قيمة:
            أرجع الفهرس
        الفهرس = الفهرس + 1
    أرجع -1

دالة ابحث(مصفوفة، قيمة):
    "alias for بحث"
    أرجع بحث(مصفوفة, قيمة)

# ────────────────────────────────────────────────────────────────────
# 7️⃣  دالة إيجاد أكبر وأصغر عنصر
# ────────────────────────────────────────────────────────────────────

دالة أقصى(مصفوفة):
    "إيجاد أكبر عنصر"
    إذا حجم(مصفوفة) == 0:
        أرجع 0
    الأقصى = مصفوفة[0]
    الفهرس = 1
    طالما الفهرس < حجم(مصفوفة):
        إذا مصفوفة[الفهرس] > الأقصى:
            الأقصى = مصفوفة[الفهرس]
        الفهرس = الفهرس + 1
    أرجع الأقصى

دالة أدنى(مصفوفة):
    "إيجاد أصغر عنصر"
    إذا حجم(مصفوفة) == 0:
        أرجع 0
    الأدنى = مصفوفة[0]
    الفهرس = 1
    طالما الفهرس < حجم(مصفوفة):
        إذا مصفوفة[الفهرس] < الأدنى:
            الأدنى = مصفوفة[الفهرس]
        الفهرس = الفهرس + 1
    أرجع الأدنى

# ────────────────────────────────────────────────────────────────────
# 8️⃣  دوال الترتيب (فرز)
# ────────────────────────────────────────────────────────────────────

دالة فرز(مصفوفة):
    "ترتيب المصفوفة تصاعدياً (Bubble Sort)"
    الطول = حجم(مصفوفة)
    خارج = 0
    طالما خارج < الطول:
        داخل = 0
        طالما داخل < الطول - 1:
            إذا مصفوفة[داخل] > مصفوفة[داخل + 1]:
                مؤقت = مصفوفة[داخل]
                مصفوفة[داخل] = مصفوفة[داخل + 1]
                مصفوفة[داخل + 1] = مؤقت
            داخل = داخل + 1
        خارج = خارج + 1
    أرجع مصفوفة

دالة ترتيب_صاعد(مصفوفة):
    أرجع فرز(مصفوفة)

دالة ترتيب_هابط(مصفوفة):
    "ترتيب المصفوفة تنازلياً"
    الطول = حجم(مصفوفة)
    خارج = 0
    طالما خارج < الطول:
        داخل = 0
        طالما داخل < الطول - 1:
            إذا مصفوفة[داخل] < مصفوفة[داخل + 1]:
                مؤقت = مصفوفة[داخل]
                مصفوفة[داخل] = مصفوفة[داخل + 1]
                مصفوفة[داخل + 1] = مؤقت
            داخل = داخل + 1
        خارج = خارج + 1
    أرجع مصفوفة


# ────────────────────────────────────────────────────────────────────
# 9️⃣  دالة عكس المصفوفة
# ────────────────────────────────────────────────────────────────────
# الوصف: عكس ترتيب العناصر في المصفوفة
# ────────────────────────────────────────────────────────────────────

دالة عكس(مصفوفة):
    "عكس ترتيب عناصر المصفوفة"
    الطول = حجم(مصفوفة)
    البداية = 0
    النهاية = الطول - 1
    
    طالما البداية < النهاية:
        مؤقت = مصفوفة[البداية]
        مصفوفة[البداية] = مصفوفة[النهاية]
        مصفوفة[النهاية] = مؤقت
        
        البداية = البداية + 1
        النهاية = النهاية - 1
        
    أرجع مصفوفة

# ────────────────────────────────────────────────────────────────────
# 🔟  دالة توسيع المصفوفة (تغيير الحجم)
# ────────────────────────────────────────────────────────────────────
# الوصف: تغيير حجم المصفوفة (باستخدام أضف للعناصر الجديدة)
# ────────────────────────────────────────────────────────────────────

دالة توسيع(مصفوفة، حجم_جديد):
    "تغيير حجم المصفوفة باستخدام أضف"
    الطول_الحالي = حجم(مصفوفة)

    إذا حجم_جديد > الطول_الحالي:
        # إضافة عناصر (أصفار)
        الفرق = حجم_جديد - الطول_الحالي
        العداد = 0
        بينما العداد < الفرق:
            # استخدام أضف لإضافة عنصر (سيتم إعادة تخصيص تلقائياً إذا لزم الأمر)
            # لكن بما أن أضف غير متوفرة مباشرة، سنستخدم تعيين مباشر
            مصفوفة[الطول_الحالي + العداد] = 0
            العداد = العداد + 1

    أرجع مصفوفة

# ────────────────────────────────────────────────────────────────────
# 1️⃣1️⃣  دالة تصفية (Filter)
# ────────────────────────────────────────────────────────────────────
# الوصف: إنشاء مصفوفة جديدة تحتوي فقط على العناصر التي تحقق شرطاً
# ────────────────────────────────────────────────────────────────────

دالة تصفية_قيمة(مصفوفة، قيمة_للحذف):
    "إنشاء مصفوفة جديدة بدون القيمة المحددة"
    مصفوفة_جديدة = []
    الفهرس = 0
    الطول = حجم(مصفوفة)

    بينما الفهرس < الطول:
        عنصر = مصفوفة[الفهرس]
        إذا عنصر != قيمة_للحذف:
            # استخدام أضف لإضافة العنصر (مع إعادة تخصيص تلقائي)
            # لكن بما أن أضف غير متوفرة مباشرة، سنستخدم تعيين مباشر
            مصفوفة_جديدة[الفهرس] = عنصر
        الفهرس = الفهرس + 1

    أرجع مصفوفة_جديدة

# ────────────────────────────────────────────────────────────────────
# 1️⃣2️⃣  دالة نسخ المصفوفة
# ────────────────────────────────────────────────────────────────────
# الوصف: إنشاء نسخة جديدة من المصفوفة
# ────────────────────────────────────────────────────────────────────

دالة نسخ(مصفوفة):
    "إنشاء نسخة جديدة من المصفوفة"
    مصفوفة_جديدة = []
    الفهرس = 0
    الطول = حجم(مصفوفة)

    بينما الفهرس < الطول:
        # استخدام أضف لنسخ العنصر (مع إعادة تخصيص تلقائي)
        # لكن بما أن أضف غير متوفرة مباشرة، سنستخدم تعيين مباشر
        مصفوفة_جديدة[الفهرس] = مصفوفة[الفهرس]
        الفهرس = الفهرس + 1

    أرجع مصفوفة_جديدة

