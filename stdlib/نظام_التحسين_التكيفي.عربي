    # عوامل الأولوية
    أولوية += دالة["استدعاءات"] / 100  # كثرة الاستدعاءات
    أولوية += دالة["وقت_تنفيذ"] / 1000  # وقت التنفيذ الطويل
    أولوية += دالة["تعقيد_حسابي"] * 2  # التعقيد الحسابي
    
    ارجع أولوية
