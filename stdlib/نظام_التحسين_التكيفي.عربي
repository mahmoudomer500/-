دالة اختيار_استراتيجية_بديلة(دالة، استراتيجية_حالية):
    # اختيار استراتيجية بديلة للتحسين
    مت استراتيجيات_متاحة = إعدادات_التحسين_التكيفي["استراتيجيات_متاحة"]
    
    # إزالة الاستراتيجية الحالية من القائمة
    مت استراتيجيات_بديلة = []
    لكل استراتيجية في استراتيجيات_متاحة
        إذا استراتيجية != استراتيجية_حالية
            استراتيجيات_بديلة = أضف(استراتيجيات_بديلة, استراتيجية)
        نهاية
    نهاية
    
    # اختيار الاستراتيجية الأنسب
    إذا دالة["حلقات"] > 0
        ارجع "تحسين_حلقات_عدواني"
    وإلا إذا دالة["وصولات_ذاكرة"] > 20
        ارجع "تحسين_ذاكرة_متقدم"
    وإلا
        ارجع استراتيجيات_بديلة[0]  # أول استراتيجية بديلة
    نهاية
