دالة كشف_دوال_ساخنة_محسن(ملف_التحليل):
    # كشف الدوال الساخنة مع تحليل محسن للأنماط
    اطبع("🔥 كشف الدوال الساخنة مع تحليل الأنماط...")
    
    مت دوال_ساخنة_جديدة = {}
    مت عدد_استدعاءات = {}
    مت أوقات_تنفيذ = {}
    
    # تحليل ملف التحليل
    لكل دالة في ملف_التحليل["دوال"]
        مت اسم_الدالة = دالة["اسم"]
        مت عدد_الاستدعاءات = دالة["استدعاءات"]
        مت وقت_التنفيذ = دالة["وقت_تنفيذ"]
        
        عدد_استدعاءات[اسم_الدالة] = عدد_الاستدعاءات
        أوقات_تنفيذ[اسم_الدالة] = وقت_التنفيذ
        
        # تحديد الدوال الساخنة بناءً على معايير متقدمة
        إذا عدد_الاستدعاءات > إعدادات_التحسين_التكيفي["حد_كشف_دالة_ساخنة"]
            مت نسبة_وقت_تنفيذ = وقت_التنفيذ / ملف_التحليل["إجمالي_وقت_تنفيذ"]
            
            إذا نسبة_وقت_تنفيذ > 0.05  # 5% من إجمالي وقت التنفيذ
                دوال_ساخنة_جديدة[اسم_الدالة] = {
                    "استدعاءات": عدد_الاستدعاءات,
                    "وقت_تنفيذ": وقت_التنفيذ,
                    "نسبة_وقت": نسبة_وقت_تنفيذ,
                    "أولوية_تحسين": حساب_أولوية_تحسين(دالة),
                    "نمط_استخدام": تحليل_نمط_استخدام_دالة(دالة)
                }
                
                إحصائيات_التحسين_التكيفي["كشف_دوال_ساخنة"] += 1
            نهاية
        نهاية
    نهاية
    
    # تحديث ملف الدوال الساخنة
    ملفات_التحسين["دوال_ساخنة"] = دوال_ساخنة_جديدة
    
    اطبع("  ✅ تم كشف " + دوال_ساخنة_جديدة.طول + " دالة ساخنة")
    
    ارجع دوال_ساخنة_جديدة
