            نهاية
        نهاية
        
        # تطبيق تحسينات الذاكرة للكود المولد
        إذا طبق_تحسينات_ذاكرة_JIT()
            نتيجة_التنسيق["تحسينات_مطبقة"] = أضف(نتيجة_التنسيق["تحسينات_مطبقة"], "تحسين_تخصيص_الذاكرة")
            نتيجة_التنسيق["تحسينات_مطبقة"] = أضف(نتيجة_التنسيق["تحسينات_مطبقة"], "تحسين_تحرير_الذاكرة")
        نهاية
        
        # تنسيق دورات جمع القمامة مع JIT
        إذا نسق_دورات_جمع_القمامة()
            نتيجة_التنسيق["تحسينات_مطبقة"] = أضف(نتيجة_التنسيق["تحسينات_مطبقة"], "تنسيق_دورات_جمع")
        نهاية
        
