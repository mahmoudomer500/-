        مت كائنات_JIT = احصل_على_كائنات_JIT_المولدة()
        
        لكل كائن في كائنات_JIT
            إذا سجل_كائن_JIT_مع_جامع_القمامة(كائن)
                نتيجة_التنسيق["كائنات_مسجلة"] += 1
