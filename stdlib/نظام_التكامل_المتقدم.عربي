    نهاية
    
    إذا نتيجة_التنسيق["نجح"]
        اطبع("  ✅ تم تنسيق جامع القمامة مع JIT بنجاح")
        اطبع("    • كائنات مسجلة: " + نتيجة_التنسيق["كائنات_مسجلة"])
        اطبع("    • تحسينات مطبقة: " + نتيجة_التنسيق["تحسينات_مطبقة"].طول)
