دالة ضمان_توافق_نظام_التشغيل():
    # ضمان توافق الكود المحسن مع نظام التشغيل
    اطبع("💻 فحص توافق نظام التشغيل...")
    
    مت نتيجة_التوافق = {
        "متوافق": صحيح,
        "نظام_التشغيل": احصل_على_نظام_التشغيل(),
        "معمارية": احصل_على_معمارية_المعالج(),
        "ميزات_مدعومة": [],
        "ميزات_غير_مدعومة": [],
        "تحذيرات": []
    }
    
    # فحص دعم x86-64
    إذا نتيجة_التوافق["معمارية"] == "x86-64"
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "x86-64_native_code")
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "advanced_register_allocation")
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "instruction_scheduling")
    وإلا
        نتيجة_التوافق["متوافق"] = خطأ
        نتيجة_التوافق["ميزات_غير_مدعومة"] = أضف(نتيجة_التوافق["ميزات_غير_مدعومة"], "معمارية غير مدعومة: " + نتيجة_التوافق["معمارية"])
    نهاية
    
    # فحص دعم SIMD
    إذا يدعم_المعالج_SIMD()
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "SIMD_vectorization")
    وإلا
        نتيجة_التوافق["تحذيرات"] = أضف(نتيجة_التوافق["تحذيرات"], "SIMD غير مدعوم - تحسينات محدودة")
    نهاية
    
    # فحص دعم نظام التشغيل
    إذا نتيجة_التوافق["نظام_التشغيل"] == "Windows"
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "Windows_calling_convention")
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "PE_executable_generation")
    وإلا إذا نتيجة_التوافق["نظام_التشغيل"] == "Linux"
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "System_V_calling_convention")
        نتيجة_التوافق["ميزات_مدعومة"] = أضف(نتيجة_التوافق["ميزات_مدعومة"], "ELF_executable_generation")
    وإلا
        نتيجة_التوافق["تحذيرات"] = أضف(نتيجة_التوافق["تحذيرات"], "نظام تشغيل غير مختبر: " + نتيجة_التوافق["نظام_التشغيل"])
    نهاية
    
    إذا نتيجة_التوافق["متوافق"]
        اطبع("  ✅ نظام التشغيل متوافق")
        اطبع("    • النظام: " + نتيجة_التوافق["نظام_التشغيل"])
        اطبع("    • المعمارية: " + نتيجة_التوافق["معمارية"])
        اطبع("    • ميزات مدعومة: " + نتيجة_التوافق["ميزات_مدعومة"].طول)
    وإلا
        اطبع("  ❌ مشاكل في التوافق:")
