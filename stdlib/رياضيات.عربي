دالة قسمة(أ، ب):
    إذا ب == 0:
        ارجع "خطأ: قسمة على صفر"
    وإلا:
        ارجع أ / ب
    نهاية
نهاية

دالة مربع(عدد):
    ارجع ضرب(عدد، عدد)
نهاية

دالة جذر_تربيعي(عدد):
    # تنفيذ بسيط للجذر التربيعي باستخدام طريقة نيوتن
    إذا عدد < 0:
        ارجع "خطأ: لا يمكن حساب جذر عدد سالب"
    نهاية

    متغير تخمين = قسمة(عدد، 2)
    كرر من م = 0 إلى 10:
        متغير جديد = قسمة(جمع(تخمين، قسمة(عدد، تخمين)), 2)
        تخمين = جديد
    نهاية

    ارجع تخمين
نهاية

دالة قيمة_مطلقة(عدد):
    إذا عدد < 0:
        ارجع طرح(0، عدد)
    وإلا:
        ارجع عدد
    نهاية
نهاية

دالة أكبر(أ، ب):
    إذا أ > ب:
        ارجع أ
    وإلا:
        ارجع ب
    نهاية
