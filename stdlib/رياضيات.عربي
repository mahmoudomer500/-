# دوال مثلثية بسيطة (تقريبية)
دالة جيب(زاوية):
    # جيب الزاوية بالتقريب (الزاوية بالراديان)
    ارجع زاوية - قسمة(مربع(زاوية)، 6) + قسمة(مربع(مربع(زاوية)), 120)
نهاية

دالة جيب_تمام(زاوية):
    # جيب تمام الزاوية
    ارجع جذر_تربيعي(طرح(1، مربع(جيب(زاوية))))
نهاية

