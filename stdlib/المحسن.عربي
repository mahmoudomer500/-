دالة حسّن_الكود(كود_مصدري):
    # الدالة الرئيسية للتحسين
    اطبع("=== بدء عملية التحسين ===")

    كود_مصدري = اطو_الثوابت(كود_مصدري)
    كود_مصدري = حسّن_الحلقات(كود_مصدري)
    كود_مصدري = أزل_الكود_الميت(كود_مصدري)
    كود_مصدري = حسّن_التعيينات(كود_مصدري)
