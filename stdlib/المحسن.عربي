دالة حلل_المتغيرات_الحية(رسم_التدفق):
    # تحليل المتغيرات الحية باستخدام خوارزمية backward dataflow
    مت متغيرات_حية = {}
    مت تغيير = صحيح
    
    # تهيئة جميع العقد
    لكل عقدة في رسم_التدفق["عقد"]
        متغيرات_حية[عقدة.رقم] = {
            "مستخدمة": [],
            "معرفة": [],
            "حية_في_البداية": [],
            "حية_في_النهاية": []
        }
    نهاية
    
    # حساب المتغيرات المستخدمة والمعرفة لكل عقدة
    لكل عقدة في رسم_التدفق["عقد"]
        مت تعليمة = عقدة.تعليمة
        مت رقم_العقدة = عقدة.رقم
        
        إذا تعليمة.نوع == "إسناد"
            متغيرات_حية[رقم_العقدة]["معرفة"] = أضف(متغيرات_حية[رقم_العقدة]["معرفة"], تعليمة.متغير)
            إذا تعليمة.قيمة.نوع == "متغير"
                متغيرات_حية[رقم_العقدة]["مستخدمة"] = أضف(متغيرات_حية[رقم_العقدة]["مستخدمة"], تعليمة.قيمة.اسم)
            نهاية
        وإلا إذا تعليمة.نوع == "اطبع"
            إذا تعليمة.قيمة.نوع == "متغير"
                متغيرات_حية[رقم_العقدة]["مستخدمة"] = أضف(متغيرات_حية[رقم_العقدة]["مستخدمة"], تعليمة.قيمة.اسم)
            نهاية
        نهاية
    نهاية
    
    # خوارزمية النقطة الثابتة
    طالما تغيير
        تغيير = خطأ
        
        لكل عقدة في رسم_التدفق["عقد"]
            مت رقم_العقدة = عقدة.رقم
            مت حية_قديمة = متغيرات_حية[رقم_العقدة]["حية_في_البداية"]
            
            # حساب المتغيرات الحية في النهاية
            متغيرات_حية[رقم_العقدة]["حية_في_النهاية"] = []
            لكل حافة في رسم_التدفق["حواف"]
                إذا حافة["من"] == رقم_العقدة
                    مت عقدة_تالية = حافة["إلى"]
                    إذا متغيرات_حية[عقدة_تالية] != لا_شيء
                        متغيرات_حية[رقم_العقدة]["حية_في_النهاية"] = اتحاد_القوائم(
                            متغيرات_حية[رقم_العقدة]["حية_في_النهاية"],
                            متغيرات_حية[عقدة_تالية]["حية_في_البداية"]
                        )
                    نهاية
                نهاية
            نهاية
            
            # حساب المتغيرات الحية في البداية
            متغيرات_حية[رقم_العقدة]["حية_في_البداية"] = اتحاد_القوائم(
                متغيرات_حية[رقم_العقدة]["مستخدمة"],
                اطرح_القوائم(متغيرات_حية[رقم_العقدة]["حية_في_النهاية"], متغيرات_حية[رقم_العقدة]["معرفة"])
            )
            
            # فحص التغيير
            إذا لا قوائم_متساوية(حية_قديمة, متغيرات_حية[رقم_العقدة]["حية_في_البداية"])
                تغيير = صحيح
            نهاية
        نهاية
    نهاية
    
    ارجع متغيرات_حية
