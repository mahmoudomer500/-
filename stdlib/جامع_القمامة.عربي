# جامع القمامة العربي
# ينفذ نظام إدارة الذاكرة التلقائية

متغير كومة_الذاكرة = {}
متغير عداد_المراجع = {}
متغير معرف_فريد = 0

دالة احجز_ذاكرة(حجم):
    معرف_فريد = معرف_فريد + 1
    متغير معرف_كائن = "كائن_" + معرف_فريد
    كومة_الذاكرة[معرف_كائن] = {"حجم": حجم, "بيانات": "", "مستخدم": صادق}
    عداد_المراجع[معرف_كائن] = 1
    ارجع معرف_كائن
نهاية

دالة زد_مرجع(معرف_كائن):
    إذا عداد_المراجع[معرف_كائن] != "":
        عداد_المراجع[معرف_كائن] = عداد_المراجع[معرف_كائن] + 1
    نهاية
نهاية

دالة قلل_مرجع(معرف_كائن):
    إذا عداد_المراجع[معرف_كائن] != "":
        عداد_المراجع[معرف_كائن] = عداد_المراجع[معرف_كائن] - 1
        إذا عداد_المراجع[معرف_كائن] <= 0:
            جمع_قمامة(معرف_كائن)
        نهاية
    نهاية
نهاية

دالة جمع_قمامة(معرف_كائن):
    # تحرير الذاكرة
    كومة_الذاكرة[معرف_كائن] = ""
    عداد_المراجع[معرف_كائن] = ""
    اطبع("تم جمع القمامة للكائن: " + معرف_كائن)
نهاية

دالة نظف_الكومة():
    # جمع القمامة لجميع الكائنات غير المستخدمة
    كرر من معرف in عداد_المراجع:
        إذا عداد_المراجع[معرف] <= 0:
            جمع_قمامة(معرف)
        نهاية
    نهاية
نهاية

دالة احصل_على_حالة_الذاكرة():
    متغير عدد_الكائنات = حجم(كومة_الذاكرة)
    متغير حجم_مستخدم = 0

    كرر من معرف in كومة_الذاكرة:
        إذا كومة_الذاكرة[معرف] != "":
            حجم_مستخدم = حجم_مستخدم + كومة_الذاكرة[معرف]["حجم"]
        نهاية
    نهاية

    ارجع {"عدد_الكائنات": عدد_الكائنات, "حجم_مستخدم": حجم_مستخدم}
نهاية

# خوارزمية Mark & Sweep بسيطة
دالة علّم_وامسح():
    # الخطوة 1: علّم جميع الكائنات كغير مستخدمة
    كرر من معرف in كومة_الذاكرة:
        كومة_الذاكرة[معرف]["مستخدم"] = كاذب
    نهاية

    # الخطوة 2: علّم الكائنات المرجعة من الجذور (محاكاة)
    # في النسخة الحقيقية، سيتتبع المراجع من المتغيرات العالمية

    # الخطوة 3: امسح الكائنات غير المعلّمة
    كرر من معرف in كومة_الذاكرة:
        إذا كومة_الذاكرة[معرف]["مستخدم"] == كاذب:
            جمع_قمامة(معرف)
        نهاية
    نهاية
نهاية