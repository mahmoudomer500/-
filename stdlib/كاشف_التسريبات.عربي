# كاشف تسريبات الذاكرة العربي
# يكتشف ويصلح تسريبات الذاكرة في المترجم الذاتي

متغير سجل_التخصيصات = {}
متغير سجل_التحرير = {}
متغير تسريبات_مكتشفة = []

دالة سجل_تخصيص(معرف_كائن، نوع_الكائن، موقع_التخصيص):
    سجل_التخصيصات[معرف_كائن] = {"نوع": نوع_الكائن, "موقع": موقع_التخصيص, "وقت": احصل_على_الوقت()}
نهاية

دالة سجل_تحرير(معرف_كائن):
    إذا سجل_التخصيصات[معرف_كائن] != "":
        سجل_التحرير[معرف_كائن] = احصل_على_الوقت()
    نهاية
نهاية

دالة احصل_على_الوقت():
    # محاكاة الحصول على الوقت
    ارجع 1234567890
نهاية

دالة افحص_التسريبات():
    تسريبات_مكتشفة = []
    كرر من معرف in سجل_التخصيصات:
        إذا سجل_التحرير[معرف] == "":
            أضف_تسريب(معرف)
        نهاية
    نهاية
نهاية

دالة أضف_تسريب(معرف_كائن):
    متغير تسريب = سجل_التخصيصات[معرف_كائن]
    تسريب["معرف"] = معرف_كائن
    تسريبات_مكتشفة = تسريبات_مكتشفة + [تسريب]
نهاية

دالة أصلح_التسريبات():
    كرر من تسريب in تسريبات_مكتشفة:
        اطبع("إصلاح تسريب: " + تسريب["معرف"] + " من نوع " + تسريب["نوع"])
        # محاولة تحرير الكائن
        قلل_مرجع(تسريب["معرف"])
    نهاية
    تسريبات_مكتشفة = []
نهاية

دالة اطبع_تقرير_التسريبات():
    متغير عدد_التسريبات = حجم(تسريبات_مكتشفة)
    اطبع("=== تقرير تسريبات الذاكرة ===")
    اطبع("عدد التسريبات المكتشفة: " + عدد_التسريبات)

    إذا عدد_التسريبات > 0:
        كرر من تسريب in تسريبات_مكتشفة:
            اطبع("- كائن: " + تسريب["معرف"])
            اطبع("  نوع: " + تسريب["نوع"])
            اطبع("  موقع: " + تسريب["موقع"])
            اطبع("  وقت التخصيص: " + تسريب["وقت"])
        نهاية
    وإلا:
        اطبع("✅ لا توجد تسريبات ذاكرة")
    نهاية
نهاية

دالة نظف_سجلات():
    سجل_التخصيصات = {}
    سجل_التحرير = {}
    تسريبات_مكتشفة = []
