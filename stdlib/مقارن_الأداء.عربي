دالة احسب_إحصائيات_نوع(نتائج_النوع):
    # حساب إحصائيات لنوع اختبار معين
    مت مجموع_نسب = 0
    مت مجموع_أوقات_عربي = 0
    مت مجموع_أوقات_C++ = 0
    مت اختناقات_شائعة = {}
    
    لكل نتيجة في نتائج_النوع
        مجموع_نسب += نتيجة["مقارنة"]["نسبة_الأداء"]
        مجموع_أوقات_عربي += نتيجة["نتائج_عربي"]["وقت_التنفيذ"]
        مجموع_أوقات_C++ += نتيجة["نتائج_C++"]["وقت_التنفيذ"]
        
        # تجميع الاختناقات الشائعة
        لكل اختناق في نتيجة["مقارنة"]["اختناقات"]
            مت نوع_اختناق = اختناق["نوع"]
            اختناقات_شائعة[نوع_اختناق] = (اختناقات_شائعة[نوع_اختناق] أو 0) + 1
        نهاية
    نهاية
    
    ارجع {
        "عدد_الاختبارات": نتائج_النوع.طول,
        "متوسط_الأداء": مجموع_نسب / نتائج_النوع.طول,
        "متوسط_وقت_عربي": مجموع_أوقات_عربي / نتائج_النوع.طول,
        "متوسط_وقت_C++": مجموع_أوقات_C++ / نتائج_النوع.طول,
        "اختناقات_شائعة": اختناقات_شائعة,
        "تقييم": حدد_تقييم_نوع(مجموع_نسب / نتائج_النوع.طول)
    }
نهاية

دالة حدد_تقييم_نوع(متوسط_أداء):
    # تحديد تقييم نوع الاختبار
    إذا متوسط_أداء >= 95
        ارجع "ممتاز - يتفوق على C++"
    وإلا إذا متوسط_أداء >= 90
        ارجع "ممتاز - قريب جداً من C++"
    وإلا إذا متوسط_أداء >= 80
        ارجع "جيد جداً - أداء مقبول"
    وإلا إذا متوسط_أداء >= 70
        ارجع "جيد - يحتاج تحسينات طفيفة"
    وإلا إذا متوسط_أداء >= 60
        ارجع "مقبول - يحتاج تحسينات"
    وإلا
        ارجع "ضعيف - يحتاج مراجعة شاملة"
    نهاية
