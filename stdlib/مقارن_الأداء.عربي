دالة احسب_مقارنة_C++_شاملة(نتائج):
    # حساب مقارنة شاملة مع C++
    مت مجموع_أوقات_عربي = 0
    مت مجموع_أوقات_C++ = 0
    مت مجموع_ذاكرة_عربي = 0
    مت مجموع_ذاكرة_C++ = 0
    
    لكل نتيجة في نتائج
        مجموع_أوقات_عربي += نتيجة["نتائج_عربي"]["وقت_التنفيذ"]
        مجموع_أوقات_C++ += نتيجة["نتائج_C++"]["وقت_التنفيذ"]
        مجموع_ذاكرة_عربي += نتيجة["نتائج_عربي"]["استخدام_الذاكرة"]
        مجموع_ذاكرة_C++ += نتيجة["نتائج_C++"]["استخدام_الذاكرة"]
    نهاية
    
    ارجع {
        "نسبة_الوقت_الإجمالية": مجموع_أوقات_C++ / مجموع_أوقات_عربي,
        "نسبة_الذاكرة_الإجمالية": مجموع_ذاكرة_عربي / مجموع_ذاكرة_C++,
        "وفورات_الوقت": مجموع_أوقات_عربي - مجموع_أوقات_C++,
        "استهلاك_ذاكرة_إضافي": مجموع_ذاكرة_عربي - مجموع_ذاكرة_C++,
        "تقييم_عام": حدد_تقييم_مقارنة_C++(مجموع_أوقات_C++ / مجموع_أوقات_عربي)
    }
نهاية

