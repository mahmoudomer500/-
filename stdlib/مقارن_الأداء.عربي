دالة احسب_ملخص_الأداء(نتائج):
    # حساب ملخص الأداء العام
    مت مجموع_نسب = 0
    مت اختبارات_ناجحة = 0
    مت أفضل_أداء = 0
    مت أسوأ_أداء = 100
    
    لكل نتيجة في نتائج
        مت نسبة = نتيجة["مقارنة"]["نسبة_الأداء"]
        مجموع_نسب += نسبة
        
        إذا نسبة >= معايير_الأداء["هدف_نسبة_C++"] * 100
            اختبارات_ناجحة += 1
        نهاية
        
        إذا نسبة > أفضل_أداء
            أفضل_أداء = نسبة
        نهاية
        
        إذا نسبة < أسوأ_أداء
            أسوأ_أداء = نسبة
        نهاية
    نهاية
    
    مت متوسط_الأداء = مجموع_نسب / نتائج.طول
    مت نسبة_النجاح = (اختبارات_ناجحة * 100) / نتائج.طول
    
    إحصائيات_الأداء_عامة["نسبة_الأداء_المتوسطة"] = متوسط_الأداء
    
    ارجع {
        "متوسط_الأداء": متوسط_الأداء,
        "نسبة_النجاح": نسبة_النجاح,
        "أفضل_أداء": أفضل_أداء,
        "أسوأ_أداء": أسوأ_أداء,
        "اختبارات_ناجحة": اختبارات_ناجحة,
        "إجمالي_اختبارات": نتائج.طول,
        "يحقق_الهدف": متوسط_الأداء >= معايير_الأداء["هدف_نسبة_C++"] * 100
    }
نهاية
دالة حلل_النتائج_مفصل(نتائج):
    # تحليل مفصل للنتائج حسب نوع الاختبار
    مت تحليل = {}
    
    لكل نوع في أنواع_الاختبارات
        مت نتائج_النوع = []
        
        لكل نتيجة في نتائج
            إذا نتيجة["نوع_الاختبار"] == نوع
                نتائج_النوع = أضف(نتائج_النوع, نتيجة)
            نهاية
        نهاية
        
        إذا نتائج_النوع.طول > 0
            تحليل[نوع] = احسب_إحصائيات_نوع(نتائج_النوع)
        نهاية
    نهاية
    
    ارجع تحليل
