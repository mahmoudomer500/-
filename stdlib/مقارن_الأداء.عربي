    # قياس الأداء العربي
    مت نتائج_عربي = قيس_أداء_كود_عربي(كود_عربي, معاملات)
    
    # قياس الأداء C++ (محاكاة)
    مت نتائج_C++ = قيس_أداء_كود_C++(كود_C++, معاملات)
    
