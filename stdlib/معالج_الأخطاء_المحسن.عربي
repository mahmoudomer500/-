            "عرض_خريطة_أسطر",
            "فحص_متغير",
            "فحص_دالة",
            "عرض_أداء_سطر",
            "عرض_توصيات"
        ],
        "نشطة": صحيح
    }
    
    إحصائيات_معالجة_الأخطاء["جلسات_تشخيص_نشطة"] += 1
    
    اطبع("✅ جلسة التشخيص نشطة")
    اطبع("📋 الأوامر المتاحة:")
    لكل أمر في جلسة_تشخيص["أوامر_متاحة"]
