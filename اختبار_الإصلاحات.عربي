# ── اختبار 4: الأصناف مع هذا ─────────────────
اطبع("4. اختبار الأصناف مع هذا...")
صف حيوان:
    عام:
        نص الاسم
        رقم العمر

        دالة جديد(اسم، عمر):
            هذا.الاسم = اسم
            هذا.العمر = عمر

        دالة تحدث():
            أرجع "أنا " + هذا.الاسم + " عمري " + هذا.العمر
نهاية

متغير قط = حيوان.جديد("قطو"، 3)
متغير رسالة = قط.تحدث()
اطبع("   ✅ " + رسالة)

# ── اختبار 5: المصفوفات داخل الصنف ──────────
اطبع("5. اختبار المصفوفات داخل الصنف...")
صف قائمة_أرقام:
    عام:
        مصفوفة العناصر

        دالة جديد():
            هذا.العناصر = []

        دالة أضف_عنصر(عنصر):
            هذا.العناصر = هذا.العناصر + [عنصر]

        دالة الحجم():
            أرجع طول(هذا.العناصر)
نهاية

متغير ق = قائمة_أرقام.جديد()
ق.أضف_عنصر(10)
ق.أضف_عنصر(20)
ق.أضف_عنصر(30)
إذا ق.الحجم() == 3:
    اطبع("   ✅ المصفوفة داخل الصنف تعمل — الحجم: 3")
وإلا:
    اطبع("   ❌ فشل — الحجم: " + ق.الحجم())
نهاية

