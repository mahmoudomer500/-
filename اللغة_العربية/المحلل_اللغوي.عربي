# يُعيد تصدير الصنف محلل_لغوي تحت الاسم المطلوب: المحلل_اللغوي
# المسار المتوقع في الاستيراد: "اللغة_العربية/المحلل_اللغوي.عربي"

# ─── صنف جسر: المحلل_اللغوي مُضمَّن مباشرة (بدون استيراد خارجي) ───────────────
# تم نقل التعريف هنا مباشرة لتجنب مشاكل مسارات الاستيراد
صف المحلل_اللغوي:
    عام:
        دالة جديد(نص_مصدري):
            هذا.النص_المصدري = نص_مصدري
            هذا.الموضع_الحالي = 0
            هذا.رقم_السطر_الحالي = 1
            هذا.رقم_العمود_الحالي = 1
            هذا.الكلمات_المفتاحية = [
                "اطبع"، "متغير"، "دالة"، "أرجع"، "إذا"، "وإلا"،
                "بينما"، "لكل"، "من"، "إلى"، "صف"، "جديد"،
                "خاص"، "عام"، "محمي"، "استورد"، "صحيح"، "خطأ"،
                "و"، "أو"، "ليس"، "في"، "مصفوفة"، "نص"، "رقم"،
                "توقف"، "استمر"
            ]
        
        دالة هو_قيمة(قيمة):
            أرجع قيمة != لا_شيء
        
        دالة التالي():
            إذا هذا.الموضع_الحالي < حجم(هذا.النص_المصدري):
                متغير حرف = هذا.النص_المصدري[هذا.الموضع_الحالي]
                هذا.الموضع_الحالي = هذا.الموضع_الحالي + 1
                أرجع حرف
            نهاية
            أرجع لا_شيء
نهاية
