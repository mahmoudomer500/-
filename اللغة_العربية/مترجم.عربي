دالة اختبار_عمليات_متقدمة():
    اطبع("اختبار العمليات المتقدمة")
    # استخدام الضرب بدلاً من القوة لتجنب مشاكل الـ Parser
    قيمة_1 = 2 * 2 * 2  # 2^3
    قيمة_2 = 3 * 3      # 3^2
    قيمة_3 = 5 * 5      # 5^2
    قيمة_4 = 10 * 10    # 10^2
    
    اطبع("القيمة الأولى")
    اطبع(قيمة_1)
    اطبع("القيمة الثانية")
    اطبع(قيمة_2)
    اطبع("القيمة الثالثة")
    اطبع(قيمة_3)
    اطبع("القيمة الرابعة")
    اطبع(قيمة_4)
    
    مجموع = قيمة_1 + قيمة_2
    مجموع = مجموع + قيمة_3
    مجموع = مجموع + قيمة_4
    اطبع("المجموع")
    اطبع(مجموع)
    
    أرجع مجموع

اطبع("تشغيل المترجم العربي الكامل")
