دالة تحقق_من_الذاتية():
    اطبع("التحقق من القدرة الذاتية")
    مترجم_ذاتي = 1
    نتيجة = مترجم_كامل(مترجم_ذاتي, 1)
    
    إذا نتيجة == 1:
        اطبع("المترجم قادر على ترجمة نفسه")
        أرجع 1
    وإلا:
        اطبع("المترجم لا يستطيع ترجمة نفسه")
        أرجع 0

دالة عرض_إحصائيات():
    اطبع("إحصائيات المترجم الكامل")
    اطبع("الإصدار المحسن")
    اطبع("الدوال المدعومة")
    اطبع("الأنواع المدعومة")
