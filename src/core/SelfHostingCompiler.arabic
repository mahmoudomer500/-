# المرحلة 3: مولد الكود (Code Generator)  
# ════════════════════════════════════════════════

دالة ولد_كود(عقد):
    اطبع("")
    اطبع("═══ مولد الكود ═══")
    اطبع("توليد أوامر التنفيذ...")

    متغير أوامر = []

    كرر من م = 0 إلى حجم(عقد) - 1:
        متغير عقدة = عقد[م]

        إذا عقدة["نوع"] == "إسناد":
            متغير أمر_إسناد = {"نوع": "إسناد", "متغير": عقدة["متغير"], "قيمة": عقدة["قيمة"]}
            أوامر = أوامر + [أمر_إسناد]
        وإلا إذا عقدة["نوع"] == "طباعة":
            متغير أمر_طباعة = {"نوع": "طباعة", "قيمة": عقدة["قيمة"]}
            أوامر = أوامر + [أمر_طباعة]
        وإلا إذا عقدة["نوع"] == "نداء_دالة":
            متغير أمر_نداء = {"نوع": "نداء_دالة", "اسم": عقدة["اسم"], "بارامترات": عقدة["بارامترات"]}
            أوامر = أوامر + [أمر_نداء]
        وإلا إذا عقدة["نوع"] == "شرط":
            متغير عقد_الجسم_إذا = حلل_نحوياً(عقدة["جسم"])
            متغير أمر_شرط = {"نوع": "شرط", "شرط": عقدة["شرط"], "جسم": ولد_كود(عقد_الجسم_إذا)}
            أوامر = أوامر + [أمر_شرط]
        وإلا إذا عقدة["نوع"] == "حلقة_طالما":
            متغير عقد_الجسم_طالما = حلل_نحوياً(عقدة["جسم"])
            متغير أمر_حلقة = {"نوع": "حلقة_طالما", "شرط": عقدة["شرط"], "جسم": ولد_كود(عقد_الجسم_طالما)}
            أوامر = أوامر + [أمر_حلقة]
        وإلا إذا عقدة["نوع"] == "دالة":
            متغير عقد_الجسم_دالة = حلل_نحوياً(عقدة["جسم"])
            متغير أمر_دالة = {"نوع": "تعريف_دالة", "اسم": عقدة["اسم"], "بارامترات": عقدة["بارامترات"], "جسم": ولد_كود(عقد_الجسم_دالة)}
            أوامر = أوامر + [أمر_دالة]
        وإلا إذا عقدة["نوع"] == "حلقة_كرر":
            متغير عقد_الجسم_كرر = حلل_نحوياً(عقدة["جسم"])
            متغير أمر_كرر = {"نوع": "حلقة_كرر", "متغير": عقدة["متغير"], "جسم": ولد_كود(عقد_الجسم_كرر)}
            أوامر = أوامر + [أمر_كرر]
        وإلا إذا عقدة["نوع"] == "استيراد":
            متغير أمر_استيراد = {"نوع": "استيراد", "وحدة": عقدة["وحدة"]}
            أوامر = أوامر + [أمر_استيراد]
        نهاية
    نهاية

    اطبع("✓ تم توليد ")
    اطبع(حجم(أوامر))
    اطبع(" أمر تنفيذ")

    ارجع أوامر
نهاية

# ════════════════════════════════════════════════
# المترجم المتكامل (Bootstrap Compiler)
# ════════════════════════════════════════════════

دالة ترجم(كود_مصدري):
    اطبع("╔═══════════════════════════════════════╗")
    اطبع("║   المترجم العربي المستقل بذاته      ║")
    اطبع("║   Self-Hosting Arabic Compiler        ║")
    اطبع("╚═══════════════════════════════════════╝")
    اطبع("")
    اطبع("🚀 بدء عملية الترجمة الكاملة...")
    اطبع("")
    
    # المرحلة 1: Tokenization
    متغير رموز = حلل_رموز(كود_مصدري)
    
    # المرحلة 2: Parsing
    متغير عقد = حلل_نحوياً(رموز)
    
    # التحقق من وجود أخطاء قبل المتابعة
    طباعة_تقرير_الأخطاء()
    متغير عدد_أخطاء_ترجمة = حجم(سجل_الأخطاء)
    إذا عدد_أخطاء_ترجمة > 0:
        اطبع("")
        اطبع("⚠️ تم إيقاف الترجمة بسبب وجود أخطاء نحوية.")
        اطبع("يرجى إصلاح الأخطاء المذكورة أعلاه والمحاولة مرة أخرى.")
        اطبع("════════════════════════════════════════")
        ارجع []
    نهاية
    
    # المرحلة 3: Code Generation
    متغير تعليمات = ولد_كود(عقد)
    
    اطبع("")
    اطبع("════════════════════════════════════════")
    اطبع("✅ اكتملت الترجمة بنجاح!")
    اطبع("")
    اطبع("📊 الإحصائيات النهائية:")
    اطبع("  • الرموز: ")
    اطبع(حجم(رموز))
    اطبع("  • العقد النحوية: ")
    اطبع(حجم(عقد))
    اطبع("  • تعليمات Assembly: ")
    اطبع(حجم(تعليمات))
    اطبع("")
    
    متغير حجم_تقديري = حجم(تعليمات) * 50
    اطبع("  • الحجم التقديري: ")
    اطبع(حجم_تقديري)
    اطبع(" بايت")
    اطبع("")
    اطبع("╔═══════════════════════════════════════╗")
    
    ارجع تعليمات
نهاية

# ════════════════════════════════════════════════
# نقطة الدخول الرئيسية — تشغيل المترجم الذاتي
# ════════════════════════════════════════════════

# كود اختبار للتحقق من أن البناء الذاتي يعمل
متغير كود_اختبار = "اطبع(\"مرحباً من المترجم الذاتي!\")"

اطبع("╔═══════════════════════════════════════════════╗")
اطبع("║     بدء تشغيل المترجم العربي الذاتي          ║")
اطبع("╚═══════════════════════════════════════════════╝")
اطبع("")

متغير نتيجة_الترجمة = ترجم(كود_اختبار)

إذا حجم(نتيجة_الترجمة) > 0:
    اطبع("✅ نجح البناء الذاتي!")
    اطبع("   عدد تعليمات Assembly المُولَّدة: ")
    اطبع(حجم(نتيجة_الترجمة))
وإلا:
    اطبع("⚠️ البناء الذاتي انتهى بدون تعليمات (راجع الأخطاء أعلاه).")
نهاية
