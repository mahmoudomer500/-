# المترجم العربي المتكامل - Bootstrap Version
# يجمع المحلل اللغوي + المحلل النحوي + مولد الكود

متغير كاذب = 0
متغير صادق = 1

متغير سجل_الأخطاء = []

دالة أبلغ_عن_خطأ(رسالة، سطر، عمود):
    متغير خطأ = {"نوع": "خطأ_نحوي", "رسالة": رسالة، "سطر": سطر، "عمود": عمود}
    سجل_الأخطاء = سجل_الأخطاء + [خطأ]
    
    اطبع("❌ خطأ برمجي في [السطر: ")
    اطبع(سطر)
    اطبع("، العمود: ")
    اطبع(عمود)
    اطبع("]: ")
    اطبع(رسالة)
    اطبع("")
نهاية

دالة طباعة_تقرير_الأخطاء():
    متغير عدد_الأخطاء = حجم(سجل_الأخطاء)
    إذا عدد_الأخطاء == 0:
        اطبع("✅ لا توجد أخطاء برمجية. التحليل تم بنجاح.")
    وإلا:
        اطبع("════════════════════════════════════════")
        اطبع("تقرير الأخطاء (")
        اطبع(عدد_الأخطاء)
        اطبع(" أخطاء):")
        
        متغير نهاية_المجال = عدد_الأخطاء - 1
        كرر من م = 0 إلى نهاية_المجال:
            متغير خ = سجل_الأخطاء[م]
            اطبع("- ")
            اطبع(خ["رسالة"])
            اطبع(" (السطر: ")
            اطبع(خ["سطر"])
            اطبع(")")
        نهاية
        اطبع("════════════════════════════════════════")
    نهاية
نهاية

# ════════════════════════════════════════════════
# المرحلة 1: المحلل اللغوي (Tokenizer)
# ════════════════════════════════════════════════

دالة حلل_رموز(كود):
    متغير موقع_كود = 0
    متغير رموز = []
    متغير كلمة_حالية = ""
    متغير في_نص = كاذب
    متغير سطر_حالي = 1
    متغير عمود_حالي = 1
    متغير طول_كود = حجم(كود)
    متغير عداد_الأمان = 0

    اطبع("موقع_كود =")
    اطبع(موقع_كود)
    اطبع("═══ المحلل اللغوي العربي ═══")

    طالما موقع_كود < طول_كود و عداد_الأمان < 10000:
        متغير حرف = كود[موقع_كود]
        اطبع("Processing حرف: ")
        اطبع(حرف)
        اطبع(" at position ")
        اطبع(موقع_كود)
        
        إذا حرف == "\"":
            إذا في_نص:
                متغير رمز_نص = {"نوع": "نص", "قيمة": كلمة_حالية, "سطر": سطر_حالي, "عمود": عمود_حالي}
                رموز = رموز + [رمز_نص]
                كلمة_حالية = ""
                في_نص = كاذب
            وإلا:
                في_نص = صادق
            نهاية
        وإلا إذا في_نص:
            إذا حرف == "\\":
                إذا موقع_كود + 1 < طول_كود:
                    متغير حرف_هروب = كود[موقع_كود + 1]
                    إذا حرف_هروب == "\"" أو حرف_هروب == "\\" أو حرف_هروب == "n" أو حرف_هروب == "t":
                        إذا حرف_هروب == "\"": كلمة_حالية = كلمة_حالية + "\""
                        وإلا إذا حرف_هروب == "\\": كلمة_حالية = كلمة_حالية + "\\"
                        وإلا إذا حرف_هروب == "n": كلمة_حالية = كلمة_حالية + "\n"
                        وإلا إذا حرف_هروب == "t": كلمة_حالية = كلمة_حالية + "\t"
                        نهاية
                        موقع_كود = موقع_كود + 1
                        عمود_حالي = عمود_حالي + 1
                    وإلا:
                        كلمة_حالية = كلمة_حالية + حرف
                    نهاية
                وإلا:
                    كلمة_حالية = كلمة_حالية + حرف
                نهاية
            وإلا إذا حرف == "\n":
                أبلغ_عن_خطأ("خطأ: نص غير مغلق (وصلت لنهاية السطر)", سطر_حالي, عمود_حالي)
                في_نص = كاذب
                سطر_حالي = سطر_حالي + 1
                عمود_حالي = 0
            وإلا:
                كلمة_حالية = كلمة_حالية + حرف
            نهاية
        وإلا إذا حرف == " " أو حرف == "\n" أو حرف == "\t" أو حرف == "\r":
            إذا حرف == "\n":
                سطر_حالي = سطر_حالي + 1
                عمود_حالي = 0
            نهاية
            
            إذا حجم(كلمة_حالية) > 0:
                متغير نوع_كلمة = "معرف"
                إذا كلمة_حالية == "متغير" أو كلمة_حالية == "دالة" أو كلمة_حالية == "اطبع" أو كلمة_حالية == "نهاية" أو كلمة_حالية == "إذا" أو كلمة_حالية == "وإلا" أو كلمة_حالية == "وإلا_إذا" أو كلمة_حالية == "طالما" أو كلمة_حالية == "كرر" أو كلمة_حالية == "ارجع" أو كلمة_حالية == "توقف" أو كلمة_حالية == "استمر" أو كلمة_حالية == "استورد":
                    نوع_كلمة = "كلمة_محجوزة"
                وإلا إذا كلمة_حالية == "و" أو كلمة_حالية == "أو" أو كلمة_حالية == "ليس":
                    نوع_كلمة = "مؤثر_منطقي"
                نهاية
                متغير رمز_كلمة = {"نوع": نوع_كلمة, "قيمة": كلمة_حالية, "سطر": سطر_حالي, "عمود": عمود_حالي}
                رموز = رموز + [رمز_كلمة]
                كلمة_حالية = ""
            نهاية
        وإلا إذا حرف == "=" أو حرف == "+" أو حرف == "-" أو حرف == "*" أو حرف == "/" أو حرف == ">" أو حرف == "<" أو حرف == "!":
            إذا حجم(كلمة_حالية) > 0:
                متغير رمز_معرف = {"نوع": "معرف", "قيمة": كلمة_حالية, "سطر": سطر_حالي, "عمود": عمود_حالي}
                رموز = رموز + [رمز_معرف]
                كلمة_حالية = ""
            نهاية
            
            # التحقق من المؤثرات المزدوجة مثل == و != و >= و <=
            متغير مؤثر = حرف
            إذا موقع_كود + 1 < طول_كود:
                متغير حرف_تالي = كود[موقع_كود + 1]
                إذا حرف_تالي == "=":
                    مؤثر = حرف + حرف_تالي
                    موقع_كود = موقع_كود + 1 # تخطي الحرف التالي
                    عمود_حالي = عمود_حالي + 1
                نهاية
            نهاية
            
            متغير رمز_مؤثر = {"نوع": "مؤثر", "قيمة": مؤثر, "سطر": سطر_حالي, "عمود": عمود_حالي}
            رموز = رموز + [رمز_مؤثر]
        وإلا إذا حرف == "(" أو حرف == ")" أو حرف == ":" أو حرف == "،" أو حرف == "[" أو حرف == "]":
            إذا حجم(كلمة_حالية) > 0:
                متغير رمز_معرف_2 = {"نوع": "معرف", "قيمة": كلمة_حالية, "سطر": سطر_حالي, "عمود": عمود_حالي}
                رموز = رموز + [رمز_معرف_2]
                كلمة_حالية = ""
            نهاية
            متغير رمز_فاصل = {"نوع": "فاصل", "قيمة": حرف, "سطر": سطر_حالي, "عمود": عمود_حالي}
            رموز = رموز + [رمز_فاصل]
        وإلا:
            كلمة_حالية = كلمة_حالية + حرف
        نهاية
        
        موقع_كود = موقع_كود + 1
        عمود_حالي = عمود_حالي + 1
        عداد_الأمان = عداد_الأمان + 1
    نهاية
    
    إذا حجم(كلمة_حالية) > 0:
        متغير رمز_نهائي = {"نوع": "معرف", "قيمة": كلمة_حالية, "سطر": سطر_حالي, "عمود": عمود_حالي}
        رموز = رموز + [رمز_نهائي]
    نهاية
    
    اطبع("✓ تم العثور على ")
    اطبع(حجم(رموز))
    اطبع(" رموز")
    
    ارجع رموز
نهاية

# ════════════════════════════════════════════════
# المرحلة 2: المحلل النحوي (Parser)
# ════════════════════════════════════════════════

دالة حلل_مصفوفة(رموز, موقع):
    متغير عناصر = []
    متغير موقع_جديد = موقع

    # تخطي [
    موقع_جديد = موقع_جديد + 1

    طالما موقع_جديد < حجم(رموز) و رموز[موقع_جديد]["قيمة"] != "]":
        متغير عنصر = حلل_تعبير(رموز, موقع_جديد)
        عناصر = عناصر + [عنصر["تعبير"]]
        موقع_جديد = عنصر["موقع"]

        إذا موقع_جديد < حجم(رموز) و رموز[موقع_جديد]["قيمة"] == "،":
            موقع_جديد = موقع_جديد + 1
        نهاية
    نهاية

    # تخطي ]
    إذا موقع_جديد < حجم(رموز) و رموز[موقع_جديد]["قيمة"] == "]":
        موقع_جديد = موقع_جديد + 1
    نهاية

    ارجع {"مصفوفة": عناصر, "موقع": موقع_جديد}
نهاية

دالة حلل_تعبير(رموز, موقع):
    # تحليل تعبير بسيط مع دعم العمليات الحسابية والمصفوفات
    متغير موقع_جديد = موقع

    # التحقق من مصفوفة
    إذا موقع_جديد < حجم(رموز) و رموز[موقع_جديد]["قيمة"] == "[":
        متغير نتيجة_مصفوفة = حلل_مصفوفة(رموز, موقع_جديد)
        ارجع {"تعبير": {"نوع": "مصفوفة", "عناصر": نتيجة_مصفوفة["مصفوفة"]}, "موقع": نتيجة_مصفوفة["موقع"]}
    نهاية

    # تعبير عادي
    متغير يسار = ""
    متغير عملية = ""
    متغير يمين = ""

    # الحصول على الطرف الأيسر
    إذا موقع_جديد < حجم(رموز):
        يسار = رموز[موقع_جديد]["قيمة"]
        موقع_جديد = موقع_جديد + 1
    نهاية

    # التحقق من وجود عملية
    إذا موقع_جديد < حجم(رموز) و (رموز[موقع_جديد]["قيمة"] == "+" أو رموز[موقع_جديد]["قيمة"] == "-" أو رموز[موقع_جديد]["قيمة"] == "*" أو رموز[موقع_جديد]["قيمة"] == "/"):
        عملية = رموز[موقع_جديد]["قيمة"]
        موقع_جديد = موقع_جديد + 1

        # الحصول على الطرف الأيمن
        إذا موقع_جديد < حجم(رموز):
            يمين = رموز[موقع_جديد]["قيمة"]
            موقع_جديد = موقع_جديد + 1
        نهاية
    نهاية

    ارجع {"تعبير": {"نوع": "تعبير", "يسار": يسار, "عملية": عملية, "يمين": يمين}, "موقع": موقع_جديد}
نهاية

دالة حلل_نحوياً(رموز):
    اطبع("")
    اطبع("═══ المحلل النحوي العربي ═══")
    
    متغير عقد = []
    متغير موقع = 0
    
    طالما موقع < حجم(رموز):
        متغير رمز = رموز[موقع]
        
        إذا رمز["نوع"] == "كلمة_محجوزة" و رمز["قيمة"] == "متغير":
            موقع = موقع + 1
            إذا موقع < حجم(رموز) و رموز[موقع]["نوع"] == "معرف":
                متغير اسم_المتغير = رموز[موقع]["قيمة"]
                موقع = موقع + 1
                إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "=":
                    موقع = موقع + 1
                    متغير نتيجة_التعبير = حلل_تعبير(رموز, موقع)
                    متغير عقدة_إسناد = {"نوع": "إسناد", "متغير": اسم_المتغير, "قيمة": نتيجة_التعبير["تعبير"]}
                    عقد = عقد + [عقدة_إسناد]
                    موقع = نتيجة_التعبير["موقع"]
                وإلا:
                    أبلغ_عن_خطأ("خطأ: توقعت '=' بعد اسم المتغير '" + اسم_المتغير + "'", رموز[موقع-1]["سطر"], رموز[موقع-1]["عمود"])
                    موقع = موقع + 1
                نهاية
            وإلا:
                أبلغ_عن_خطأ("خطأ: توقعت اسماً للمتغير بعد كلمة 'متغير'", رمز["سطر"], رمز["عمود"])
                موقع = موقع + 1
            نهاية
        وإلا إذا رمز["نوع"] == "كلمة_محجوزة" و رمز["قيمة"] == "اطبع":
            موقع = موقع + 1
            إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "(":
                موقع = موقع + 1
                إذا موقع < حجم(رموز):
                    متغير قيمة_طباعة = رموز[موقع]["قيمة"]
                    متغير عقدة_طباعة = {"نوع": "طباعة", "قيمة": قيمة_طباعة}
                    عقد = عقد + [عقدة_طباعة]
                    موقع = موقع + 1
                    إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == ")":
                        موقع = موقع + 1
                    وإلا:
                        أبلغ_عن_خطأ("خطأ: توقعت ')' لإغلاق قوس الطباعة", رموز[موقع-1]["سطر"], رموز[موقع-1]["عمود"])
                        موقع = موقع + 1
                    نهاية
                وإلا:
                    أبلغ_عن_خطأ("خطأ: توقعت قيمة لطباعتها داخل الأقواس", رموز[موقع-1]["سطر"], رموز[موقع-1]["عمود"])
                    موقع = موقع + 1
                نهاية
            وإلا:
                أبلغ_عن_خطأ("خطأ: توقعت '(' بعد كلمة 'اطبع'", رمز["سطر"], رمز["عمود"])
                موقع = موقع + 1
            نهاية
        وإلا إذا رمز["نوع"] == "معرف":
            # قد يكون نداء دالة أو إسناد مباشر
            متغير اسم_معرف = رمز["قيمة"]
            موقع = موقع + 1
            إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "(":
                # نداء دالة
                موقع = موقع + 1
                متغير بارامترات_نداء = []
                طالما موقع < حجم(رموز) و رموز[موقع]["قيمة"] != ")":
                    متغير تعبير_بارامتر = حلل_تعبير(رموز, موقع)
                    بارامترات_نداء = بارامترات_نداء + [تعبير_بارامتر["تعبير"]]
                    موقع = تعبير_بارامتر["موقع"]
                    إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "،":
                        موقع = موقع + 1
                    نهاية
                نهاية
                
                إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == ")":
                    موقع = موقع + 1
                وإلا:
                    أبلغ_عن_خطأ("خطأ: توقعت ')' بعد بارامترات نداء الدالة '" + اسم_معرف + "'", رموز[موقع-1]["سطر"], رموز[موقع-1]["عمود"])
                    موقع = موقع + 1
                نهاية
                
                متغير عقدة_نداء = {"نوع": "نداء_دالة", "اسم": اسم_معرف, "بارامترات": بارامترات_نداء}
                عقد = عقد + [عقدة_نداء]
            وإلا إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "=":
                # إسناد مباشر لمتغير موجود
                موقع = موقع + 1
                متغير نتيجة_التعبير_مباشر = حلل_تعبير(رموز, موقع)
                متغير عقدة_إسناد_مباشر = {"نوع": "إسناد", "متغير": اسم_معرف, "قيمة": نتيجة_التعبير_مباشر["تعبير"]}
                عقد = عقد + [عقدة_إسناد_مباشر]
                موقع = نتيجة_التعبير_مباشر["موقع"]
            وإلا:
                أبلغ_عن_خطأ("خطأ: رمز غير متوقع '" + رموز[موقع]["قيمة"] + "' بعد المعرف '" + اسم_معرف + "'", رمز["سطر"], رمز["عمود"])
                موقع = موقع + 1
            نهاية
        وإلا إذا رمز["نوع"] == "كلمة_محجوزة" و رمز["قيمة"] == "استورد":
            موقع = موقع + 1
            إذا موقع < حجم(رموز) و رموز[موقع]["نوع"] == "معرف":
                متغير اسم_الوحدة = رموز[موقع]["قيمة"]
                متغير عقدة_استيراد = {"نوع": "استيراد", "وحدة": اسم_الوحدة}
                عقد = عقد + [عقدة_استيراد]
                موقع = موقع + 1
            وإلا:
                أبلغ_عن_خطأ("خطأ: توقعت اسم الوحدة بعد كلمة 'استورد'", رمز["سطر"], رمز["عمود"])
                موقع = موقع + 1
            نهاية
        وإلا إذا رمز["نوع"] == "كلمة_محجوزة" و رمز["قيمة"] == "دالة":
            موقع = موقع + 1
            إذا موقع < حجم(رموز) و رموز[موقع]["نوع"] == "معرف":
                متغير اسم_الدالة = رموز[موقع]["قيمة"]
                موقع = موقع + 1
                متغير بارامترات_دالة = []
                
                إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "(":
                    موقع = موقع + 1
                    طالما موقع < حجم(رموز) و رموز[موقع]["قيمة"] != ")":
                        إذا رموز[موقع]["نوع"] == "معرف":
                            بارامترات_دالة = بارامترات_دالة + [رموز[موقع]["قيمة"]]
                            موقع = موقع + 1
                            إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == "،":
                                موقع = موقع + 1
                            نهاية
                        وإلا:
                            موقع = موقع + 1
                        نهاية
                    نهاية
                    موقع = موقع + 1 # تخطي )
                نهاية
                
                إذا موقع < حجم(رموز) و رموز[موقع]["قيمة"] == ":":
                    موقع = موقع + 1
                وإلا:
                    أبلغ_عن_خطأ("خطأ: توقعت ':' بعد تعريف الدالة '" + اسم_الدالة + "'", رموز[موقع-1]["سطر"], رموز[موقع-1]["عمود"])
                    موقع = موقع + 1
                نهاية
                
                # استخراج رموز جسم الدالة
