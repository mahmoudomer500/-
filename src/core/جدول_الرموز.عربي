# جدول الرموز العربي - إدارة النطاقات المتقدمة
# يدير المتغيرات المحلية والعالمية

متغير جدول_الرموز = {}

دالة أضف_رمز(اسم، قيمة، نطاق):
    إذا نطاق == "عالمي":
        جدول_الرموز[اسم] = قيمة
    وإلا:
        # للنطاقات المحلية، استخدم مفتاح مركب
        متغير مفتاح = نطاق + "_" + اسم
        جدول_الرموز[مفتاح] = قيمة
    نهاية
نهاية

دالة احصل_رمز(اسم، نطاق):
    متغير مفتاح_محلي = نطاق + "_" + اسم
    إذا جدول_الرموز[مفتاح_محلي] != "":
        ارجع جدول_الرموز[مفتاح_محلي]
    وإلا إذا جدول_الرموز[اسم] != "":
        ارجع جدول_الرموز[اسم]
    وإلا:
        ارجع ""
    نهاية
نهاية

دالة احذف_رمز(اسم، نطاق):
    متغير مفتاح = نطاق + "_" + اسم
    جدول_الرموز[مفتاح] = ""
نهاية

دالة اطبع_جدول():
    كرر من مفتاح in جدول_الرموز:
        اطبع(مفتاح + ": " + جدول_الرموز[مفتاح])
    نهاية
