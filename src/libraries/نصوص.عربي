# ────────────────────────────────────────────────────────────────────
# 1️⃣  دالة حساب طول النص
# ────────────────────────────────────────────────────────────────────
# الوصف: الحصول على عدد أحرف النص
# المدخل: نص أي طول
# المخرج: عدد أحرف النص
# مثال: طول("مرحباً") = 5
# ────────────────────────────────────────────────────────────────────

دالة طول(نص):
    "حساب طول النص بالأحرف"
    متغير العداد = 0
    متغير الفهرس = 0
    طالما الفهرس < طول_حقيقي(نص):
        العداد = العداد + 1
        الفهرس = الفهرس + 1
    أرجع العداد


# ────────────────────────────────────────────────────────────────────
# 2️⃣  دالة البحث في النص (إرجاع فهرس)
# ────────────────────────────────────────────────────────────────────
# الوصف: البحث عن مكان وجود نص داخل نص آخر
# المدخل: النص الأساسي والنص المراد البحث عنه
# المخرج: فهرس البداية (0 أو أكبر) إذا وجد، -1 إذا لم يجد
# مثال: بحث("مرحباً بالعالم", "بالعالم") = 7
# ────────────────────────────────────────────────────────────────────

دالة بحث(نص، هدف):
    "البحث عن نص داخل نص آخر وإرجاع الفهرس"
    إذا طول_حقيقي(هدف) == 0:
        أرجع 0
    إذا طول_حقيقي(نص) < طول_حقيقي(هدف):
        أرجع -1
    
    متغير الفهرس = 0
    طالما الفهرس <= طول_حقيقي(نص) - طول_حقيقي(هدف):
        النتيجة = مقارنة_جزء(نص، الفهرس، هدف)
        إذا النتيجة == 1:
            أرجع الفهرس
        الفهرس = الفهرس + 1
    
    أرجع -1

# ────────────────────────────────────────────────────────────────────
# 2.5 دالة التحقق من الوجود (بسيطة)
# ────────────────────────────────────────────────────────────────────
دالة في(نص، هدف):
    "التحقق من وجود نص داخل آخر (نعم/لا)"
    متغير موقع = بحث(نص، هدف)
    إذا موقع == -1:
        أرجع 0
    أرجع 1

# ────────────────────────────────────────────────────────────────────
# 3️⃣  دالة تحويل لأحرف كبيرة (للأحرف اللاتينية فقط)
# ────────────────────────────────────────────────────────────────────
# الوصف: تحويل الأحرف اللاتينية الصغيرة (a-z) إلى كبيرة (A-Z)
# ⚠️  ملحوظة: هذه الدالة تعمل على الأحرف اللاتينية فقط!
#     الأحرف العربية لا تتأثر لأن اللغة العربية ليس بها أحرف كبيرة/صغيرة
# المدخل: النص المراد تحويله (ممكن أن يحتوي عربي + إنجليزي)
# المخرج: النص بعد تحويل الأحرف اللاتينية فقط
# أمثلة:
#   أعلى("Hello") = "HELLO"
#   أعلى("مرحبا") = "مرحبا"  (لا تغيير - عربي)
#   أعلى("Hello مرحبا") = "HELLO مرحبا"  (الإنجليزي فقط يتحول)
# ────────────────────────────────────────────────────────────────────

دالة أعلى(نص):
    "تحويل النص إلى أحرف كبيرة"
    متغير النص_الجديد = ""
    متغير الفهرس = 0
    طالما الفهرس < طول_حقيقي(نص):
        متغير الحرف = استخرج_حرف(نص، الفهرس)
        متغير ح_معدل = تحويل_أعلى(الحرف)
        النص_الجديد = النص_الجديد + ح_معدل
        الفهرس = الفهرس + 1
    أرجع النص_الجديد


# ────────────────────────────────────────────────────────────────────
# 4️⃣  دالة تحويل لأحرف صغيرة (للأحرف اللاتينية فقط)
# ────────────────────────────────────────────────────────────────────
# الوصف: تحويل الأحرف اللاتينية الكبيرة (A-Z) إلى صغيرة (a-z)
# ⚠️  ملحوظة: هذه الدالة تعمل على الأحرف اللاتينية فقط!
#     الأحرف العربية لا تتأثر لأن اللغة العربية ليس بها أحرف كبيرة/صغيرة
# المدخل: النص المراد تحويله (ممكن أن يحتوي عربي + إنجليزي)
# المخرج: النص بعد تحويل الأحرف اللاتينية فقط
# أمثلة:
#   أسفل("WORLD") = "world"
#   أسفل("مرحبا") = "مرحبا"  (لا تغيير - عربي)
#   أسفل("HELLO مرحبا") = "hello مرحبا"  (الإنجليزي فقط يتحول)
# ────────────────────────────────────────────────────────────────────

دالة أسفل(نص):
    "تحويل النص إلى أحرف صغيرة"
    متغير النص_الجديد = ""
    متغير الفهرس = 0
    طالما الفهرس < طول_حقيقي(نص):
        متغير الحرف = استخرج_حرف(نص، الفهرس)
        متغير ح_معدل = تحويل_أسفل(الحرف)
        النص_الجديد = النص_الجديد + ح_معدل
        الفهرس = الفهرس + 1
    أرجع النص_الجديد


# ────────────────────────────────────────────────────────────────────
# 5️⃣  دالة عكس النص
# ────────────────────────────────────────────────────────────────────
# الوصف: عكس ترتيب أحرف النص (من النهاية للبداية)
# المدخل: النص المراد عكسه
# المخرج: النص المعكوس
# مثال: عكس("مرحباً") = "اباحرم"
# ────────────────────────────────────────────────────────────────────

دالة عكس(نص):
    "عكس ترتيب أحرف النص"
    متغير النص_المعكوس = ""
    متغير الفهرس = طول_حقيقي(نص) - 1
    طالما الفهرس >= 0:
        متغير الحرف = استخرج_حرف(نص، الفهرس)
        النص_المعكوس = النص_المعكوس + الحرف
        الفهرس = الفهرس - 1
    أرجع النص_المعكوس


# ────────────────────────────────────────────────────────────────────
# 6️⃣  دالة الاستيراد من النص
# ────────────────────────────────────────────────────────────────────
# الوصف: استخراج جزء من النص من موضع معين بطول معين
# المدخل: النص والموضع الابتدائي والطول المطلوب
# المخرج: الجزء المستخرج
# مثال: جزء("مرحباً بالعالم", 0, 5) = "مرحباً"
# ────────────────────────────────────────────────────────────────────

دالة جزء(نص، بداية، طول_الجزء):
    "استخراج جزء من النص"
    إذا بداية < 0 أو طول_الجزء < 0:
        أرجع ""
    إذا بداية >= طول_حقيقي(نص):
        أرجع ""
    
    متغير النتيجة = ""
    متغير الفهرس = بداية
    متغير العداد = 0
    طالما العداد < طول_الجزء و الفهرس < طول_حقيقي(نص):
        متغير الحرف = استخرج_حرف(نص، الفهرس)
        النتيجة = النتيجة + الحرف
        الفهرس = الفهرس + 1
        العداد = العداد + 1
    
    أرجع النتيجة


# ────────────────────────────────────────────────────────────────────
# 7️⃣  دالة استبدال النص
# ────────────────────────────────────────────────────────────────────
# الوصف: استبدال جميع مثيلات نص بنص آخر
# المدخل: النص الأساسي، النص الأول (المراد استبداله)، النص الجديد
# المخرج: النص بعد الاستبدال
# مثال: استبدل("مرحباً مرحباً", "مرحباً", "أهلاً") = "أهلاً أهلاً"
# ────────────────────────────────────────────────────────────────────

دالة استبدل(نص، من، إلى):
    "استبدال جميع مثيلات نص بنص آخر"
    متغير النص_الجديد = ""
    متغير الفهرس = 0
    
    طالما الفهرس < طول_حقيقي(نص):
        متغير النتيجة = مقارنة_جزء(نص، الفهرس، من)
        إذا النتيجة == 1:
            النص_الجديد = النص_الجديد + إلى
            الفهرس = الفهرس + طول_حقيقي(من)
        وإلا:
            متغير الحرف = استخرج_حرف(نص، الفهرس)
            النص_الجديد = النص_الجديد + الحرف
            الفهرس = الفهرس + 1
    
    أرجع النص_الجديد


# ────────────────────────────────────────────────────────────────────
# 8️⃣  دالة حساب عدد مرات ظهور نص
# ────────────────────────────────────────────────────────────────────
# الوصف: عد عدد مرات ظهور نص معين في نص أكبر
# المدخل: النص الأساسي والنص المراد العد
# المخرج: عدد مرات الظهور
# مثال: عدد("مرحباً مرحباً مرحباً", "مرحباً") = 3
# ────────────────────────────────────────────────────────────────────

دالة عدد(نص، بحث):
    "عد عدد مرات ظهور نص"
    إذا طول_حقيقي(بحث) == 0:
        أرجع 0
    
    متغير العداد = 0
    متغير الفهرس = 0
    
    طالما الفهرس <= طول_حقيقي(نص) - طول_حقيقي(بحث):
        متغير النتيجة = مقارنة_جزء(نص، الفهرس، بحث)
        إذا النتيجة == 1:
            العداد = العداد + 1
            الفهرس = الفهرس + طول_حقيقي(بحث)
        وإلا:
            الفهرس = الفهرس + 1
    
    أرجع العداد


# ────────────────────────────────────────────────────────────────────
# 9️⃣  دالة تحويل النص إلى رقم
# ────────────────────────────────────────────────────────────────────
# الوصف: تحويل نص يحتوي على أرقام إلى قيمة رقمية
# المدخل: النص الرقمي (مثال: "123")
# المخرج: القيمة الرقمية (123)
# ────────────────────────────────────────────────────────────────────

دالة إلى_رقم(نص):
    "تحويل النص إلى رقم"
    # ملاحظة: هذه دالة مبسطة، يمكن تحسينها لدعم الكسور والإشارات
    متغير الناتج = 0
    متغير الفهرس = 0
    متغير إشارة = 1
    
    # تحقق من الإشارة
    إذا طول_حقيقي(نص) > 0:
        متغير أول_حرف = استخرج_حرف(نص, 0)
        إذا أول_حرف == "-":
            إشارة = -1
            الفهرس = 1
    
    طالما الفهرس < طول_حقيقي(نص):
        متغير رقم_حرف = استخرج_حرف(نص, الفهرس)
        # تحويل ASCII إلى رقم (0-9)
        # هذا يتطلب دعم داخلي للتحويل أو جدول، سنفترض وجود دالة مساعدة أو سنستخدم طريقة بسيطة إذا كانت اللغة تدعمها
        # للآن سنستخدم دالة داخلية مفترضة أو نحتاج لتنفيذها في CodeGenerator
        # أو يمكننا استخدام سلسلة "0123456789" للبحث
        متغير قيمة = بحث("0123456789", رقم_حرف)
        إذا قيمة != -1:
            الناتج = (الناتج * 10) + قيمة
            
        الفهرس = الفهرس + 1
        
    أرجع الناتج * إشارة

# ────────────────────────────────────────────────────────────────────
# 🔟  دالة تقليم (تنظيف) النص
# ────────────────────────────────────────────────────────────────────
# الوصف: حذف المسافات من البداية والنهاية
# المدخل: النص
# المخرج: النص المقلم
# ────────────────────────────────────────────────────────────────────

دالة تقليم(نص):
    "حذف المسافات من الأطراف"
    # الاسم المستعار لـ تنظيف
    أرجع تنظيف(نص)

دالة تنظيف(نص):
    "حذف المسافات من البداية والنهاية"
    # حذف من البداية
    متغير البداية = 0
    طالما البداية < طول_حقيقي(نص):
        متغير الحرف = استخرج_حرف(نص، البداية)
        إذا الحرف != " ":
            توقف
        البداية = البداية + 1
    
    # حذف من النهاية
    متغير النهاية = طول_حقيقي(نص) - 1
    طالما النهاية >= البداية:
        متغير الحرف = استخرج_حرف(نص، النهاية)
        إذا الحرف != " ":
            توقف
        النهاية = النهاية - 1
    
    أرجع جزء(نص، البداية، النهاية - البداية + 1)
