# مثال قاعدة بيانات أساسية
دالة مثال_قاعدة_بيانات_أساسية()
    إذا تهيئة_SQLite()
        # فتح قاعدة بيانات في الذاكرة
        إذا افتح_SQLite_في_الذاكرة()
            اطبع("تم فتح قاعدة البيانات في الذاكرة")

            # إنشاء جدول المستخدمين
            متغير أعمدة_المستخدمين = {
                {"المعرف", "INTEGER PRIMARY KEY AUTOINCREMENT"},
                {"الاسم", "TEXT NOT NULL"},
                {"العمر", "INTEGER"},
                {"البريد", "TEXT"}
            }

            إذا أنشئ_جدول_SQLite("المستخدمون", أعمدة_المستخدمين)
                اطبع("تم إنشاء جدول المستخدمين")

                # إدراج بيانات
                متغير مستخدم_جديد = {
                    {"الاسم", "أحمد محمد"},
                    {"العمر", "25"},
                    {"البريد", "ahmed@example.com"}
                }

                إذا أدرج_في_SQLite("المستخدمون", مستخدم_جديد)
                    اطبع("تم إدراج المستخدم بمعرف: " + احصل_على_معرف_آخر_صف_SQLite())
                نهاية

                # استعلام البيانات
                متغير نتيجة = استعل_من_SQLite("المستخدمون", {}, "")
                إذا احصل_على_عدد_الصفوف(نتيجة) > 0
                    متغير صف = احصل_على_صف(نتيجة, 0)
                    اطبع("المستخدم الأول: " + احصل_على_قيمة_من_صف(صف, "الاسم"))
                نهاية

                أغلق_SQLite()
                ارجع صحيح
            وإلا
                اطبع("فشل في إنشاء الجدول")
                ارجع خطأ
            نهاية
        وإلا
            اطبع("فشل في فتح قاعدة البيانات")
            ارجع خطأ
        نهاية
    وإلا
        اطبع("فشل في تهيئة SQLite")
        ارجع خطأ
