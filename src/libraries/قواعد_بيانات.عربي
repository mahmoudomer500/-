دالة استعل_من_SQLite(اسم_الجدول, الأعمدة, شرط)
    متغير sqlite = احصل_على_SQLite()
    إذا sqlite != 0
        متغير استعلام_SQL = "SELECT "

        # تحديد الأعمدة
        إذا حجم(الأعمدة) == 0
            استعلام_SQL = استعلام_SQL + "*"
        وإلا
            متغير أول_عمود = صحيح
            لكل عمود في الأعمدة
                إذا أول_عمود == خطأ
                    استعلام_SQL = استعلام_SQL + ", "
                نهاية
                استعلام_SQL = استعلام_SQL + عمود
                أول_عمود = خطأ
            نهاية
        نهاية

        استعلام_SQL = استعلام_SQL + " FROM " + اسم_الجدول

        # إضافة الشرط إذا وجد
        إذا شرط != ""
            استعلام_SQL = استعلام_SQL + " WHERE " + شرط
        نهاية

        متغير نتيجة = استعل_SQLite(sqlite, استعلام_SQL)
        ارجع نتيجة
    وإلا
        ارجع 0
    نهاية
