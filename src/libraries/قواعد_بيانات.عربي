# دالة إدراج بيانات في جدول
دالة أدرج_في_SQLite(اسم_الجدول, البيانات)
    متغير sqlite = احصل_على_SQLite()
    إذا sqlite != 0
        متغير استعلام_SQL = "INSERT INTO " + اسم_الجدول + " ("
        متغير قيم_SQL = "VALUES ("
        متغير أول_عمود = صحيح

        لكل عمود في البيانات
            إذا أول_عمود == خطأ
                استعلام_SQL = استعلام_SQL + ", "
                قيم_SQL = قيم_SQL + ", "
            نهاية
            استعلام_SQL = استعلام_SQL + احصل_على_مفتاح(عمود)
            قيم_SQL = قيم_SQL + "'" + احصل_على_قيمة(عمود) + "'"
            أول_عمود = خطأ
        نهاية

        استعلام_SQL = استعلام_SQL + ") " + قيم_SQL + ")"

        متغير نتيجة = نفذ_SQLite(sqlite, استعلام_SQL)
        ارجع نتيجة.نجح
    وإلا
        ارجع خطأ
    نهاية
