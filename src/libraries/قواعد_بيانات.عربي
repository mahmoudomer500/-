# دالة إنشاء جدول أساسي
دالة أنشئ_جدول_SQLite(اسم_الجدول, الأعمدة)
    متغير sqlite = احصل_على_SQLite()
    إذا sqlite != 0
        متغير استعلام_SQL = "CREATE TABLE IF NOT EXISTS " + اسم_الجدول + " ("
        متغير أول_عمود = صحيح

        لكل عمود في الأعمدة
            إذا أول_عمود == خطأ
                استعلام_SQL = استعلام_SQL + ", "
            نهاية
            استعلام_SQL = استعلام_SQL + احصل_على_اسم_العمود(عمود) + " " + احصل_على_نوع_العمود(عمود)
            أول_عمود = خطأ
        نهاية

        استعلام_SQL = استعلام_SQL + ")"

        متغير نتيجة = نفذ_SQLite(sqlite, استعلام_SQL)
        ارجع نتيجة.نجح
    وإلا
        ارجع خطأ
    نهاية
