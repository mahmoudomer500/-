# دالة تحويل إحداثيات الشاشة إلى نسب مئوية
دالة حوّل_إلى_نسب_مئوية(x, y, عرض_الشاشة, ارتفاع_الشاشة)
    ارجع {
        (x / عرض_الشاشة) * 100,
        (y / ارتفاع_الشاشة) * 100
    }
نهاية

# دالة الحصول على مسافة بين نقطتين
دالة احسب_المسافة(x1, y1, x2, y2)
    متغير فرق_x = x2 - x1
    متغير فرق_y = y2 - y1
    ارجع sqrt(فرق_x * فرق_x + فرق_y * فرق_y)
نهاية

# دالة التحقق من وجود نقطة داخل مستطيل
دالة هل_النقطة_داخل_المستطيل(x, y, مستطيل_x, مستطيل_y, عرض, ارتفاع)
    ارجع x >= مستطيل_x و x <= مستطيل_x + عرض و y >= مستطيل_y و y <= مستطيل_y + ارتفاع
نهاية

# دالة إنشاء منطقة حساسة للنقر
دالة أنشئ_منطقة_حساسة(x, y, عرض, ارتفاع, دالة_المعالجة)
    ارجع {
        "نوع": "منطقة_حساسة",
        "x": x,
        "y": y,
        "عرض": عرض,
        "ارتفاع": ارتفاع,
        "معالج": دالة_المعالجة
    }
نهاية

# دالة التحقق من النقر على منطقة حساسة
دالة هل_نقر_على_المنطقة(المنطقة, x_النقر, y_النقر)
    ارجع هل_النقطة_داخل_المستطيل(x_النقر, y_النقر, المنطقة["x"], المنطقة["y"], المنطقة["عرض"], المنطقة["ارتفاع"])
نهاية

