# ────────────────────────────────────────────────────────────────────
# 4️⃣  دالة قراءة الأسطر (إلى مصفوفة)
# ────────────────────────────────────────────────────────────────────

دالة اقرأ_سطور(مسار):
    "قراءة محتوى الملف وإرجاعه كمصفوفة أسطر"
    المحتوى = اقرأ_ملف(مسار)
    إذا طول_حقيقي(المحتوى) == 0:
        أرجع []
    
    # تقسيم المحتوى بناءً على السطر الجديد
    # سنحتاج لدالة تقسيم (Split) في مكتبة النصوص، أو نقوم بها هنا يدوياً
    
    الأسطر = []
    السطر_الحالي = ""
    الفهرس = 0
    طالما الفهرس < طول_حقيقي(المحتوى):
        الحرف = استخرج_حرف(المحتوى، الفهرس)
        إذا الحرف == "\n":
            أضيف(الأسطر, السطر_الحالي)
            السطر_الحالي = ""
        وإلا:
            السطر_الحالي = السطر_الحالي + الحرف
        الفهرس = الفهرس + 1
        
    # إضافة السطر الأخير
    إذا طول_حقيقي(السطر_الحالي) > 0:
        أضيف(الأسطر, السطر_الحالي)
        
    أرجع الأسطر

