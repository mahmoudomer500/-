# دالة إنشاء صنف أساسي للأشكال - محسّن مع نظام الربط
دالة إنشاء_صنف_الشكل_الأساسي()
    متغير اسم_الصنف = إنشاء_صنف("شكل", 0)

    # إضافة المتغيرات الأساسية
    أضف_متغير_للصنف(اسم_الصنف, "x", 0.0)
    أضف_متغير_للصنف(اسم_الصنف, "y", 0.0)
    أضف_متغير_للصنف(اسم_الصنف, "لون", {1.0, 1.0, 1.0})
    أضف_متغير_للصنف(اسم_الصنف, "زاوية_الدوران", 0.0)
    أضف_متغير_للصنف(اسم_الصنف, "مقياس_x", 1.0)
    أضف_متغير_للصنف(اسم_الصنف, "مقياس_y", 1.0)

    # تعريف الدوال المحلية أولاً
    دالة تحريك_الشكل_محلي(هذا, دلتا_x, دلتا_y)
        متغير x_حالي = هذا["احصل_على_متغير"](هذا, "x")
        متغير y_حالي = هذا["احصل_على_متغير"](هذا, "y")
        هذا["عيّن_متغير"](هذا, "x", x_حالي + دلتا_x)
        هذا["عيّن_متغير"](هذا, "y", y_حالي + دلتا_y)
        اطبع("تم تحريك الشكل بمقدار (" + دلتا_x + ", " + دلتا_y + ")")
    نهاية

    دالة غيّر_لون_الشكل_محلي(هذا, لون_جديد)
        هذا["عيّن_متغير"](هذا, "لون", لون_جديد)
        اطبع("تم تغيير لون الشكل")
    نهاية

    دالة أدر_الشكل_محلي(هذا, زاوية)
        متغير زاوية_حالية = هذا["احصل_على_متغير"](هذا, "زاوية_الدوران")
        هذا["عيّن_متغير"](هذا, "زاوية_الدوران", زاوية_حالية + زاوية)
        اطبع("تم تدوير الشكل بزاوية " + زاوية + " درجة")
    نهاية

    دالة احسب_المساحة_محلي(هذا)
        ارجع 0.0  # القيمة الافتراضية - سيتم تجاوزها في الأصناف المشتقة
    نهاية

    دالة ارسم_الشكل_محلي(هذا)
        # لا شيء - سيتم تجاوزها في الأصناف المشتقة
        اطبع("رسم الشكل الأساسي")
    نهاية

    # تسجيل الدوال المحلية في نظام الربط
    أضف_دالة_محلية_للصنف(اسم_الصنف, "تحريك", تحريك_الشكل_محلي)
    أضف_دالة_محلية_للصنف(اسم_الصنف, "غيّر_اللون", غيّر_لون_الشكل_محلي)
    أضف_دالة_محلية_للصنف(اسم_الصنف, "أدر", أدر_الشكل_محلي)
    أضف_دالة_محلية_للصنف(اسم_الصنف, "احسب_المساحة", احسب_المساحة_محلي)
    أضف_دالة_محلية_للصنف(اسم_الصنف, "ارسم", ارسم_الشكل_محلي)

    ارجع اسم_الصنف
نهاية

# دالة إنشاء صنف المستطيل (يرث من الشكل)
دالة إنشاء_صنف_المستطيل()
    # إنشاء الصنف الأساسي أولاً
    متغير صنف_الأساس = إنشاء_صنف_الشكل_الأساسي()

    # إنشاء صنف المستطيل الذي يرث من الشكل
    متغير اسم_الصنف = إنشاء_صنف("مستطيل", صنف_الأساس)

    # إضافة متغيرات خاصة بالمستطيل
    أضف_متغير_للصنف(اسم_الصنف, "العرض", 1.0)
    أضف_متغير_للصنف(اسم_الصنف, "الارتفاع", 1.0)

    # تجاوز دالة حساب المساحة
    دالة احسب_مساحة_المستطيل(هذا)
        متغير العرض = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "العرض")
        متغير الارتفاع = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "الارتفاع")
        ارجع العرض * الارتفاع
    نهاية

    # تجاوز دالة رسم المستطيل
    دالة ارسم_المستطيل(هذا)
        متغير x = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "x")
        متغير y = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "y")
        متغير العرض = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "العرض")
        متغير الارتفاع = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "الارتفاع")
        متغير لون = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "لون")
        متغير زاوية = احصل_على_متغير_الكائن(هذا["معرف_الكائن"], "زاوية_الدوران")

        # رسم المستطيل باستخدام OpenGL
        إذا نظام_الرسومات_المتقدم != 0
            امسح_الشاشة(قناع_اللون)
            حدد_لون_المسح(0.1, 0.1, 0.1, 1.0)

            وضع_مصفوفة_العرض()
            اسقاط_متعامد(-2.0, 2.0, -2.0, 2.0, -1.0, 1.0)

            وضع_مصفوفة_النموذج()
            حرك(x, y, 0.0)
            أدر(زاوية, 0.0, 0.0, 1.0)

            ابدأ_رسم_OpenGL(نظام_الرسومات_المتقدم, 7)  # GL_QUADS
            حدد_لون_OpenGL(نظام_الرسومات_المتقدم, لون[0], لون[1], لون[2])

            # رسم المستطيل
            حدد_رأس_OpenGL(نظام_الرسومات_المتقدم, -العرض/2, -الارتفاع/2, 0.0)
            حدد_رأس_OpenGL(نظام_الرسومات_المتقدم, العرض/2, -الارتفاع/2, 0.0)
            حدد_رأس_OpenGL(نظام_الرسومات_المتقدم, العرض/2, الارتفاع/2, 0.0)
            حدد_رأس_OpenGL(نظام_الرسومات_المتقدم, -العرض/2, الارتفاع/2, 0.0)

            انه_رسم_OpenGL(نظام_الرسومات_المتقدم)
            أفرغ_OpenGL(نظام_الرسومات_المتقدم)
        نهاية
    نهاية

    # إضافة الدوال الجديدة أو المجوزة
    أضف_دالة_للصنف(اسم_الصنف, "احسب_المساحة", احسب_مساحة_المستطيل)
    أضف_دالة_للصنف(اسم_الصنف, "ارسم", ارسم_المستطيل)

    # باني المستطيل
    دالة باني_المستطيل(هذا, x_أولي, y_أولي, عرض_أولي, ارتفاع_أولي, لون_أولي)
        عيّن_متغير_الكائن(هذا["معرف_الكائن"], "x", x_أولي)
        عيّن_متغير_الكائن(هذا["معرف_الكائن"], "y", y_أولي)
        عيّن_متغير_الكائن(هذا["معرف_الكائن"], "العرض", عرض_أولي)
        عيّن_متغير_الكائن(هذا["معرف_الكائن"], "الارتفاع", ارتفاع_أولي)
        عيّن_متغير_الكائن(هذا["معرف_الكائن"], "لون", لون_أولي)
        اطبع("تم إنشاء مستطيل جديد")
    نهاية

    عيّن_باني_الصنف(اسم_الصنف, باني_المستطيل)

    ارجع اسم_الصنف
نهاية

