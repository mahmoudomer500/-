# ────────────────────────────────────────────────────────────────────
# 1️⃣  دالة حساب الجذر التربيعي
# ────────────────────────────────────────────────────────────────────
# الوصف: حساب الجذر التربيعي لرقم موجب
# المدخل: رقم (يجب أن يكون موجب)
# المخرج: الجذر التربيعي للرقم
# مثال: جذر(16) = 4
# ────────────────────────────────────────────────────────────────────

دالة جذر(رقم):
    "حساب الجذر التربيعي (Newton's Method)"
    إذا رقم < 0:
        اطبع("❌ خطأ: لا يمكن حساب جذر رقم سالب!")
        أرجع 0
    إذا رقم == 0:
        أرجع 0
    وإلا:
        # استخدام خوارزمية نيوتن للتقريب
        متغير تخمين = رقم / 2
        متغير تكرار = 0
        متغير التخمين_الجديد = 0
        طالما تكرار < 15:
            التخمين_الجديد = (تخمين + رقم / تخمين) / 2
            إذا التخمين_الجديد == تخمين:
                أرجع تخمين
            تخمين = التخمين_الجديد
            تكرار = تكرار + 1
        أرجع تخمين


# ────────────────────────────────────────────────────────────────────
# 2️⃣  دالة القيمة المطلقة
# ────────────────────────────────────────────────────────────────────
# الوصف: الحصول على القيمة المطلقة (موجبة دائماً)
# المدخل: أي رقم (موجب أو سالب)
# المخرج: القيمة الموجبة للرقم
# مثال: مطلق(-5) = 5, مطلق(5) = 5
# ────────────────────────────────────────────────────────────────────

دالة مطلق(رقم):
    "القيمة المطلقة للرقم"
    إذا رقم < 0:
        أرجع رقم * -1
    وإلا:
        أرجع رقم


# ────────────────────────────────────────────────────────────────────
# 3️⃣  دالة أكبر قيمة
# ────────────────────────────────────────────────────────────────────
# الوصف: مقارنة رقمين وإرجاع الأكبر
# المدخل: رقمان للمقارنة
# المخرج: الرقم الأكبر
# مثال: أكبر(10, 25) = 25
# ────────────────────────────────────────────────────────────────────

دالة أكبر(أ، ب):
    "أكبر قيمة بين رقمين"
    إذا أ > ب:
        أرجع أ
    وإلا:
        أرجع ب


# ────────────────────────────────────────────────────────────────────
# 4️⃣  دالة أصغر قيمة
# ────────────────────────────────────────────────────────────────────
# الوصف: مقارنة رقمين وإرجاع الأصغر
# المدخل: رقمان للمقارنة
# المخرج: الرقم الأصغر
# مثال: أصغر(10, 25) = 10
# ────────────────────────────────────────────────────────────────────

دالة أصغر(أ، ب):
    "أصغر قيمة بين رقمين"
    إذا أ < ب:
        أرجع أ
    وإلا:
        أرجع ب


# ────────────────────────────────────────────────────────────────────
# 5️⃣  دالة الأس (الطاقة)
# ────────────────────────────────────────────────────────────────────
# الوصف: حساب الطاقة (الأساس مرفوع للأس)
# المدخل: أساس (الرقم الأساسي) وأس (عدد مرات الضرب)
# المخرج: نتيجة الطاقة
# مثال: أس(2, 3) = 8 (لأن 2 × 2 × 2 = 8)
# ────────────────────────────────────────────────────────────────────

دالة أس(أساس، قوة):
    "حساب الأس (أساس ^ قوة)"
    إذا قوة < 0:
        اطبع("❌ خطأ: الأس يجب أن يكون موجب!")
        أرجع 0
    إذا قوة == 0:
        أرجع 1
    وإلا:
        متغير النتيجة = 1
        متغير عداد = 0
        طالما عداد < قوة:
            النتيجة = النتيجة * أساس
            عداد = عداد + 1
        أرجع النتيجة

دالة طاقة(أساس، قوة):
    "alias for أس"
    أرجع أس(أساس، قوة)


# ────────────────────────────────────────────────────────────────────
# 6️⃣  دالة العامل (Factorial)
# ────────────────────────────────────────────────────────────────────
# الوصف: حساب عاملي رقم (n! = n × (n-1) × (n-2) × ... × 1)
# المدخل: رقم موجب
# المخرج: عاملي الرقم
# مثال: عاملي(5) = 120 (لأن 5 × 4 × 3 × 2 × 1 = 120)
# ────────────────────────────────────────────────────────────────────

دالة عاملي(ن):
    "حساب عاملي ن (n!)"
    إذا ن < 0:
        اطبع("❌ خطأ: العامل يجب أن يكون موجب!")
        أرجع 0
    إذا ن == 0 أو ن == 1:
        أرجع 1
    وإلا:
        متغير النتيجة = ن * عاملي(ن - 1)
        أرجع النتيجة


# ────────────────────────────────────────────────────────────────────
# 7️⃣  دالة حساب المتوسط
# ────────────────────────────────────────────────────────────────────
# الوصف: حساب المتوسط الحسابي لثلاثة أرقام
# المدخل: ثلاثة أرقام
# المخرج: المتوسط الحسابي
# مثال: متوسط(10, 20, 30) = 20
# ────────────────────────────────────────────────────────────────────

دالة متوسط(أول، ثاني، ثالث):
    "حساب المتوسط الحسابي لـ 3 أرقام"
    متغير الجمع = أول + ثاني + ثالث
    متغير المتوسط = الجمع / 3
    أرجع المتوسط


# ────────────────────────────────────────────────────────────────────
# 8️⃣  دالة التحقق من الرقم الزوجي
# ────────────────────────────────────────────────────────────────────
# الوصف: التحقق من كون الرقم زوجياً (ينقسم على 2)
# المدخل: رقم صحيح
# المخرج: 1 إذا كان زوجي، 0 إذا كان فردي
# مثال: زوجي(4) = 1, زوجي(5) = 0
# ────────────────────────────────────────────────────────────────────

دالة زوجي(رقم):
    "التحقق من كون الرقم زوجي"
    إذا رقم % 2 == 0:
        أرجع 1
    وإلا:
        أرجع 0


# ────────────────────────────────────────────────────────────────────
# 9️⃣  دالة التحقق من الرقم الفردي
# ────────────────────────────────────────────────────────────────────
# الوصف: التحقق من كون الرقم فردياً (لا ينقسم على 2)
# المدخل: رقم صحيح
# المخرج: 1 إذا كان فردي، 0 إذا كان زوجي
# مثال: فردي(5) = 1, فردي(4) = 0
# ────────────────────────────────────────────────────────────────────

دالة فردي(رقم):
    "التحقق من كون الرقم فردي"
    إذا رقم % 2 != 0:
        أرجع 1
    وإلا:
        أرجع 0

# ────────────────────────────────────────────────────────────────────
# 🔟  دالة توليد رقم عشوائي (Pseudo-Random)
# ────────────────────────────────────────────────────────────────────
# الوصف: توليد رقم شبه عشوائي بين 0 وحد معين
# المدخل: الحد الأقصى (غير مشمول)
# المخرج: رقم عشوائي
# ملاحظة: يستخدم المولد المدمج rand() من MSVCRT
# ────────────────────────────────────────────────────────────────────

دالة عشوائي(حد_أقصى):
    "توليد رقم شبه عشوائي بين 0 وحد معين"
    # ملاحظة: هذه دالة مبسطة، في التنفيذ الحقيقي ستستخدم rand() من MSVCRT
    # للاختبار، نرجع رقماً ثابتاً بسيطاً
    أرجع حد_أقصى / 2

