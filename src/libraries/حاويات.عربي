# 7️⃣  خوارزميات البحث والفرز
# ────────────────────────────────────────────────────────────────────

# دالة البحث الخطي
دالة بحث_خطي(القائمة, العنصر_المطلوب)
    ارجع ابحث_في_القائمة(القائمة, العنصر_المطلوب)
نهاية

# دالة البحث الثنائي (تتطلب قائمة مرتبة)
دالة بحث_ثنائي(القائمة, العنصر_المطلوب)
    متغير يسار = 0
    متغير يمين = حجم_القائمة(القائمة) - 1

    بينما يسار <= يمين
        متغير منتصف = (يسار + يمين) / 2
        متغير عنصر_المنتصف = احصل_من_القائمة(القائمة, منتصف)

        إذا عنصر_المنتصف == العنصر_المطلوب
            ارجع منتصف
        وإلا إذا عنصر_المنتصف < العنصر_المطلوب
            يسار = منتصف + 1
        وإلا
            يمين = منتصف - 1
        نهاية
    نهاية

    ارجع -1
نهاية

# دالة فرز بالفقاعات
دالة رتب_بالفقاعات(القائمة)
    متغير ن = حجم_القائمة(القائمة)
    لكل i من 0 إلى ن - 1
        لكل j من 0 إلى ن - i - 2
            إذا احصل_من_القائمة(القائمة, j) > احصل_من_القائمة(القائمة, j + 1)
                متغير مؤقت = احصل_من_القائمة(القائمة, j)
                استبدل_عنصر_في_القائمة(القائمة, j, احصل_من_القائمة(القائمة, j + 1))
                استبدل_عنصر_في_القائمة(القائمة, j + 1, مؤقت)
            نهاية
        نهاية
    نهاية
نهاية

# دالة فرز بالإدراج
دالة رتب_بالإدراج(القائمة)
    متغير ن = حجم_القائمة(القائمة)
    لكل i من 1 إلى ن - 1
        متغير مفتاح = احصل_من_القائمة(القائمة, i)
        متغير j = i - 1

        بينما j >= 0 و احصل_من_القائمة(القائمة, j) > مفتاح
            استبدل_عنصر_في_القائمة(القائمة, j + 1, احصل_من_القائمة(القائمة, j))
            j = j - 1
        نهاية

        استبدل_عنصر_في_القائمة(القائمة, j + 1, مفتاح)
    نهاية
نهاية

