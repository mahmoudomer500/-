# دالة إضافة عنصر إلى مصفوفة (افتراض وجودها)
دالة أضف_إلى_مصفوفة(مصفوفة، عنصر):
    "إضافة عنصر إلى مصفوفة"
    # هذه دالة افتراضية - يجب تنفيذها في النظام الأساسي
    مصفوفة[طول_مصفوفة(مصفوفة)] = عنصر

# دالة طول المصفوفة
دالة طول_مصفوفة(مصفوفة):
    "حساب طول المصفوفة"
    # هذه دالة افتراضية - يجب تنفيذها في النظام الأساسي
    متغير عداد = 0
    متغير فهرس = 0
    طالما مصفوفة[فهرس] != "":
        عداد = عداد + 1
        فهرس = فهرس + 1
    أرجع عداد

