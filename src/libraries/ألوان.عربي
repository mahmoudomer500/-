# دالة تحويل RGB إلى ANSI 256 لون
دالة RGB_إلى_ANSI256(لون_RGB):
    "تحويل لون RGB إلى أقرب لون في لوحة ANSI 256"
    متغير أحمر = لون_RGB[0]
    متغير أخضر = لون_RGB[1]
    متغير أزرق = لون_RGB[2]

    # حساب الفهرس في لوحة 256 لون
    متغير أحمر_محسوب = (أحمر * 5) / 255
    متغير أخضر_محسوب = (أخضر * 5) / 255
    متغير أزرق_محسوب = (أزرق * 5) / 255

    متغير فهرس = 16 + (أحمر_محسوب * 36) + (أخضر_محسوب * 6) + أزرق_محسوب
    أرجع إلى_صحيح(فهرس)

# دالة تحويل RGB إلى ANSI
دالة RGB_إلى_ANSI(لون_RGB):
    "تحويل لون RGB إلى كود ANSI 256 لون"
    متغير فهرس = RGB_إلى_ANSI256(لون_RGB)
    أرجع "\033[38;5;" + إلى_نص(فهرس) + "m"

# ────────────────────────────────────────────────────────────────────
# 1️⃣4️⃣ وظائف التحقق من توافق الألوان
# ────────────────────────────────────────────────────────────────────

# دالة حساب سطوع اللون
دالة سطوع_RGB(لون_RGB):
    "حساب سطوع لون RGB (0-255)"
    متغير أحمر = لون_RGB[0]
    متغير أخضر = لون_RGB[1]
    متغير أزرق = لون_RGB[2]
    # صيغة حساب السطوع: 0.299*R + 0.587*G + 0.114*B
    أرجع (أحمر * 0.299) + (أخضر * 0.587) + (أزرق * 0.114)

# دالة التحقق من تباين الألوان
دالة تباين_جيد(لون1_RGB، لون2_RGB):
    "التحقق من وجود تباين كافي بين لونين"
    متغير سطوع1 = سطوع_RGB(لون1_RGB)
    متغير سطوع2 = سطوع_RGB(لون2_RGB)
    متغير نسبة_تباين = مطلق(سطوع1 - سطوع2)
    # تباين جيد إذا كان الفرق أكبر من 125
    أرجع نسبة_تباين > 125

# دالة توليد لون متباين
دالة لون_متباين(لون_RGB):
    "توليد لون متباين للخلفية"
    متغير سطوع = سطوع_RGB(لون_RGB)
    إذا سطوع > 128:
        أرجع [0، 0، 0]  # أسود للخلفيات الفاتحة
    وإلا:
        أرجع [255، 255، 255]  # أبيض للخلفيات الداكنة
    نهاية

