# دالة تطبيق لون وخلفية معاً
دالة لون_مختلط(لون_النص، لون_الخلفية، النص):
    "تطبيق لون نص ولون خلفية معاً"
    أرجع لون_النص + لون_الخلفية + النص + إعادة_تعيين

