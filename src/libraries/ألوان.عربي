# دالة خلط لونين RGB
دالة خلط_RGB(لون1_RGB، لون2_RGB، نسبة):
    "خلط لونين RGB بنسبة معينة (0-1)"
    إذا نسبة < 0 أو نسبة > 1:
        رسالة_خطأ("النسبة يجب أن تكون بين 0 و 1")
        أرجع [0، 0، 0]

    متغير أحمر = إلى_صحيح(لون1_RGB[0] * (1 - نسبة) + لون2_RGB[0] * نسبة)
    متغير أخضر = إلى_صحيح(لون1_RGB[1] * (1 - نسبة) + لون2_RGB[1] * نسبة)
    متغير أزرق = إلى_صحيح(لون1_RGB[2] * (1 - نسبة) + لون2_RGB[2] * نسبة)

    أرجع [أحمر، أخضر، أزرق]

# دالة عكس لون RGB
دالة عكس_RGB(لون_RGB):
    "عكس لون RGB (negative)"
    متغير أحمر = 255 - لون_RGB[0]
    متغير أخضر = 255 - لون_RGB[1]
    متغير أزرق = 255 - لون_RGB[2]
    أرجع [أحمر، أخضر، أزرق]

# دالة تحويل إلى أبيض وأسود
دالة رمادي_RGB(لون_RGB):
    "تحويل لون RGB إلى تدرج رمادي"
    متغير رمادي = إلى_صحيح(سطوع_RGB(لون_RGB))
    أرجع [رمادي، رمادي، رمادي]

