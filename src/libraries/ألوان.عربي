# دالة الوصول إلى لون من لوحة 256 لون
دالة لون_256(رقم_اللون):
    "الوصول إلى لون من لوحة ANSI 256 لون"
    إذا رقم_اللون < 0 أو رقم_اللون > 255:
        رسالة_خطأ("رقم اللون يجب أن يكون بين 0 و 255")
        أرجع أبيض
    أرجع "\033[38;5;" + إلى_نص(رقم_اللون) + "m"

# دالة خلفية من لوحة 256 لون
دالة خلفية_256(رقم_اللون):
    "خلفية من لوحة ANSI 256 لون"
    إذا رقم_اللون < 0 أو رقم_اللون > 255:
        رسالة_خطأ("رقم اللون يجب أن يكون بين 0 و 255")
        أرجع خلفية_بيضاء
    أرجع "\033[48;5;" + إلى_نص(رقم_اللون) + "m"

