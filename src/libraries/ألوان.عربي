# دالة إنشاء تدرج بسيط بين لونين
دالة تدرج_بسيط(لون_البداية_RGB، لون_النهاية_RGB، عدد_الخطوات):
    "إنشاء تدرج بسيط بين لونين"
    متغير تدرج = []

    متغير خطوة_أحمر = (لون_النهاية_RGB[0] - لون_البداية_RGB[0]) / عدد_الخطوات
    متغير خطوة_أخضر = (لون_النهاية_RGB[1] - لون_البداية_RGB[1]) / عدد_الخطوات
    متغير خطوة_أزرق = (لون_النهاية_RGB[2] - لون_البداية_RGB[2]) / عدد_الخطوات

    متغير خطوة = 0
    طالما خطوة <= عدد_الخطوات:
        متغير أحمر_حالي = إلى_صحيح(لون_البداية_RGB[0] + (خطوة_أحمر * خطوة))
        متغير أخضر_حالي = إلى_صحيح(لون_البداية_RGB[1] + (خطوة_أخضر * خطوة))
        متغير أزرق_حالي = إلى_صحيح(لون_البداية_RGB[2] + (خطوة_أزرق * خطوة))

        أضف_إلى_مصفوفة(تدرج، [أحمر_حالي، أخضر_حالي، أزرق_حالي])
        خطوة = خطوة + 1

    أرجع تدرج

# دالة تطبيق تدرج على نص
دالة نص_متدرج(النص، لون_البداية_RGB، لون_النهاية_RGB):
    "تطبيق تدرج على النص حرف بحرف"
    متغير طول_النص = طول_حقيقي(النص)
    متغير تدرج = تدرج_بسيط(لون_البداية_RGB، لون_النهاية_RGB، طول_النص)

    متغير نص_ملون = ""
    متغير فهرس = 0
    طالما فهرس < طول_النص:
        متغير حرف = استخرج_حرف(النص، فهرس)
        متغير لون_ANSI = RGB_إلى_ANSI(تدرج[فهرس])
        نص_ملون = نص_ملون + لون_ANSI + حرف
        فهرس = فهرس + 1

    أرجع نص_ملون + إعادة_تعيين

