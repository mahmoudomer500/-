# محلل بسيط - نسخة مبسطة للاختبار الأولي
# Simple Parser - Simplified version for initial testing

دالة محلل_بسيط(كود_المصدر):
    اطبع("بدء التحليل البسيط")
    اطبع("الكود المصدر:")
    اطبع(كود_المصدر)

    # تحليل بسيط للكلمات
    كلمات = كود_المصدر.قسم(" ")
    اطبع("عدد الكلمات:")
    اطبع(كلمات.طول())

    # إرجاع نتيجة بسيطة
    أرجع كلمات

دالة اختبر_المحلل():
    كود_اختبار = "متغير x = 10 + 20"
    نتيجة = محلل_بسيط(كود_اختبار)

    إذا نتيجة.طول() > 0:
        اطبع("نجح التحليل البسيط")
        أرجع 1
    وإلا:
        اطبع("فشل التحليل البسيط")
        أرجع 0
    نهاية