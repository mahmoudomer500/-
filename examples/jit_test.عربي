    ارجع أ / ب
نهاية

# اختبار الدوال عدة مرات لتصبح شائعة
متغير نتيجة1 = جمع(10, 5)
متغير نتيجة2 = جمع(20, 15)
متغير نتيجة3 = جمع(30, 25)

متغير نتيجة4 = طرح(50, 20)
متغير نتيجة5 = طرح(100, 30)
متغير نتيجة6 = طرح(200, 50)

متغير نتيجة7 = ضرب(5, 4)
متغير نتيجة8 = ضرب(10, 8)
متغير نتيجة9 = ضرب(15, 6)

متغير نتيجة10 = قسمة(100, 5)
متغير نتيجة11 = قسمة(200, 4)
متغير نتيجة12 = قسمة(300, 3)

اطبع "نتائج الاختبار:"
اطبع "جمع: " نتيجة1 " + " نتيجة2 " + " نتيجة3
