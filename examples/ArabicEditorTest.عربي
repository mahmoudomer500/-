# اختبار محرر الكود العربي
# هذا الملف يختبر جميع ميزات محرر الكود العربي

استورد "ArabicCodeEditor.h"

# ────────────────────────────────────────────────────────
# اختبار تمييز الصيغة
# ────────────────────────────────────────────────────────

دالة اختبار_تمييز_الصيغة() {
    اكتب "🎨 اختبار تمييز الصيغة...\n"

    محرر = ArabicCodeEditor()

    # كود اختبار مع جميع العناصر
    كود_اختبار = "دالة رئيسية() {\n"
    كود_اختبار += "    رقم x = 42\n"
    كود_اختبار += "    نص رسالة = \"مرحبا بالعالم\"\n"
    كود_اختبار += "    اكتب(رسالة)\n"
    كود_اختبار += "    اذا x > 10 {\n"
    كود_اختبار += "        اكتب(\"x كبير\")\n"
    كود_اختبار += "    } وإلا {\n"
    كود_اختبار += "        اكتب(\"x صغير\")\n"
    كود_اختبار += "    }\n"
    كود_اختبار += "    // هذا تعليق\n"
    كود_اختبار += "    أعد 0\n"
    كود_اختبار += "}\n"

    محرر.تعيين_النص(كود_اختبار)

    # اختبار التحليل
    أسطر = محرر.احصل_الأسطر()
    اكتب "📊 عدد الأسطر: " + أسطر + "\n"

    أخطاء = محرر.احصل_عدد_الأخطاء()
    اكتب "🔍 عدد الأخطاء المكتشفة: " + أخطاء + "\n"

    اكتب "✅ تم اختبار تمييز الصيغة\n"
}

# ────────────────────────────────────────────────────────
# اختبار الإكمال التلقائي
# ────────────────────────────────────────────────────────

دالة اختبار_الإكمال_التلقائي() {
    اكتب "💡 اختبار الإكمال التلقائي...\n"

    محرر = ArabicCodeEditor()

    # تعيين موقع المؤشر للاختبار
    محرر.تعيين_موقع_المؤشر(0, 4)  # بعد "دالة"

    # محاكاة كتابة
    محرر.إدراج_نص("رئيسي")

    # الحصول على الكلمة الحالية
    كلمة_حالية = محرر.احصل_الكلمة_الحالية()
    اكتب "⌨️ الكلمة الحالية: " + كلمة_حالية + "\n"

    # اختبار الاقتراحات
    # (في التطبيق الحقيقي سيتم عرض قائمة الاقتراحات)

    اكتب "✅ تم اختبار الإكمال التلقائي\n"
}

# ────────────────────────────────────────────────────────
# اختبار البحث والاستبدال
# ────────────────────────────────────────────────────────

دالة اختبار_البحث_والاستبدال() {
    اكتب "🔍 اختبار البحث والاستبدال...\n"

    محرر = ArabicCodeEditor()

    كود_اختبار = "دالة الأولى() {\n    اكتب(\"الأولى\")\n}\n"
    كود_اختبار += "دالة الثانية() {\n    اكتب(\"الثانية\")\n}\n"
    كود_اختبار += "دالة الأولى() {\n    اكتب(\"تكرار\")\n}\n"

    محرر.تعيين_النص(كود_اختبار)

    # البحث عن "الأولى"
    بحث = ArabicSearchReplace()
    بحث.تعيين_معايير_البحث("الأولى", خطأ, خطأ, خطأ)
    بحث.تعيين_نص_الاستبدال("الأساسية")

    نتائج = بحث.بحث_في_النص(كود_اختبار)
    اكتب "📊 عدد التطابقات الموجودة: " + نتائج.الحجم() + "\n"

    # استبدال الكل
    نص_جديد = بحث.استبدال_الكل(كود_اختبار)
    محرر.تعيين_النص(نص_جديد)

    اكتب "✅ تم اختبار البحث والاستبدال\n"
}

# ────────────────────────────────────────────────────────
# اختبار تحليل الأخطاء
# ────────────────────────────────────────────────────────

دالة اختبار_تحليل_الأخطاء() {
    اكتب "🔧 اختبار تحليل الأخطاء...\n"

    محرر = ArabicCodeEditor()

    # كود يحتوي على أخطاء
    كود_خاطئ = "دالة رئيسية() {\n"
    كود_خاطئ += "    رقم x = 42\n"
    كود_خاطئ += "    نص رسالة = \"مرحبا غير مغلق\n"
    كود_خاطئ += "    اكتب(رسالة\n"
    كود_خاطئ += "    اذا x > 10 {\n"
    كود_خاطئ += "        اكتب(\"حسن\")\n"
    كود_خاطئ += "    // بدون إغلاق\n"
    كود_خاطئ += "    أعد x\n"
    كود_خاطئ += "}\n"

    محرر.تعيين_النص(كود_خاطئ)

    أخطاء = محرر.احصل_عدد_الأخطاء()
    اكتب "🚨 عدد الأخطاء المكتشفة: " + أخطاء + "\n"

    # عرض تفاصيل الأخطاء
    لكل خطأ في محرر.احصل_الأخطاء() {
        اكتب "   - السطر " + خطأ.سطر + ": " + خطأ.رسالة + "\n"
    }

    اكتب "✅ تم اختبار تحليل الأخطاء\n"
}

# ────────────────────────────────────────────────────────
# اختبار الحفظ والتحميل
# ────────────────────────────────────────────────────────

دالة اختبار_الحفظ_والتحميل() {
    اكتب "💾 اختبار الحفظ والتحميل...\n"

    محرر = ArabicCodeEditor()

    # إنشاء ملف جديد
    محرر.ملف_جديد()

    # إضافة كود
    كود = "# ملف اختبار\n"
    كود += "دالة مرحبا() {\n"
    كود += "    اكتب(\"مرحبا بالعالم!\")\n"
    كود += "    أعد صحيح\n"
    كود += "}\n"

    محرر.تعيين_النص(كود)

    # حفظ الملف
    مسار_الملف = "test_code.عربي"
    اذا محرر.حفظ_الملف(مسار_الملف) {
        اكتب "✅ تم حفظ الملف: " + مسار_الملف + "\n"
    } وإلا {
        اكتب "❌ فشل في حفظ الملف\n"
        أعد
    }

    # تحميل الملف في محرر جديد
    محرر2 = ArabicCodeEditor()
    اذا محرر2.تحميل_الملف(مسار_الملف) {
        نص_محمل = محرر2.احصل_النص()
        اذا نص_محمل == كود {
            اكتب "✅ تم تحميل الملف وتطابق المحتوى\n"
        } وإلا {
            اكتب "❌ المحتوى المحمل لا يتطابق\n"
        }
    } وإلا {
        اكتب "❌ فشل في تحميل الملف\n"
    }

    اكتب "✅ تم اختبار الحفظ والتحميل\n"
}

# ────────────────────────────────────────────────────────
# اختبار تشغيل الكود
# ────────────────────────────────────────────────────────

دالة اختبار_تشغيل_الكود() {
    اكتب "🚀 اختبار تشغيل الكود...\n"

    محرر = ArabicCodeEditor()

    # كود بسيط للاختبار
    كود = "دالة رئيسية() {\n"
    كود += "    رقم x = 10\n"
    كود += "    رقم y = 20\n"
    كود += "    رقم مجموع = x + y\n"
    كود += "    اكتب(\"المجموع = \" + مجموع)\n"
    كود += "    أعد 0\n"
    كود += "}\n"

    محرر.تعيين_النص(كود)

    # حفظ وتشغيل
    مسار_الاختبار = "run_test.عربي"
    اذا محرر.حفظ_الملف(مسار_الاختبار) {
        اكتب "📄 تم حفظ ملف الاختبار\n"

        # تشغيل الكود (في التطبيق الحقيقي)
        # محرر.شغل_الكود()
        اكتب "▶️ سيتم تشغيل الكود عبر المترجم الخارجي\n"

    } وإلا {
        اكتب "❌ فشل في حفظ ملف الاختبار\n"
    }

    اكتب "✅ تم اختبار تشغيل الكود\n"
}

# ────────────────────────────────────────────────────────
# الدالة الرئيسية للاختبار
# ────────────────────────────────────────────────────────

دالة رئيسية() {
    اكتب "🎯 بدء اختبار محرر الكود العربي\n"
    اكتب "=" * 60 + "\n"

    # اختبار جميع الميزات
    اختبار_تمييز_الصيغة()
    اكتب "\n"

    اختبار_الإكمال_التلقائي()
    اكتب "\n"

    اختبار_البحث_والاستبدال()
    اكتب "\n"

    اختبار_تحليل_الأخطاء()
    اكتب "\n"

    اختبار_الحفظ_والتحميل()
    اكتب "\n"

    اختبار_تشغيل_الكود()
    اكتب "\n"

    اكتب "=" * 60 + "\n"
    اكتب "🎉 انتهى جميع اختبارات محرر الكود العربي!\n"
    اكتب "📈 تم اختبار:\n"
    اكتب "   1. تمييز الصيغة للغة العربية\n"
    اكتب "   2. الإكمال التلقائي الذكي\n"
    اكتب "   3. البحث والاستبدال المتقدم\n"
    اكتب "   4. تحليل وتصحيح الأخطاء\n"
    اكتب "   5. الحفظ والتحميل للملفات\n"
    اكتب "   6. تشغيل الكود مباشرة\n"
    اكتب "   7. واجهة مستخدم شاملة\n"

    أعد 0
}
