دالة رئيسية():
    اطبع("🚀 المترجم العربي الأولي - Bootstrap Compiler")
    اطبع("════════════════════════════════════════════════")
    اطبع("")
    
    # كود تجريبي
    كود_مصدر = "
        متغير س = 42
        متغير ص = 100
        اطبع(س)
        اطبع(ص)
    "
    
    # المرحلة 1: التحليل اللغوي
    اطبع("📖 المرحلة 1: التحليل اللغوي...")
    محلل = جديد محلل_لغوي(كود_مصدر)
    رموز = محلل.حلل()
    اطبع("   ✅ تم تحليل " + طول(رموز) + " رمز")
    
    # المرحلة 2: التحليل النحوي
    اطبع("")
    اطبع("🌳 المرحلة 2: التحليل النحوي...")
    محلل_نحوي = جديد محلل_نحوي(رموز)
    أوامر = محلل_نحوي.حلل()
    اطبع("   ✅ تم تحليل " + طول(أوامر) + " أمر")
    
    # المرحلة 3: توليد Assembly
    اطبع("")
    اطبع("⚙️  المرحلة 3: توليد Assembly...")
    مولد = جديد مولد_assembly()
    كود_assembly = مولد.ولّد(أوامر)
    اطبع("   ✅ تم توليد " + طول(كود_assembly) + " سطر")
    
    # حفظ
    اطبع("")
    اطبع("💾 حفظ الملف: output.asm")
    ملف = افتح("output.asm", "كتابة")
    ملف.اكتب(كود_assembly)
    ملف.أغلق()
    
    اطبع("")
    اطبع("✅ اكتملت الترجمة بنجاح!")

