# ═══════════════════════════════════════════════════════════
# 📦 الهياكل الأساسية
# ═══════════════════════════════════════════════════════════

صنف رمز:
    خاصية نوع = ""
    خاصية قيمة = ""
    خاصية رقم_السطر = 0
    
    دالة بناء(نوع، قيمة، رقم_سطر):
        هذا.نوع = نوع
        هذا.قيمة = قيمة
        هذا.رقم_السطر = رقم_سطر

صنف أمر:
    خاصية نوع_الأمر = ""
    خاصية متغير = ""
    خاصية قيمة = فارغ
    خاصية شرط = فارغ
    خاصية جسم = []
    خاصية بديل = []
    
    دالة بناء(نوع):
        هذا.نوع_الأمر = نوع

# ═══════════════════════════════════════════════════════════
# 🔍 المحلل اللغوي (Lexer)
# ═══════════════════════════════════════════════════════════

صنف محلل_لغوي:
    خاصية كود = ""
    خاصية موضع = 0
    خاصية سطر = 1
    خاصية رموز = []
    
    دالة بناء(كود_المصدر):
        هذا.كود = كود_المصدر
        هذا.موضع = 0
        هذا.سطر = 1
    
    دالة حلل():
        طالما هذا.موضع < طول(هذا.كود):
            حرف = هذا.كود[هذا.موضع]
            
            # تجاهل المسافات
            إذا حرف == ' ' أو حرف == '\t':
                هذا.موضع = هذا.موضع + 1
                استمر
            
            # سطر جديد
            إذا حرف == '\n':
                هذا.سطر = هذا.سطر + 1
                هذا.موضع = هذا.موضع + 1
                استمر
            
            # تعليق
            إذا حرف == '#':
                طالما هذا.موضع < طول(هذا.كود) و هذا.كود[هذا.موضع] != '\n':
                    هذا.موضع = هذا.موضع + 1
                استمر
            
            # رقم
            إذا حرف >= '0' و حرف <= '9':
                رقم = هذا.اقرأ_رقم()
                هذا.رموز.أضف(جديد رمز("رقم", رقم، هذا.سطر))
                استمر
            
            # نص
            إذا حرف == '"':
                نص = هذا.اقرأ_نص()
                هذا.رموز.أضف(جديد رمز("نص", نص، هذا.سطر))
                استمر
            
            # معرّف أو كلمة محجوزة
            إذا هذا.هو_حرف_عربي(حرف):
                معرف = هذا.اقرأ_معرف()
                نوع = هذا.حدد_نوع(معرف)
                هذا.رموز.أضف(جديد رمز(نوع، معرف، هذا.سطر))
                استمر
            
            # معاملات
            إذا حرف == '=' أو حرف == '+' أو حرف == '-' أو حرف == '*' أو حرف == '/':
                هذا.رموز.أضف(جديد رمز("معامل", حرف، هذا.سطر))
                هذا.موضع = هذا.موضع + 1
                استمر
            
            # أقواس
            إذا حرف == '(' أو حرف == ')' أو حرف == ':':
                هذا.رموز.أضف(جديد رمز("رمز", حرف، هذا.سطر))
                هذا.موضع = هذا.موضع + 1
                استمر
            
            # حرف غير معروف
            هذا.موضع = هذا.موضع + 1
        
        أرجع هذا.رموز
    
    دالة اقرأ_رقم():
        بداية = هذا.موضع
        طالما هذا.موضع < طول(هذا.كود):
            حرف = هذا.كود[هذا.موضع]
            إذا حرف < '0' أو حرف > '9':
                اقطع
            هذا.موضع = هذا.موضع + 1
        أرجع هذا.كود[بداية : هذا.موضع]
    
    دالة اقرأ_نص():
        هذا.موضع = هذا.موضع + 1  # تخطي "
        بداية = هذا.موضع
        طالما هذا.موضع < طول(هذا.كود) و هذا.كود[هذا.موضع] != '"':
            هذا.موضع = هذا.موضع + 1
        نص = هذا.كود[بداية : هذا.موضع]
        هذا.موضع = هذا.موضع + 1  # تخطي "
        أرجع نص
    
    دالة اقرأ_معرف():
        بداية = هذا.موضع
        طالما هذا.موضع < طول(هذا.كود):
            حرف = هذا.كود[هذا.موضع]
            إذا لا هذا.هو_حرف_عربي(حرف) و لا (حرف >= '0' و حرف <= '9') و حرف != '_':
                اقطع
            هذا.موضع = هذا.موضع + 1
        أرجع هذا.كود[بداية : هذا.موضع]
    
    دالة هو_حرف_عربي(حرف):
        كود = رمز_الحرف(حرف)
        أرجع كود >= 0x0600 و كود <= 0x06FF
    
    دالة حدد_نوع(معرف):
        كلمات_محجوزة = ["صنف", "خاصية", "دالة", "إذا", "وإلا", "طالما", "أرجع", "اطبع", "جديد", "هذا"]
        إذا معرف في كلمات_محجوزة:
            أرجع "كلمة_محجوزة"
        أرجع "معرّف"

# ═══════════════════════════════════════════════════════════
# 🌳 المحلل النحوي (Parser)
# ═══════════════════════════════════════════════════════════

صنف محلل_نحوي:
    خاصية رموز = []
    خاصية موضع = 0
    خاصية أوامر = []
    
    دالة بناء(قائمة_رموز):
        هذا.رموز = قائمة_رموز
        هذا.موضع = 0
    
    دالة حلل():
        طالما هذا.موضع < طول(هذا.رموز):
            أمر = هذا.حلل_أمر()
            إذا أمر != فارغ:
                هذا.أوامر.أضف(أمر)
        أرجع هذا.أوامر
    
    دالة حلل_أمر():
        رمز_حالي = هذا.رموز[هذا.موضع]
        
        # تعيين
        إذا رمز_حالي.نوع == "معرّف":
            أرجع هذا.حلل_تعيين()
        
        # اطبع
        إذا رمز_حالي.قيمة == "اطبع":
            أرجع هذا.حلل_طباعة()
        
        # إذا
        إذا رمز_حالي.قيمة == "إذا":
            أرجع هذا.حلل_شرط()
        
        # طالما
        إذا رمز_حالي.قيمة == "طالما":
            أرجع هذا.حلل_حلقة()
        
        هذا.موضع = هذا.موضع + 1
        أرجع فارغ
    
    دالة حلل_تعيين():
        متغير = هذا.رموز[هذا.موضع].قيمة
        هذا.موضع = هذا.موضع + 1
        
        # تخطي =
        إذا هذا.رموز[هذا.موضع].قيمة == "=":
            هذا.موضع = هذا.موضع + 1
        
        قيمة = هذا.حلل_تعبير()
        
        أمر = جديد أمر("تعيين")
        أمر.متغير = متغير
        أمر.قيمة = قيمة
        أرجع أمر
    
    دالة حلل_طباعة():
        هذا.موضع = هذا.موضع + 1  # تخطي "اطبع"
        هذا.موضع = هذا.موضع + 1  # تخطي "("
        
        قيمة = هذا.حلل_تعبير()
        
        هذا.موضع = هذا.موضع + 1  # تخطي ")"
        
        أمر = جديد أمر("طباعة")
        أمر.قيمة = قيمة
        أرجع أمر
    
    دالة حلل_شرط():
        هذا.موضع = هذا.موضع + 1  # تخطي "إذا"
        شرط = هذا.حلل_تعبير()
        هذا.موضع = هذا.موضع + 1  # تخطي ":"
        
        أمر = جديد أمر("شرط")
        أمر.شرط = شرط
        أرجع أمر
    
    دالة حلل_تعبير():
        رمز = هذا.رموز[هذا.موضع]
        هذا.موضع = هذا.موضع + 1
        أرجع رمز.قيمة

# ═══════════════════════════════════════════════════════════
# ⚙️ مولّد Assembly
# ═══════════════════════════════════════════════════════════

صنف مولد_assembly:
    خاصية كود = []
    خاصية متغيرات = {}
    
    دالة ولّد(أوامر):
        # هيكل PE الأساسي
        هذا.كود.أضف("section .data")
        هذا.كود.أضف("    msg_format db '%s', 10, 0")
        هذا.كود.أضف("    int_format db '%d', 10, 0")
        هذا.كود.أضف("")
        
        # إضافة المتغيرات
        لكل أمر في أوامر:
            إذا أمر.نوع_الأمر == "تعيين":
                إذا أمر.متغير ليس في هذا.متغيرات:
                    هذا.كود.أضف("    var_" + أمر.متغير + " dd 0")
                    هذا.متغيرات[أمر.متغير] = صحيح
        
        هذا.كود.أضف("")
        هذا.كود.أضف("section .text")
        هذا.كود.أضف("global main")
        هذا.كود.أضف("extern printf")
        هذا.كود.أضف("extern exit")
        هذا.كود.أضف("")
        هذا.كود.أضف("main:")
        هذا.كود.أضف("    push rbp")
        هذا.كود.أضف("    mov rbp, rsp")
        هذا.كود.أضف("")
        
        # توليد الأوامر
        لكل أمر في أوامر:
            هذا.ولد_أمر(أمر)
        
        # الخروج
        هذا.كود.أضف("")
        هذا.كود.أضف("    mov ecx, 0")
        هذا.كود.أضف("    call exit")
        
        أرجع "\n".اربط(هذا.كود)
    
    دالة ولد_أمر(أمر):
        إذا أمر.نوع_الأمر == "تعيين":
            هذا.كود.أضف("    mov eax, " + أمر.قيمة)
            هذا.كود.أضف("    mov [var_" + أمر.متغير + "], eax")
        
        وإلا إذا أمر.نوع_الأمر == "طباعة":
            هذا.كود.أضف("    lea rcx, [int_format]")
            هذا.كود.أضف("    mov edx, [var_" + أمر.قيمة + "]")
            هذا.كود.أضف("    call printf")

