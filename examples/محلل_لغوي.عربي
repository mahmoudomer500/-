# محلل_لغوي.عربي
# المحلل اللغوي (Lexer) للغة البرمجة العربية
# يقوم بتحويل النص المصدري إلى رموز (Tokens)

# ═══════════════════════════════════════════════════════════
# أنواع الرموز (Token Types)
# ═══════════════════════════════════════════════════════════

صف نوع_الرمز:
    عام:
        # الكلمات المفتاحية
        نص كلمة_مفتاحية = "كلمة_مفتاحية"
        نص معرف = "معرف"
        نص رقم = "رقم"
        نص نص_حرفي = "نص_حرفي"
        
        # العمليات
        نص عملية_جمع = "+"
        نص عملية_طرح = "-"
        نص عملية_ضرب = "*"
        نص عملية_قسمة = "/"
        نص عملية_باقي = "%"
        
        # المقارنات
        نص يساوي = "=="
        نص لا_يساوي = "!="
        نص أكبر_من = ">"
        نص أصغر_من = "<"
        نص أكبر_أو_يساوي = ">="
        نص أصغر_أو_يساوي = "<="
        
        # العمليات المنطقية
        نص و = "و"
        نص أو = "أو"
        نص ليس = "ليس"
        
        # الأقواس والفواصل
        نص قوس_فتح = "("
        نص قوس_إغلاق = ")"
        نص قوس_مربع_فتح = "["
        نص قوس_مربع_إغلاق = "]"
        نص قوس_معقوف_فتح = "{"
        نص قوس_معقوف_إغلاق = "}"
        نص فاصلة = "،"
        نص نقطة = "."
        نص نقطتان = ":"
        
        # الإسناد
        نص إسناد = "="
        
        # نهاية السطر ونهاية الملف
        نص نهاية_سطر = "نهاية_سطر"
        نص نهاية_ملف = "نهاية_ملف"

# ═══════════════════════════════════════════════════════════
# بنية الرمز (Token Structure)
# ═══════════════════════════════════════════════════════════

صف رمز:
    عام:
        نص النوع
        نص القيمة
        رقم رقم_السطر
        رقم رقم_العمود
        
        دالة جديد(نوع، قيمة، سطر، عمود):
            هذا.النوع = نوع
            هذا.القيمة = قيمة
            هذا.رقم_السطر = سطر
            هذا.رقم_العمود = عمود
        
        دالة اطبع():
            اطبع("رمز: " + هذا.النوع + " = '" + هذا.القيمة + "' [" + هذا.رقم_السطر + ":" + هذا.رقم_العمود + "]")

# ═══════════════════════════════════════════════════════════
# المحلل اللغوي (Lexer)
# ═══════════════════════════════════════════════════════════

صف محلل_لغوي:
    خاص:
        نص النص_المصدري
        رقم الموضع_الحالي
        رقم رقم_السطر_الحالي
        رقم رقم_العمود_الحالي
        مصفوفة الكلمات_المفتاحية
    
    عام:
        دالة جديد(نص_مصدري):
            هذا.النص_المصدري = نص_مصدري
            هذا.الموضع_الحالي = 0
            هذا.رقم_السطر_الحالي = 1
            هذا.رقم_العمود_الحالي = 1
            
            # تعريف الكلمات المفتاحية
            هذا.الكلمات_المفتاحية = [
                "اطبع"، "متغير"، "دالة"، "أرجع"، "إذا"، "وإلا"،
                "بينما"، "لكل"، "من"، "إلى"، "صف"، "جديد"،
                "خاص"، "عام"، "محمي"، "استورد"، "صحيح"، "خطأ"،
                "و"، "أو"، "ليس"، "في"، "مصفوفة"، "نص"، "رقم"،
                "افتح_ملف"، "اقرأ_ملف"، "اكتب_ملف"، "أغلق_ملف"،
                "توقف"، "استمر"، "انتظر"
            ]
        
        # الحصول على الحرف الحالي
        دالة حرف_حالي():
            إذا هذا.الموضع_الحالي >= طول(هذا.النص_المصدري):
                أرجع ""
            أرجع هذا.النص_المصدري[هذا.الموضع_الحالي]
        
        # التقدم للحرف التالي
        دالة تقدم():
            إذا هذا.الموضع_الحالي < طول(هذا.النص_المصدري):
                إذا هذا.حرف_حالي() == "\n":
                    هذا.رقم_السطر_الحالي = هذا.رقم_السطر_الحالي + 1
                    هذا.رقم_العمود_الحالي = 1
                وإلا:
                    هذا.رقم_العمود_الحالي = هذا.رقم_العمود_الحالي + 1
                
                هذا.الموضع_الحالي = هذا.الموضع_الحالي + 1
        
        # النظر للحرف التالي دون التقدم
        دالة حرف_تالي():
            إذا هذا.الموضع_الحالي + 1 >= طول(هذا.النص_المصدري):
                أرجع ""
            أرجع هذا.النص_المصدري[هذا.الموضع_الحالي + 1]
        
        # تخطي المسافات البيضاء
        دالة تخطى_مسافات():
            بينما هذا.حرف_حالي() == " " أو هذا.حرف_حالي() == "\t" أو هذا.حرف_حالي() == "\r":
                هذا.تقدم()
        
        # تخطي التعليقات
        دالة تخطى_تعليق():
            إذا هذا.حرف_حالي() == "#":
                بينما هذا.حرف_حالي() != "\n" و هذا.حرف_حالي() != "":
                    هذا.تقدم()
                أرجع صحيح
            أرجع خطأ
        
        # قراءة معرف أو كلمة مفتاحية
        دالة اقرأ_معرف():
            متغير بداية_السطر = هذا.رقم_السطر_الحالي
            متغير بداية_العمود = هذا.رقم_العمود_الحالي
            متغير نص_المعرف = ""
            
            بينما هذا.هو_حرف_عربي(هذا.حرف_حالي()) أو هذا.هو_رقم(هذا.حرف_حالي()) أو هذا.حرف_حالي() == "_":
                نص_المعرف = نص_المعرف + هذا.حرف_حالي()
                هذا.تقدم()
            
            # التحقق إذا كانت كلمة مفتاحية
            إذا نص_المعرف في هذا.الكلمات_المفتاحية:
                أرجع رمز.جديد("كلمة_مفتاحية"، نص_المعرف، بداية_السطر، بداية_العمود)
            
            أرجع رمز.جديد("معرف"، نص_المعرف، بداية_السطر، بداية_العمود)
        
        # قراءة رقم
        دالة اقرأ_رقم():
            متغير بداية_السطر = هذا.رقم_السطر_الحالي
            متغير بداية_العمود = هذا.رقم_العمود_الحالي
            متغير نص_الرقم = ""
            متغير يحتوي_نقطة = خطأ
            
            بينما هذا.هو_رقم(هذا.حرف_حالي()) أو (هذا.حرف_حالي() == "." و ليس يحتوي_نقطة):
                إذا هذا.حرف_حالي() == ".":
                    يحتوي_نقطة = صحيح
                نص_الرقم = نص_الرقم + هذا.حرف_حالي()
                هذا.تقدم()
            
            أرجع رمز.جديد("رقم"، نص_الرقم، بداية_السطر، بداية_العمود)
        
        # قراءة نص حرفي (بين علامات تنصيص)
        دالة اقرأ_نص():
            متغير بداية_السطر = هذا.رقم_السطر_الحالي
            متغير بداية_العمود = هذا.رقم_العمود_الحالي
            متغير علامة_البداية = هذا.حرف_حالي()
            متغير نص_القيمة = ""
            
            هذا.تقدم()  # تخطي علامة التنصيص الأولى
            
            بينما هذا.حرف_حالي() != علامة_البداية و هذا.حرف_حالي() != "":
                إذا هذا.حرف_حالي() == "\\":
                    هذا.تقدم()
                    # معالجة الأحرف الخاصة
                    إذا هذا.حرف_حالي() == "n":
                        نص_القيمة = نص_القيمة + "\n"
                    وإلا إذا هذا.حرف_حالي() == "t":
                        نص_القيمة = نص_القيمة + "\t"
                    وإلا إذا هذا.حرف_حالي() == "\\":
                        نص_القيمة = نص_القيمة + "\\"
                    وإلا إذا هذا.حرف_حالي() == "\"":
                        نص_القيمة = نص_القيمة + "\""
                    وإلا:
                        نص_القيمة = نص_القيمة + هذا.حرف_حالي()
                    هذا.تقدم()
                وإلا:
                    نص_القيمة = نص_القيمة + هذا.حرف_حالي()
                    هذا.تقدم()
            
            إذا هذا.حرف_حالي() == علامة_البداية:
                هذا.تقدم()  # تخطي علامة التنصيص الأخيرة
            
            أرجع رمز.جديد("نص_حرفي"، نص_القيمة، بداية_السطر، بداية_العمود)
        
        # التحقق من كون الحرف عربياً
        دالة هو_حرف_عربي(حرف):
            إذا حرف == "":
                أرجع خطأ
            متغير كود = كود_الحرف(حرف)
            أرجع (كود >= 0x0600 و كود <= 0x06FF) أو (كود >= 0x0750 و كود <= 0x077F)
        
        # التحقق من كون الحرف رقماً
        دالة هو_رقم(حرف):
            إذا حرف == "":
                أرجع خطأ
            أرجع حرف >= "0" و حرف <= "9"
        
        # الحصول على الرمز التالي
        دالة رمز_تالي():
            # تخطي المسافات والتعليقات
            بينما صحيح:
                هذا.تخطى_مسافات()
                إذا ليس هذا.تخطى_تعليق():
                    توقف
            
            # نهاية الملف
            إذا هذا.حرف_حالي() == "":
                أرجع رمز.جديد("نهاية_ملف"، ""، هذا.رقم_السطر_الحالي، هذا.رقم_العمود_الحالي)
            
            متغير حرف = هذا.حرف_حالي()
            متغير سطر = هذا.رقم_السطر_الحالي
            متغير عمود = هذا.رقم_العمود_الحالي
            
            # نهاية السطر
            إذا حرف == "\n":
                هذا.تقدم()
                أرجع رمز.جديد("نهاية_سطر"، "\n"، سطر، عمود)
            
            # نص حرفي
            إذا حرف == "\"" أو حرف == "'":
                أرجع هذا.اقرأ_نص()
            
            # رقم
            إذا هذا.هو_رقم(حرف):
                أرجع هذا.اقرأ_رقم()
            
            # معرف أو كلمة مفتاحية
            إذا هذا.هو_حرف_عربي(حرف) أو حرف == "_":
                أرجع هذا.اقرأ_معرف()
            
            # عمليات من حرفين
            إذا حرف == "=" و هذا.حرف_تالي() == "=":
                هذا.تقدم()
                هذا.تقدم()
                أرجع رمز.جديد("=="، "=="، سطر، عمود)
            
            إذا حرف == "!" و هذا.حرف_تالي() == "=":
                هذا.تقدم()
                هذا.تقدم()
                أرجع رمز.جديد("!="، "!="، سطر، عمود)
            
            إذا حرف == ">" و هذا.حرف_تالي() == "=":
                هذا.تقدم()
                هذا.تقدم()
                أرجع رمز.جديد(">="، ">="، سطر، عمود)
            
            إذا حرف == "<" و هذا.حرف_تالي() == "=":
                هذا.تقدم()
                هذا.تقدم()
                أرجع رمز.جديد("<="، "<="، سطر، عمود)
            
            # عمليات من حرف واحد
            إذا حرف == "+":
                هذا.تقدم()
                أرجع رمز.جديد("+"، "+"، سطر، عمود)
            
            إذا حرف == "-":
                هذا.تقدم()
                أرجع رمز.جديد("-"، "-"، سطر، عمود)
            
            إذا حرف == "*":
                هذا.تقدم()
                أرجع رمز.جديد("*"، "*"، سطر، عمود)
            
            إذا حرف == "/":
                هذا.تقدم()
                أرجع رمز.جديد("/"، "/"، سطر، عمود)
            
            إذا حرف == "%":
                هذا.تقدم()
                أرجع رمز.جديد("%"، "%"، سطر، عمود)
            
            إذا حرف == "=":
                هذا.تقدم()
                أرجع رمز.جديد("="، "="، سطر، عمود)
            
            إذا حرف == ">":
                هذا.تقدم()
                أرجع رمز.جديد(">"، ">"، سطر، عمود)
            
            إذا حرف == "<":
                هذا.تقدم()
                أرجع رمز.جديد("<"، "<"، سطر، عمود)
            
            إذا حرف == "(":
                هذا.تقدم()
                أرجع رمز.جديد("("، "("، سطر، عمود)
            
            إذا حرف == ")":
                هذا.تقدم()
                أرجع رمز.جديد(")"، ")"، سطر، عمود)
            
            إذا حرف == "[":
                هذا.تقدم()
                أرجع رمز.جديد("["، "["، سطر، عمود)
            
            إذا حرف == "]":
                هذا.تقدم()
                أرجع رمز.جديد("]"، "]"، سطر، عمود)
            
            إذا حرف == "{":
                هذا.تقدم()
                أرجع رمز.جديد("{"، "{"، سطر، عمود)
            
            إذا حرف == "}":
                هذا.تقدم()
                أرجع رمز.جديد("}"، "}"، سطر، عمود)
            
            إذا حرف == "،" أو حرف == ",":
                هذا.تقدم()
                أرجع رمز.جديد("،"، "،"، سطر، عمود)
            
            إذا حرف == ".":
                هذا.تقدم()
                أرجع رمز.جديد("."، "."، سطر، عمود)
            
            إذا حرف == ":":
                هذا.تقدم()
                أرجع رمز.جديد(":"، ":"، سطر، عمود)
            
            # حرف غير معروف
            اطبع("خطأ: حرف غير معروف '" + حرف + "' في السطر " + سطر + " العمود " + عمود)
            هذا.تقدم()
            أرجع هذا.رمز_تالي()
        
        # تحليل كامل النص وإرجاع قائمة الرموز
        دالة حلل():
            مصفوفة الرموز = []
            
            بينما صحيح:
                متغير رمز_حالي = هذا.رمز_تالي()
                الرموز.أضف(رمز_حالي)
                
                إذا رمز_حالي.النوع == "نهاية_ملف":
                    توقف
            
            أرجع الرموز

# ═══════════════════════════════════════════════════════════
# دالة اختبار المحلل اللغوي
# ═══════════════════════════════════════════════════════════

دالة اختبر_محلل_لغوي():
    متغير كود_اختبار = "
    # برنامج اختبار بسيط
    متغير العدد = 42
    متغير الاسم = \"محمد\"
    
    إذا العدد > 10:
        اطبع(\"العدد كبير\")
    
    دالة جمع(أ، ب):
        أرجع أ + ب
    
    متغير النتيجة = جمع(5، 3)
    اطبع(النتيجة)
    "
    
    متغير محلل = محلل_لغوي.جديد(كود_اختبار)
    متغير الرموز = محلل.حلل()
    
    اطبع("═══════════════════════════════════════")
    اطبع("نتائج التحليل اللغوي:")
    اطبع("═══════════════════════════════════════")
    
    لكل رمز في الرموز:
        إذا رمز.النوع != "نهاية_سطر":
            رمز.اطبع()
    
    اطبع("═══════════════════════════════════════")
    اطبع("عدد الرموز: " + طول(الرموز))
    اطبع("═══════════════════════════════════════")

# تشغيل اختبار مبسط بدون استيراد خارجي
اطبع("╔════════════════════════════════════════╗")
اطبع("║    المحلل اللغوي العربي — تحميل ناجح  ║")
اطبع("╚════════════════════════════════════════╝")

متغير م = محلل_لغوي.جديد("اطبع(\"مرحباً\")")
اطبع("✅ تم إنشاء محلل لغوي بنجاح")
متغير الرموز = م.حلل()
