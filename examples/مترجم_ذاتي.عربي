            اطبع("─────────────────────────────")
            اطبع("(يستخدم مولد_كود.عربي)")
            اطبع("✅ اكتمل توليد الكود")
            أرجع 1
        
        # العملية الكاملة
        دالة ترجم():
            اطبع("═══════════════════════════════════════════════")
            اطبع("        بدء عملية الترجمة الذاتية")
            اطبع("═══════════════════════════════════════════════")
            
