        دالة جديد(كود_مصدري، ملف):
            هذا.الكود_المصدري = كود_مصدري
            هذا.اسم_الملف = ملف
            هذا.الرموز = []
            هذا.أشجار_التحليل = []
            هذا.التعليمات_المولدة = []
