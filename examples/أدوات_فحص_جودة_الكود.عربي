# ═══════════════════════════════════════════════════════════
# 🔍 أدوات فحص جودة الكود والتحليل المتقدم - الإصدار 1.0
# ═══════════════════════════════════════════════════════════
# وصف: أدوات شاملة لفحص وتحليل جودة الكود مع اقتراحات التحسين
# الميزات: تحليل بناء الجملة، قياس التعقيد، فحص الأمان، كشف الروائح البرمجية
# ═══════════════════════════════════════════════════════════

صف أدوات_فحص_جودة_الكود:
    خاص:
        معايير_الجودة
        قواعد_التحليل
        نتائج_الفحص
        إعدادات_الفحص
        إحصائيات_الجودة

    عام:
        # ────────────────────────────────────────────────────────
        # 1️⃣  دالة التهيئة والإعداد
        # ────────────────────────────────────────────────────────

        دالة جديد():
            "تهيئة أدوات فحص جودة الكود"
            هذا.معايير_الجودة = {}
            هذا.قواعد_التحليل = {}
            هذا.نتائج_الفحص = {}
            هذا.إعدادات_الفحص = {
                "فحص_شامل": صحيح,
                "تحليل_تعقيد": صحيح,
                "فحص_أمان": صحيح,
                "كشف_روائح": صحيح,
                "اقتراحات_تحسين": صحيح,
                "تقارير_مفصلة": صحيح
            }
            هذا.إحصائيات_الجودة = {
                "ملفات_محللة": 0,
                "أخطاء_مكتشفة": 0,
                "تحذيرات_مكتشفة": 0,
                "اقتراحات_مقدمة": 0,
                "درجة_الجودة_الكلية": 0
            }
            هذا.تهيئة_معايير_الجودة()
            هذا.تهيئة_قواعد_التحليل()

        دالة تهيئة_معايير_الجودة():
            "تهيئة معايير جودة الكود"
            # معايير بناء الجملة
            هذا.معايير_الجودة["بناء_الجملة"] = {
                "الحد_الأدنى": 8,
                "الحد_المطلوب": 9,
                "العقوبات": {
                    "خطأ_تركيبي": -2,
                    "إغلاق_غير_متوازن": -1,
                    "مسافة_خاطئة": -0.5
                }
            }

            # معايير التعقيد الحسابي
            هذا.معايير_الجودة["التعقيد_الحسابي"] = {
                "الحد_الأدنى": 7,
                "الحد_المطلوب": 8,
                "العقوبات": {
                    "دالة_معقدة_جداً": -3,
                    "حلقة_متداخلة_عمق": -1,
                    "شروط_معقدة": -1
                }
            }

            # معايير الأسلوب
            هذا.معايير_الجودة["الأسلوب"] = {
                "الحد_الأدنى": 6,
                "الحد_المطلوب": 8,
                "العقوبات": {
                    "اسم_غير_واضح": -1,
                    "تعليق_مفقود": -1,
                    "كود_مكرر": -2
                }
            }

            # معايير الأمان
            هذا.معايير_الجودة["الأمان"] = {
                "الحد_الأدنى": 9,
                "الحد_المطلوب": 9.5,
                "العقوبات": {
                    "ثغرة_أمنية_خطيرة": -5,
                    "مدخلات_غير_محققة": -2,
                    "تشفير_ضعيف": -3
                }
            }

        دالة تهيئة_قواعد_التحليل():
            "تهيئة قواعد تحليل الكود"
            # قواعد بناء الجملة
            هذا.قواعد_التحليل["بناء_الجملة"] = {
                "أقواس_متوازنة": "فحص_الأقواس_المتوازنة",
                "نهاية_الجمل": "فحص_نهاية_الجمل",
                "مسافات_صحيحة": "فحص_المسافات"
            }

            # قواعد التعقيد
            هذا.قواعد_التحليل["التعقيد"] = {
                "عمق_التداخل": "قياس_عمق_التداخل",
                "عدد_المعاملات": "قياس_عدد_المعاملات",
                "طول_الدالة": "قياس_طول_الدالة"
            }

            # قواعد الأسلوب
            هذا.قواعد_التحليل["الأسلوب"] = {
                "تسمية_المتغيرات": "فحص_تسمية_المتغيرات",
                "تعليقات_الكود": "فحص_التعليقات",
                "تنظيم_الكود": "فحص_تنظيم_الكود"
            }

            # قواعد الأمان
            هذا.قواعد_التحليل["الأمان"] = {
                "مدخلات_المستخدم": "فحص_مدخلات_المستخدم",
                "التشفير": "فحص_التشفير",
                "صلاحيات_الوصول": "فحص_صلاحيات_الوصول"
            }

            # قواعد كشف الروائح البرمجية
            هذا.قواعد_التحليل["روائح_برمجية"] = {
                "كود_مكرر": "كشف_الكود_المكرر",
                "دالة_طويلة": "كشف_الدوال_الطويلة",
                "صف_كبير": "كشف_الصفوف_الكبيرة"
            }

        # ────────────────────────────────────────────────────────
        # 2️⃣  دوال الفحص الشامل
        # ────────────────────────────────────────────────────────

        دالة فحص_جودة_الكود_الشامل(مسار_الملف_أو_المجلد):
            "فحص شامل لجودة الكود"
            وقت_البداية = الوقت_الحالي()
            اطبع("🔍 بدء فحص جودة الكود الشامل...")

            # جمع ملفات الكود
            ملفات_الكود = هذا.جمع_ملفات_الكود(مسار_الملف_أو_المجلد)

            نتائج_شاملة = {
                "إحصائيات_عامة": {},
                "نتائج_مفصلة": {},
                "تقييم_عام": {},
                "توصيات": []
            }

            لكل ملف in ملفات_الكود:
                اطبع("📄 فحص الملف: " + ملف)

                # قراءة محتوى الملف
                محتوى_الملف = قراءة_ملف(ملف)

                # فحص الملف
                نتائج_الملف = هذا.فحص_ملف_واحد(محتوى_الملف, ملف)

                نتائج_شاملة["نتائج_مفصلة"][ملف] = نتائج_الملف
                هذا.إحصائيات_الجودة["ملفات_محللة"] = هذا.إحصائيات_الجودة["ملفات_محللة"] + 1

            # حساب الإحصائيات العامة
            نتائج_شاملة["إحصائيات_عامة"] = هذا.حساب_الإحصائيات_العامة(نتائج_شاملة["نتائج_مفصلة"])

            # تقييم عام للمشروع
            نتائج_شاملة["تقييم_عام"] = هذا.تقييم_عام_للمشروع(نتائج_شاملة["إحصائيات_عامة"])

            # توليد التوصيات
            نتائج_شاملة["توصيات"] = هذا.توليد_التوصيات(نتائج_شاملة)

            وقت_الانتهاء = الوقت_الحالي()
            هذا.إنشاء_تقرير_الجودة_الشامل(نتائج_شاملة, وقت_البداية, وقت_الانتهاء)

            أرجع نتائج_شاملة

        دالة فحص_ملف_واحد(محتوى_الملف، اسم_الملف):
            "فحص ملف واحد من الكود"
            نتائج = {
                "بناء_الجملة": {},
                "التعقيد_الحسابي": {},
                "الأسلوب": {},
                "الأمان": {},
                "روائح_برمجية": {},
                "درجة_الجودة": 0,
                "المشاكل": [],
                "التحذيرات": [],
                "الاقتراحات": []
            }

            # تحليل بناء الجملة
            نتائج["بناء_الجملة"] = هذا.تحليل_بناء_الجملة(محتوى_الملف)

            # قياس التعقيد الحسابي
            نتائج["التعقيد_الحسابي"] = هذا.قياس_التعقيد_الحسابي(محتوى_الملف)

            # فحص الأسلوب
            نتائج["الأسلوب"] = هذا.فحص_الأسلوب(محتوى_الملف)

            # فحص الأمان
            نتائج["الأمان"] = هذا.فحص_الأمان(محتوى_الملف)

            # كشف الروائح البرمجية
            نتائج["روائح_برمجية"] = هذا.كشف_الروائح_البرمجية(محتوى_الملف)

            # حساب درجة الجودة
            نتائج["درجة_الجودة"] = هذا.حساب_درجة_جودة_الملف(نتائج)

            # جمع جميع المشاكل والتحذيرات والاقتراحات
            نتائج["المشاكل"] = هذا.جمع_المشاكل(نتائج)
            نتائج["التحذيرات"] = هذا.جمع_التحذيرات(نتائج)
            نتائج["الاقتراحات"] = هذا.جمع_الاقتراحات(نتائج)

            # تحديث الإحصائيات العامة
            هذا.إحصائيات_الجودة["أخطاء_مكتشفة"] = هذا.إحصائيات_الجودة["أخطاء_مكتشفة"] + طول(نتائج["المشاكل"])
            هذا.إحصائيات_الجودة["تحذيرات_مكتشفة"] = هذا.إحصائيات_الجودة["تحذيرات_مكتشفة"] + طول(نتائج["التحذيرات"])
            هذا.إحصائيات_الجودة["اقتراحات_مقدمة"] = هذا.إحصائيات_الجودة["اقتراحات_مقدمة"] + طول(نتائج["الاقتراحات"])

            أرجع نتائج

        # ────────────────────────────────────────────────────────
        # 3️⃣  دوال التحليل المفصل
        # ────────────────────────────────────────────────────────

        دالة تحليل_بناء_الجملة(الكود):
            "تحليل بناء الجملة للكود"
            نتائج = {
                "أخطاء_تركيبية": [],
                "أقواس_غير_متوازنة": [],
                "مسافات_خاطئة": [],
                "درجة_بناء_الجملة": 10
            }

            # فحص الأقواس المتوازنة
            أقواس_مفتوحة = 0
            لكل i في 0..طول(الكود)-1:
                حرف = الكود[i]
                إذا حرف == "{":
                    أقواس_مفتوحة = أقواس_مفتوحة + 1
                وإلا إذا حرف == "}":
                    أقواس_مفتوحة = أقواس_مفتوحة - 1
                    إذا أقواس_مفتوحة < 0:
                        نتائج["أقواس_غير_متوازنة"].أضف("قوس إغلاق بدون فتح في السطر " + نص(i))
                        نتائج["درجة_بناء_الجملة"] = نتائج["درجة_بناء_الجملة"] - 1

            إذا أقواس_مفتوحة > 0:
                نتائج["أقواس_غير_متوازنة"].أضف("قوس فتح بدون إغلاق")
                نتائج["درجة_بناء_الجملة"] = نتائج["درجة_بناء_الجملة"] - 1

            # فحص المسافات
            سطور = تقسيم(الكود, "\n")
            لكل رقم_سطر في 0..طول(سطور)-1:
                سطر = سطور[رقم_سطر]
                # فحص المسافات الزائدة
                إذا يبدأ_ب(سطر, "  ") و ليس يحتوي(سطر, "دالة") و ليس يحتوي(سطر, "إذا"):
                    نتائج["مسافات_خاطئة"].أضف("مسافات زائدة في السطر " + نص(رقم_سطر + 1))
                    نتائج["درجة_بناء_الجملة"] = نتائج["درجة_بناء_الجملة"] - 0.5

            أرجع نتائج

        دالة قياس_التعقيد_الحسابي(الكود):
            "قياس التعقيد الحسابي للكود"
            نتائج = {
                "عمق_التداخل_الأقصى": 0,
                "عدد_الدوال": 0,
                "متوسط_طول_الدالة": 0,
                "نقاط_التعقيد": 0,
                "درجة_التعقيد": 10
            }

            سطور = تقسيم(الكود, "\n")
            عمق_حالي = 0
            عمق_أقصى = 0
            بداية_دالة = -1
            أطوال_الدوال = []

            لكل رقم_سطر في 0..طول(سطور)-1:
                سطر = سطور[رقم_سطر]

                # فحص بداية الدالة
                إذا يحتوي(سطر, "دالة "):
                    إذا بداية_دالة != -1:
                        أطوال_الدوال.أضف(رقم_سطر - بداية_دالة)
                    بداية_دالة = رقم_سطر
                    نتائج["عدد_الدوال"] = نتائج["عدد_الدوال"] + 1

                # قياس العمق
                إذا يحتوي(سطر, "{"):
                    عمق_حالي = عمق_حالي + 1
                    إذا عمق_حالي > عمق_أقصى:
                        عمق_أقصى = عمق_حالي
                وإلا إذا يحتوي(سطر, "}"):
                    عمق_حالي = عمق_حالي - 1

                # نقاط التعقيد
                إذا يحتوي(سطر, "إذا ") أو يحتوي(سطر, "بينما ") أو يحتوي(سطر, "لكل "):
                    نتائج["نقاط_التعقيد"] = نتائج["نقاط_التعقيد"] + 1

            # إنهاء الدالة الأخيرة
            إذا بداية_دالة != -1:
                أطوال_الدوال.أضف(طول(سطور) - بداية_دالة)

            نتائج["عمق_التداخل_الأقصى"] = عمق_أقصى

            # حساب متوسط طول الدالة
            إذا طول(أطوال_الدوال) > 0:
                مجموع = 0
                لكل طول in أطوال_الدوال:
                    مجموع = مجموع + طول
                نتائج["متوسط_طول_الدالة"] = مجموع / طول(أطوال_الدوال)

            # تقييم التعقيد
            إذا عمق_أقصى > 4:
                نتائج["درجة_التعقيد"] = نتائج["درجة_التعقيد"] - 2
            إذا نتائج["متوسط_طول_الدالة"] > 50:
                نتائج["درجة_التعقيد"] = نتائج["درجة_التعقيد"] - 1
            إذا نتائج["نقاط_التعقيد"] > 20:
                نتائج["درجة_التعقيد"] = نتائج["درجة_التعقيد"] - 1

            أرجع نتائج

        دالة فحص_الأسلوب(الكود):
            "فحص أسلوب الكود والمعايير"
            نتائج = {
                "متغيرات_غير_واضحة": [],
                "تعليقات_مفقودة": [],
                "كود_مكرر": [],
                "درجة_الأسلوب": 10
            }

            سطور = تقسيم(الكود, "\n")

            لكل رقم_سطر في 0..طول(سطور)-1:
                سطر = سطور[رقم_سطر]

                # فحص تسمية المتغيرات
                إذا يحتوي(سطر, "=") و ليس يحتوي(سطر, "دالة"):
                    # استخراج اسم المتغير (تبسيط)
                    إذا طول(سطر) > 50 و ليس يحتوي(سطر, "#"):
                        نتائج["متغيرات_غير_واضحة"].أضف("سطر طويل بدون تعليق: " + نص(رقم_سطر + 1))
                        نتائج["درجة_الأسلوب"] = نتائج["درجة_الأسلوب"] - 0.5

                # فحص التعليقات
                إذا يحتوي(سطر, "دالة ") و ليس يحتوي(سطر, "\"\"\""):
                    نتائج["تعليقات_مفقودة"].أضف("دالة بدون تعليق توضيحي: " + نص(رقم_سطر + 1))
                    نتائج["درجة_الأسلوب"] = نتائج["درجة_الأسلوب"] - 1

            # فحص الكود المكرر (تبسيط)
            كتل_كود = {}
            لكل سطر in سطور:
                سطر_منظف = استبدال(سطر, " ", "")
                إذا طول(سطر_منظف) > 20:
                    إذا كتل_كود[سطر_منظف] == صحيح:
                        نتائج["كود_مكرر"].أضف("كود مكرر: " + سطر)
                        نتائج["درجة_الأسلوب"] = نتائج["درجة_الأسلوب"] - 1
                    كتل_كود[سطر_منظف] = صحيح

            أرجع نتائج

        دالة فحص_الأمان(الكود):
            "فحص الأمان في الكود"
            نتائج = {
                "ثغرات_أمنية": [],
                "مدخلات_غير_محققة": [],
                "مشاكل_تشفير": [],
                "درجة_الأمان": 10
            }

            # فحص الثغرات الأمنية الأساسية
            إذا يحتوي(الكود, "exec(") أو يحتوي(الكود, "eval("):
                نتائج["ثغرات_أمنية"].أضف("استخدام exec() أو eval() - خطير")
                نتائج["درجة_الأمان"] = نتائج["درجة_الأمان"] - 3

            إذا يحتوي(الكود, "input(") و ليس يحتوي(الكود, "فحص") و ليس يحتوي(الكود, "تحقق"):
                نتائج["مدخلات_غير_محققة"].أضف("مدخلات مستخدم غير محققة")
                نتائج["درجة_الأمان"] = نتائج["درجة_الأمان"] - 2

            إذا يحتوي(الكود, "password") و ليس يحتوي(الكود, "encrypt") و ليس يحتوي(الكود, "hash"):
                نتائج["مشاكل_تشفير"].أضف("كلمات مرور غير مشفرة")
                نتائج["درجة_الأمان"] = نتائج["درجة_الأمان"] - 2

            أرجع نتائج

        دالة كشف_الروائح_البرمجية(الكود):
            "كشف الروائح البرمجية في الكود"
            نتائج = {
                "دوال_طويلة": [],
                "صفوف_كبيرة": [],
                "كود_مكرر": [],
                "تعقيد_عالي": [],
                "درجة_الروائح": 10
            }

            سطور = تقسيم(الكود, "\n")

            # كشف الدوال الطويلة
            بداية_دالة = -1
            اسم_الدالة = ""

            لكل رقم_سطر في 0..طول(سطور)-1:
                سطر = سطور[رقم_سطر]

                إذا يحتوي(سطر, "دالة "):
                    إذا بداية_دالة != -1:
                        طول_الدالة = رقم_سطر - بداية_دالة
                        إذا طول_الدالة > 30:
                            نتائج["دوال_طويلة"].أضف("دالة طويلة: " + اسم_الدالة + " (" + نص(طول_الدالة) + " سطر)")
                            نتائج["درجة_الروائح"] = نتائج["درجة_الروائح"] - 1

                    بداية_دالة = رقم_سطر
                    # استخراج اسم الدالة (تبسيط)
                    اسم_الدالة = استخراج_بين(سطر, "دالة ", "(")

            أرجع نتائج

        # ────────────────────────────────────────────────────────
        # 4️⃣  دوال الحساب والتقييم
        # ────────────────────────────────────────────────────────

        دالة حساب_درجة_جودة_الملف(نتائج_التحليل):
            "حساب درجة جودة الملف الشاملة"
            درجة = 0

            درجة = درجة + (نتائج_التحليل["بناء_الجملة"]["درجة_بناء_الجملة"] * 0.2)
