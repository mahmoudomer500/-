# اختبار شامل لنظام الأنواع المحسن
# اختبار Type Inference والـ Generics والتحويلات التلقائية

# اختبار استنتاج الأنواع
متغير رقم = 42
متغير نص_رقم = "123"
متغير نص_عادي = "مرحبا"
متغير مصفوفة_أرقام = [1، 2، 3، 4، 5]
متغير قيمة_منطقية = "صحيح"

# اختبار التحويلات التلقائية
متغير نص_من_رقم = رقم  # رقم إلى نص تلقائياً
متغير رقم_من_نص = نص_رقم  # نص إلى رقم تلقائياً

# اختبار Generics - القوائم العامة
# قائمة<رقم> قائمة_أرقام
# قائمة<نص> قائمة_نصوص

# ملء القوائم (في الإصدار البسيط نستخدم مصفوفات عادية)
متغير قائمة_أرقام = [10، 20، 30، 40]
متغير قائمة_نصوص = ["أحمد"، "فاطمة"، "علي"]

# اختبار العمليات على الأنواع المختلفة
دالة جمع_مرن(أ، ب)
    ارجع أ + ب
نهاية

دالة ضرب_مرن(أ، ب)
    ارجع أ * ب
نهاية

دالة مقارنة_مرن(أ، ب)
    ارجع أ == ب
نهاية

# اختبار استدعاءات الدوال المتعددة (لـ JIT)
متغير نتيجة1 = جمع_مرن(رقم، رقم_من_نص)
متغير نتيجة2 = جمع_مرن(نص_عادي، " بالعالم")
متغير نتيجة3 = ضرب_مرن(رقم، 2)
متغير نتيجة4 = ضرب_مرن(رقم_من_نص، 3)
متغير نتيجة5 = مقارنة_مرن(رقم، 42)
متغير نتيجة6 = مقارنة_مرن(نص_رقم، "123")

# اختبار الوصول للمصفوفات مع فحص الحدود
متغير عنصر_أول = قائمة_أرقام[0]
متغير عنصر_ثاني = قائمة_نصوص[1]
# متغير عنصر_خارج = قائمة_أرقام[10]  # سيسبب خطأ (معطل للاختبار)

# طباعة النتائج
اطبع "=== نتائج اختبار نظام الأنواع المحسن ==="
اطبع ""
اطبع "المتغيرات الأساسية:"
اطبع "  رقم: " رقم
اطبع "  نص_رقم: " نص_رقم
اطبع "  نص_عادي: " نص_عادي
اطبع ""
اطبع "التحويلات التلقائية:"
اطبع "  نص_من_رقم: " نص_من_رقم
اطبع "  رقم_من_نص: " رقم_من_نص
اطبع ""
اطبع "القوائم:"
اطبع "  قائمة_أرقام[0]: " عنصر_أول
اطبع "  قائمة_نصوص[1]: " عنصر_ثاني
اطبع ""
اطبع "نتائج العمليات:"
اطبع "  جمع_مرن(رقم, رقم_من_نص): " نتيجة1
