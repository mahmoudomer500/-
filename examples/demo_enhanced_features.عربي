# 3️⃣ الجينيريك (Generics) - الأنواع العامة
# ────────────────────────────────────────────────────────────────

# تعريف صنف عام
صنف عام قائمة<نوع T> {
    خاصية عناصر: مصفوفة<T>
    خاصية طول: رقم

    دالة إنشاء()
        هذا.عناصر = مصفوفة_جديدة()
        هذا.طول = 0
    نهاية

    دالة إضافة(عنصر: T) -> صفر
        أضف(هذا.عناصر، عنصر)
        هذا.طول = هذا.طول + 1
    نهاية

    دالة احصل(فهرس: رقم) -> T
        إذا فهرس >= 0 و فهرس < هذا.طول
            ارجع هذا.عناصر[فهرس]
        وإلا
            ارجع لا_شيء
        نهاية
    نهاية
}

# تعريف دالة عامة
دالة عامة ابحث<نوع T>(قائمة: قائمة<T>، شرط: دالة(T)->منطق) -> T {
    لكل عنصر في قائمة.عناصر {
        إذا شرط(عنصر) {
            ارجع عنصر
        }
    }
    ارجع لا_شيء
}

# استخدام الأنواع العامة
دالة تجربة_الجينيريك()
    # قائمة أرقام
    قائمة_أرقام = قائمة<رقم>.جديد()
    قائمة_أرقام.إضافة(10)
    قائمة_أرقام.إضافة(20)
    قائمة_أرقام.إضافة(30)

    # قائمة نصوص
    قائمة_نصوص = قائمة<نص>.جديد()
    قائمة_نصوص.إضافة("أحمد")
    قائمة_نصوص.إضافة("فاطمة")
    قائمة_نصوص.إضافة("محمد")

    # استخدام دالة عامة
    رقم_كبير = ابحث(قائمة_أرقام، دالة(رقم) { ارجع رقم > 25 })
    نص_طويل = ابحث(قائمة_نصوص، دالة(نص) { ارجع طول(نص) > 5 })

    اطبع("رقم كبير: " + رقم_كبير)
    اطبع("نص طويل: " + نص_طويل)
نهاية

