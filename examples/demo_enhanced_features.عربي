# 4️⃣ async/await - البرمجة غير المتزامنة
# ────────────────────────────────────────────────────────────────

# دالة غير متزامنة لقراءة ملف
دالة غير_متزامنة اقرأ_ملف_نصي_آمن(اسم_الملف: نص) -> وعد<نص> {
    وعد = إنشاء_وعد()

    شغل_في_خلفية {
        جرب {
            محتوى = اقرأ_ملف_نصي(اسم_الملف)
            وعد.حل(محتوى)
        } catch(خطأ) {
            وعد.رفض("فشل في قراءة الملف: " + خطأ)
        }
    }

    ارجع وعد
}

# دالة غير متزامنة لمعالجة بيانات
دالة غير_متزامنة معالجة_البيانات<نوع T>(بيانات: قائمة<T>) -> وعد<قائمة<T>> {
    وعد = إنشاء_وعد()

    شغل_في_خلفية {
        جرب {
            # معالجة البيانات (مثال بسيط)
            نتائج = قائمة<T>.جديد()

            لكل عنصر في بيانات.عناصر {
                # بعض المعالجة
                أضف(نتائج، عنصر)
            }

            وعد.حل(نتائج)
        } catch(خطأ) {
            وعد.رفض("فشل في معالجة البيانات: " + خطأ)
        }
    }

    ارجع وعد
}

# دالة رئيسية غير متزامنة
دالة غير_متزامنة الدالة_الرئيسية()
    اطبع("🚀 بدء البرنامج غير المتزامن")

    # انتظار قراءة ملف
    محتوى_الملف = انتظر اقرأ_ملف_نصي_آمن("بيانات.txt")
    اطبع("تم قراءة الملف: " + طول(محتوى_الملف) + " حرف")

    # إنشاء بيانات تجريبية
    بيانات = قائمة<رقم>.جديد()
    لكل i في 1..5 {
        بيانات.إضافة(i * 10)
    }

    # انتظار معالجة البيانات
    نتائج = انتظر معالجة_البيانات(بيانات)
    اطبع("تم معالجة " + نتائج.طول + " عنصر")

    # انتظار عدة مهام في نفس الوقت
    مهمة1 = اقرأ_ملف_نصي_آمن("ملف1.txt")
    مهمة2 = اقرأ_ملف_نصي_آمن("ملف2.txt")
    مهمة3 = معالجة_البيانات(بيانات)

    جميع_النتائج = انتظر_الجميع(مهمة1، مهمة2، مهمة3)
    اطبع("تم إنجاز جميع المهام")

    اطبع("✅ انتهى البرنامج غير المتزامن")
نهاية

