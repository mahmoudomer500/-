# مولد_كود.عربي - نسخة متوافقة مع المترجم الحالي
# مولد الكود (Code Generator) للغة البرمجة العربية

# ═══════════════════════════════════════════════════════════
# تعليمات الآلة (Machine Instructions)
# ═══════════════════════════════════════════════════════════

صف تعليمات_آلة:
    عام:
        نص النوع
        نص المعامل_الأول
        نص المعامل_الثاني
        رقم رقم_السطر
        
        دالة جديد(نوع، م1 = ""، م2 = ""، سطر = 0):
            هذا.النوع = نوع
            هذا.المعامل_الأول = م1
            هذا.المعامل_الثاني = م2
            هذا.رقم_السطر = سطر
        
        دالة إلى_نص():
            أرجع هذا.النوع + " " + هذا.المعامل_الأول

# ═══════════════════════════════════════════════════════════
# مولد الكود (Code Generator)
# ═══════════════════════════════════════════════════════════

صف مولد_كود:
    خاص:
        مصفوفة التعليمات
        رقم العداد
        
    عام:
        دالة جديد():
            هذا.التعليمات = []
            هذا.العداد = 0
        
        # إنشاء تسمية جديدة
        دالة تسمية_جديدة():
            هذا.العداد = هذا.العداد + 1
            أرجع "L" + هذا.العداد
        
        # إضافة تعليمات
        دالة أضف(نوع، م1 = ""، م2 = ""):
            متغير ت = تعليمات_آلة.جديد(نوع، م1، م2)
            هذا.التعليمات.أضف(ت)
        
        # طباعة التعليمات
        دالة اطبع():
            اطبع("═══════════════════════════════════════")
            اطبع("التعليمات المولدة:")
            
            متغير ط = 0
            بينما ط < طول(هذا.التعليمات):
                متغير ت = هذا.التعليمات[ط]
                اطبع(ت.إلى_نص())
                ط = ط + 1
            
            اطبع("═══════════════════════════════════════")
            اطبع("عدد التعليمات: " + هذا.العداد)

# ═══════════════════════════════════════════════════════════
# دالة اختبار
# ═══════════════════════════════════════════════════════════

دالة اختبر():
    اطبع("اختبار مولد الكود")
    متغير مولد = مولد_كود.جديد()
    
    # إضافة بعض التعليمات
    مولد.أضف("ALLOC", "1000")
    مولد.أضف("LOAD", "SYSTEM_INPUT")
    مولد.أضف("LOAD", "SYSTEM_OUTPUT")
    مولد.أضف("ADD", "ACC")
    مولد.أضف("STORE", "RESULT")
    مولد.أضف("HALT")
    
    مولد.اطبع()
    اطبع("✅ انتهى الاختبار")
