# ═══════════════════════════════════════════════════════════
# 🛠️ سكريبتات المساعدة الشاملة - الإصدار 2.0
# ═══════════════════════════════════════════════════════════
# وصف: مجموعة شاملة من السكريبتات للتطوير والاختبار والنشر
# الميزات: أتمتة العمليات، تبسيط سير العمل، تحسين الإنتاجية
# ═══════════════════════════════════════════════════════════

صف سكريبتات_المساعدة:
    خاص:
        إعدادات_السكريبتات
        مسارات_المشروع
        إحصائيات_التشغيل

    عام:
        # ────────────────────────────────────────────────────────
        # 1️⃣  دالة التهيئة والإعداد
        # ────────────────────────────────────────────────────────

        دالة جديد():
            "تهيئة سكريبتات المساعدة"
            هذا.إعدادات_السكريبتات = {
                "وضع_التفصيل": صحيح,
                "حفظ_السجلات": صحيح,
                "إشعارات_التشغيل": صحيح,
                "نسخ_احتياطي_تلقائي": خطأ
            }
            هذا.مسارات_المشروع = {
                "مجلد_المشروع": "./",
                "مجلد_المصدر": "src/",
                "مجلد_الاختبارات": "tests/",
                "مجلد_البناء": "build/",
                "مجلد_التوثيق": "docs/",
                "مجلد_التوزيع": "dist/"
            }
            هذا.إحصائيات_التشغيل = {
                "سكريبتات_منفذة": 0,
                "عمليات_ناجحة": 0,
                "عمليات_فاشلة": 0,
                "وقت_التشغيل_الكلي": 0
            }

        # ────────────────────────────────────────────────────────
        # 2️⃣  سكريبتات البناء والترجمة
        # ────────────────────────────────────────────────────────

        دالة سكريبت_البناء_الشامل():
            "سكريبت بناء شامل للمشروع"
            وقت_البداية = الوقت_الحالي()
            اطبع("🏗️ بدء البناء الشامل...")

            نجاح = صحيح

            # خطوة 1: تنظيف مجلد البناء
            اطبع("🧹 تنظيف مجلد البناء...")
            نجاح = نجاح و هذا.تنظيف_مجلد_البناء()

            # خطوة 2: فحص المتطلبات
            اطبع("🔍 فحص المتطلبات...")
            نجاح = نجاح و هذا.فحص_متطلبات_البناء()

            # خطوة 3: توليد الملفات المؤقتة
            اطبع("📝 توليد الملفات المؤقتة...")
            نجاح = نجاح و هذا.توليد_الملفات_المؤقتة()

            # خطوة 4: ترجمة الكود المصدري
            اطبع("⚙️ ترجمة الكود المصدري...")
            نجاح = نجاح و هذا.ترجمة_الكود_المصدري()

            # خطوة 5: ربط المكتبات
            اطبع("🔗 ربط المكتبات...")
            نجاح = نجاح و هذا.ربط_المكتبات()

            # خطوة 6: إنشاء الملفات التنفيذية
            اطبع("📦 إنشاء الملفات التنفيذية...")
            نجاح = نجاح و هذا.إنشاء_الملفات_التنفيذية()

            # خطوة 7: تشغيل الاختبارات الأساسية
            اطبع("🧪 تشغيل الاختبارات الأساسية...")
            نجاح = نجاح و هذا.تشغيل_الاختبارات_الأساسية()

            وقت_الانتهاء = الوقت_الحالي()
            هذا.إحصائيات_التشغيل["سكريبتات_منفذة"] = هذا.إحصائيات_التشغيل["سكريبتات_منفذة"] + 1

            إذا نجاح:
                هذا.إحصائيات_التشغيل["عمليات_ناجحة"] = هذا.إحصائيات_التشغيل["عمليات_ناجحة"] + 1
                اطبع("✅ تم البناء بنجاح!")
                هذا.إنشاء_تقرير_البناء(وقت_البداية, وقت_الانتهاء, صحيح)
            وإلا:
                هذا.إحصائيات_التشغيل["عمليات_فاشلة"] = هذا.إحصائيات_التشغيل["عمليات_فاشلة"] + 1
                اطبع("❌ فشل في البناء!")
                هذا.إنشاء_تقرير_البناء(وقت_البداية, وقت_الانتهاء, خطأ)

            أرجع نجاح

        دالة سكريبت_البناء_السريع():
            "سكريبت بناء سريع للتطوير"
            وقت_البداية = الوقت_الحالي()
            اطبع("⚡ بدء البناء السريع...")

            # تخطي بعض الخطوات لتسريع العملية
            نجاح = هذا.ترجمة_الكود_المصدري() و هذا.ربط_المكتبات() و هذا.إنشاء_الملفات_التنفيذية()

            وقت_الانتهاء = الوقت_الحالي()

            إذا نجاح:
                اطبع("✅ تم البناء السريع بنجاح!")
            وإلا:
                اطبع("❌ فشل في البناء السريع!")

            أرجع نجاح

        دالة سكريبت_البناء_للاختبار():
            "سكريبت بناء خاص بالاختبارات"
            اطبع("🧪 بناء للاختبارات...")

            # بناء مع تضمين معلومات التصحيح
            نجاح = هذا.تنظيف_مجلد_البناء()
            نجاح = نجاح و هذا.ترجمة_الكود_المصدري_مع_التصحيح()
            نجاح = نجاح و هذا.ربط_مكتبات_الاختبار()
            نجاح = نجاح و هذا.إنشاء_ملفات_اختبار_تنفيذية()

            إذا نجاح:
                اطبع("✅ تم بناء ملفات الاختبار بنجاح!")
            وإلا:
                اطبع("❌ فشل في بناء ملفات الاختبار!")

            أرجع نجاح

        # ────────────────────────────────────────────────────────
        # 3️⃣  سكريبتات الاختبار والتحقق
        # ────────────────────────────────────────────────────────

        دالة سكريبت_تشغيل_الاختبارات():
            "سكريبت تشغيل جميع الاختبارات"
            وقت_البداية = الوقت_الحالي()
            اطبع("🧪 بدء تشغيل الاختبارات...")

            نتائج_الاختبارات = {}

            # اختبارات الوحدة
            اطبع("📋 تشغيل اختبارات الوحدة...")
            نتائج_الاختبارات["الوحدة"] = هذا.تشغيل_اختبارات_الوحدة()

            # اختبارات التكامل
            اطبع("🔗 تشغيل اختبارات التكامل...")
            نتائج_الاختبارات["التكامل"] = هذا.تشغيل_اختبارات_التكامل()

            # اختبارات الأداء
            اطبع("⚡ تشغيل اختبارات الأداء...")
            نتائج_الاختبارات["الأداء"] = هذا.تشغيل_اختبارات_الأداء()

            # اختبارات التوافق
            اطبع("🔄 تشغيل اختبارات التوافق...")
            نتائج_الاختبارات["التوافق"] = هذا.تشغيل_اختبارات_التوافق()

            وقت_الانتهاء = الوقت_الحالي()

            # تحليل النتائج
            نجاح_الاختبارات = هذا.تحليل_نتائج_الاختبارات(نتائج_الاختبارات)
            هذا.إنشاء_تقرير_الاختبارات(نتائج_الاختبارات, وقت_البداية, وقت_الانتهاء)

            أرجع نجاح_الاختبارات

        دالة سكريبت_اختبار_التوافق():
            "سكريبت اختبار التوافق مع المنصات المختلفة"
            اطبع("🔄 اختبار التوافق...")

            # استخدام أدوات فحص التوافق
            استورد "أدوات_فحص_التوافق.عربي"
            أدوات_الفحص = أدوات_فحص_التوافق.جديد()

            تقرير_التوافق = أدوات_الفحص.فحص_النظام_الكامل()
            أدوات_الفحص.حفظ_تقرير_فحص("تقرير_توافق_الاختبار.txt")

            اطبع("✅ تم إنشاء تقرير التوافق")
            أرجع تقرير_التوافق

        دالة سكريبت_قياس_الأداء():
            "سكريبت قياس أداء التطبيق"
            اطبع("📊 قياس الأداء...")

            نتائج_الأداء = {}

            # قياس وقت التشغيل
            وقت_التشغيل = هذا.قياس_وقت_التشغيل()
            نتائج_الأداء["وقت_التشغيل"] = وقت_التشغيل

            # قياس استهلاك الذاكرة
            استهلاك_الذاكرة = هذا.قياس_استهلاك_الذاكرة()
            نتائج_الأداء["استهلاك_الذاكرة"] = استهلاك_الذاكرة

            # قياس استخدام المعالج
            استخدام_المعالج = هذا.قياس_استخدام_المعالج()
            نتائج_الأداء["استخدام_المعالج"] = استخدام_المعالج

            هذا.إنشاء_تقرير_الأداء(نتائج_الأداء)
            أرجع نتائج_الأداء

        # ────────────────────────────────────────────────────────
        # 4️⃣  سكريبتات النشر والتوزيع
        # ────────────────────────────────────────────────────────

        دالة سكريبت_النشر_للإنتاج():
            "سكريبت نشر التطبيق للإنتاج"
            وقت_البداية = الوقت_الحالي()
            اطبع("🚀 بدء النشر للإنتاج...")

            نجاح = صحيح

            # خطوة 1: بناء الإصدار النهائي
            اطبع("📦 بناء الإصدار النهائي...")
            نجاح = نجاح و هذا.سكريبت_البناء_الشامل()

            # خطوة 2: تحسين الكود
            اطبع("⚡ تحسين الكود...")
            نجاح = نجاح و هذا.تحسين_الكود_للإنتاج()

            # خطوة 3: إنشاء حزم التثبيت
            اطبع("📦 إنشاء حزم التثبيت...")
            نجاح = نجاح و هذا.إنشاء_حزم_التثبيت()

            # خطوة 4: فحص الأمان
            اطبع("🔒 فحص الأمان...")
            نجاح = نجاح و هذا.فحص_الأمان()

            # خطوة 5: النشر
            اطبع("🌐 النشر...")
            نجاح = نجاح و هذا.نشر_التطبيق()

            وقت_الانتهاء = الوقت_الحالي()

            إذا نجاح:
                اطبع("✅ تم النشر بنجاح!")
                هذا.إنشاء_تقرير_النشر(وقت_البداية, وقت_الانتهاء, صحيح)
            وإلا:
                اطبع("❌ فشل في النشر!")
                هذا.إنشاء_تقرير_النشر(وقت_البداية, وقت_الانتهاء, خطأ)

            أرجع نجاح

        دالة سكريبت_النشر_للاختبار():
            "سكريبت نشر للاختبار (Staging)"
            اطبع("🧪 نشر للاختبار...")

            نجاح = هذا.سكريبت_البناء_للاختبار()
            نجاح = نجاح و هذا.نشر_للاختبار()
            نجاح = نجاح و هذا.تشغيل_اختبارات_النشر()

            إذا نجاح:
                اطبع("✅ تم النشر للاختبار بنجاح!")
            وإلا:
                اطبع("❌ فشل في النشر للاختبار!")

            أرجع نجاح

        دالة سكريبت_إنشاء_الحزم():
            "سكريبت إنشاء حزم التثبيت لمختلف المنصات"
            اطبع("📦 إنشاء حزم التثبيت...")

            حزم_منشأة = []

            # حزمة Windows
            إذا هذا.إنشاء_حزمة_ويندوز():
                حزم_منشأة.أضف("حزمة_Windows.msi")

            # حزمة Linux
            إذا هذا.إنشاء_حزمة_لينكس():
                حزم_منشأة.أضف("حزمة_Linux.deb")

            # حزمة macOS
            إذا هذا.إنشاء_حزمة_ماك():
                حزم_منشأة.أضف("حزمة_macOS.dmg")

            اطبع("✅ تم إنشاء " + نص(طول(حزم_منشأة)) + " حزمة تثبيت")
            أرجع حزم_منشأة

        # ────────────────────────────────────────────────────────
        # 5️⃣  سكريبتات الصيانة والتنظيف
        # ────────────────────────────────────────────────────────

        دالة سكريبت_التنظيف_الشامل():
            "سكريبت تنظيف شامل للمشروع"
            اطبع("🧹 بدء التنظيف الشامل...")

            # تنظيف ملفات البناء
            هذا.تنظيف_ملفات_البناء()

            # تنظيف الملفات المؤقتة
            هذا.تنظيف_الملفات_المؤقتة()

            # تنظيف السجلات القديمة
            هذا.تنظيف_السجلات_القديمة()

            # تنظيف ذاكرة التخزين المؤقت
            هذا.تنظيف_ذاكرة_التخزين_المؤقت()

            اطبع("✅ تم التنظيف الشامل")

        دالة سكريبت_التحديث_التلقائي():
            "سكريبت تحديث المشروع تلقائياً"
            اطبع("🔄 بدء التحديث التلقائي...")

            # تحديث المكتبات
            هذا.تحديث_المكتبات()

            # تحديث الأدوات
            هذا.تحديث_الأدوات()

            # تحديث التبعيات
            هذا.تحديث_التبعيات()

            # فحص التحديثات الجديدة
            هذا.فحص_التحديثات_الجديدة()

            اطبع("✅ تم التحديث التلقائي")

        دالة سكريبت_النسخ_الاحتياطي():
            "سكريبت إنشاء نسخة احتياطية من المشروع"
            وقت_النسخ = التاريخ_والوقت_الحالي()
            اسم_النسخة = "نسخة_احتياطية_" + نص(وقت_النسخ)

            اطبع("💾 إنشاء نسخة احتياطية: " + اسم_النسخة)

            نجاح = هذا.إنشاء_نسخة_احتياطية(اسم_النسخة)

            إذا نجاح:
                اطبع("✅ تم إنشاء النسخة الاحتياطية بنجاح")
            وإلا:
                اطبع("❌ فشل في إنشاء النسخة الاحتياطية")

            أرجع نجاح

        دالة سكريبت_فحص_الكود():
            "سكريبت فحص جودة الكود وتحليله"
            اطبع("🔍 فحص جودة الكود...")

            نتائج_الفحص = {}

            # فحص بناء الجملة
            نتائج_الفحص["بناء_الجملة"] = هذا.فحص_بناء_الجملة()

            # فحص الأسلوب
            نتائج_الفحص["الأسلوب"] = هذا.فحص_الأسلوب()

            # فحص الأمان
            نتائج_الفحص["الأمان"] = هذا.فحص_الأمان()

            # فحص الأداء
            نتائج_الفحص["الأداء"] = هذا.فحص_الأداء()

            هذا.إنشاء_تقرير_فحص_الكود(نتائج_الفحص)
            أرجع نتائج_الفحص

        # ────────────────────────────────────────────────────────
        # 6️⃣  دوال التنفيذ الأساسية (يجب تنفيذها)
        # ────────────────────────────────────────────────────────

        دالة تنظيف_مجلد_البناء():
            "تنظيف مجلد البناء"
            جرب:
                تنفيذ_أمر("rm -rf " + هذا.مسارات_المشروع["مجلد_البناء"])
                تنفيذ_أمر("mkdir -p " + هذا.مسارات_المشروع["مجلد_البناء"])
                أرجع صحيح
            خطأ:
                أرجع خطأ

        دالة فحص_متطلبات_البناء():
            "فحص متطلبات البناء"
            # فحص توفر المترجم والأدوات المطلوبة
            أرجع تنفيذ_أمر("which gcc && which make && which cmake") != ""

        دالة توليد_الملفات_المؤقتة():
            "توليد الملفات المؤقتة المطلوبة"
            جرب:
                # توليد ملفات الإعداد
                تنفيذ_أمر("cmake -S . -B " + هذا.مسارات_المشروع["مجلد_البناء"])
                أرجع صحيح
            خطأ:
                أرجع خطأ

        دالة ترجمة_الكود_المصدري():
            "ترجمة الكود المصدري"
            جرب:
                تنفيذ_أمر("cd " + هذا.مسارات_المشروع["مجلد_البناء"] + " && make -j$(nproc)")
                أرجع صحيح
            خطأ:
                أرجع خطأ

        دالة ربط_المكتبات():
            "ربط المكتبات المطلوبة"
            جرب:
                # ربط المكتبات الثابتة والديناميكية
                أرجع صحيح
            خطأ:
                أرجع خطأ

        دالة إنشاء_الملفات_التنفيذية():
            "إنشاء الملفات التنفيذية النهائية"
            جرب:
                تنفيذ_أمر("cd " + هذا.مسارات_المشروع["مجلد_البناء"] + " && make install")
                أرجع صحيح
            خطأ:
                أرجع خطأ

        دالة تشغيل_الاختبارات_الأساسية():
            "تشغيل الاختبارات الأساسية"
            جرب:
                تنفيذ_أمر("cd " + هذا.مسارات_المشروع["مجلد_البناء"] + " && make test")
                أرجع صحيح
            خطأ:
                أرجع خطأ

        # ────────────────────────────────────────────────────────
        # 7️⃣  دوال التقارير والإحصائيات
        # ────────────────────────────────────────────────────────

        دالة إنشاء_تقرير_البناء(وقت_البداية، وقت_الانتهاء، نجاح):
            "إنشاء تقرير البناء"
            تقرير = """
# ════════════════════════════════════════════════
# 📊 تقرير البناء
# ════════════════════════════════════════════════
وقت البداية: {وقت_البداية}
وقت الانتهاء: {وقت_الانتهاء}
المدة: {المدة} ثانية
الحالة: {الحالة}
════════════════════════════════════════════════
"""

            تقرير = استبدال(تقرير, "{وقت_البداية}", نص(وقت_البداية))
            تقرير = استبدال(تقرير, "{وقت_الانتهاء}", نص(وقت_الانتهاء))
            تقرير = استبدال(تقرير, "{المدة}", نص(وقت_الانتهاء - وقت_البداية))
            تقرير = استبدال(تقرير, "{الحالة}", "نجح" إذا نجاح وإلا "فشل")

            كتابة_ملف("تقرير_البناء.txt", تقرير)

        دالة إنشاء_تقرير_الاختبارات(نتائج_الاختبارات، وقت_البداية، وقت_الانتهاء):
            "إنشاء تقرير الاختبارات"
            تقرير = """
