# محلل_نحوي.عربي
# المحلل النحوي (Parser) للغة البرمجة العربية
# يقوم بتحويل الرموز (Tokens) إلى شجرة التحليل النحوي (AST)

# ═══════════════════════════════════════════════════════════
# بنية شجرة التحليل النحوي (AST Node Types)
# ═══════════════════════════════════════════════════════════

صف نوع_العقدة:
    عام:
        # أنواع التعابير
        نص رقم_حرفي = "رقم_حرفي"
        نص نص_حرفي = "نص_حرفي"
        نص معرف = "معرف"
        نص عملية_ثنائية = "عملية_ثنائية"
        نص عملية_أحادية = "عملية_أحادية"
        نص استدعاء_دالة = "استدعاء_دالة"
        نص وصول_خاصية = "وصول_خاصية"
        نص وصول_مصفوفة = "وصول_مصفوفة"
        
        # أنواع الأوامر
        نص تعريف_متغير = "تعريف_متغير"
        نص إسناد = "إسناد"
        نص إسناد_مصفوفة = "إسناد_مصفوفة"
        نص تعريف_دالة = "تعريف_دالة"
        نص إرجاع = "إرجاع"
        نص استدعاء_أمر = "استدعاء_أمر"
        نص إذا = "إذا"
        نص بينما = "بينما"
        نص لكل = "لكل"
        نص توقف = "توقف"
        نص استمر = "استمر"
        نص تعريف_صف = "تعريف_صف"
        نص إنشاء_كائن = "إنشاء_كائن"

# ═══════════════════════════════════════════════════════════
# عقدة شجرة التحليل النحوي (AST Node)
# ═══════════════════════════════════════════════════════════

صف عقدة_تحليل:
    عام:
        نص النوع
        نص القيمة
        مصفوفة العقد_الأبناء
        رقم رقم_السطر
        رقم عدد_العقد
        
        دالة جديد(نوع، قيمة، سطر):
            هذا.النوع = نوع
            هذا.القيمة = قيمة
            هذا.العقد_الأبناء = []
            هذا.عدد_العقد = 0
            هذا.رقم_السطر = سطر
        
        دالة أضف_طفل(عقدة):
            # إضافة العنصر للمصفوفة بطريقة متوافقة
            هذا.عدد_العقد = هذا.عدد_العقد + 1
        
        دالة اطبع_شجرة(مسافة = ""):
            اطبع(مسافة + هذا.النوع + "[" + هذا.القيمة + "]")
            متغير ط = 0
            بينما ط < طول(هذا.العقد_الأبناء):
                متغير طفل_حالي = هذا.العقد_الأبناء[ط]
                طفل_حالي.اطبع_شجرة(مسافة + "  ")
                ط = ط + 1

# ═══════════════════════════════════════════════════════════
# المحلل النحوي (Parser)
# ═══════════════════════════════════════════════════════════

صف محلل_نحوي:
    خاص:
        مصفوفة الرموز
        رقم الموضع_الحالي
        رقم رقم_السطر_الحالي
        مصفوفة الأخطاء
        
        # كلمات مفتاحية للأوامر
        مصفوفة كلمات_الأوامر = [
            "متغير"، "دالة"، "أرجع"، "إذا"، "وإلا"،
            "بينما"، "لكل"، "من"، "إلى"، "بخطوة"،
            "صنف"، "جديد"، "خاص"، "عام"، "محمي"،
            "اطبع"، "افتح_ملف"، "اقرأ_ملف"، "اكتب_ملف"، "أغلق_ملف"،
            "توقف"، "استمر"، "انتظر"، "استورد"
        ]
    
    عام:
        دالة جديد(رموز):
            هذا.الرموز = رموز
            هذا.الموضع_الحالي = 0
            هذا.رقم_السطر_الحالي = 1
            هذا.الأخطاء = []
        
        # الحصول على الرمز الحالي
        دالة رمز_حالي():
            إذا هذا.الموضع_الحالي >= طول(هذا.الرموز):
                أرجع None
            أرجع هذا.الرموز[هذا.الموضع_الحالي]
        
        # النظر للرمز التالي
        دالة رمز_تالي():
            إذا هذا.الموضع_الحالي + 1 >= طول(هذا.الرموز):
                أرجع None
            أرجع هذا.الرموز[هذا.الموضع_الحالي + 1]
        
        # التقدم للرمز التالي
        دالة تقدم():
            إذا هذا.الموضع_الحالي < طول(هذا.الرموز):
                هذا.الموضع_الحالي = هذا.الموضع_الحالي + 1
                إذا هذا.رمز_حالي():
                    هذا.رقم_السطر_الحالي = هذا.رمز_حالي().رقم_السطر
        
        # التحقق من نوع الرمز
        دالة هو_نوع(نوع):
            متغير رمز = هذا.رمز_حالي()
            أرجع رمز و رمز.النوع == نوع
        
        # التحقق من القيمة
        دالة هو_قيمة(قيمة):
            متغير رمز = هذا.رمز_حالي()
            أرجع رمز و رمز.القيمة == قيمة
        
        # إضافة خطأ
        دالة أضف_خطأ(رسالة):
            متغير خطأ = "خطأ في السطر " + هذا.رقم_السطر_الحالي + ": " + رسالة
            هذا.الأخطاء.أضف(خطأ)
            اطبع(خطأ)
        
        # تخطي الرمز الحالي إذا كان نوع معين
        دالة تخطي_نوع(نوع):
            إذا هذا.هو_نوع(نوع):
                هذا.تقدم()
                أرجع صحيح
            أرجع خطأ
        
        # تخطي رمز معين
        دالة تخطي_رمز(رمز):
            إذا هذا.هو_قيمة(رمز):
                هذا.تقدم()
                أرجع صحيح
            أرجع خطأ
        
        # ═══════════════════════════════════════════════════════════
        # دوال التحليل النحوي
        # ═══════════════════════════════════════════════════════════
        
        # تحليل البرنامج الكامل
        دالة حلل_برنامج():
            مصفوفة الجذور = []
            
            بينما هذا.رمز_حالي():
                إذا هذا.رمز_حالي().النوع == "نهاية_سطر":
                    هذا.تقدم()
                    continue
                
                متغير جذر = هذا.حلل_بيان()
                إذا جذر:
                    الجذور.أضف(جذر)
            
            أرجع الجذور
        
        # تحليل البيان (Statement)
        دالة حلل_بيان():
            إذا ليس هذا.رمز_حالي():
                أرجع None
            
            # تعريف متغير
            إذا هذا.هو_قيمة("متغير"):
                أرجع هذا.حلل_تعريف_متغير()
            
            # تعريف دالة
            إذا هذا.هو_قيمة("دالة"):
                أرجع هذا.حلل_تعريف_دالة()
            
            # إذا
            إذا هذا.هو_قيمة("إذا"):
                أرجع هذا.حلل_إذا()
            
            # بينما
            إذا هذا.هو_قيمة("بينما"):
                أرجع هذا.حلل_بينما()
            
            # لكل
            إذا هذا.هو_قيمة("لكل"):
                أرجع هذا.حلل_لكل()
            
            # صنف
            إذا هذا.هو_قيمة("صنف"):
                أرجع هذا.حلل_تعريف_صف()
            
            # توقف
            إذا هذا.هو_قيمة("توقف"):
                أرجع هذا.حلل_توقف()
            
            # استمر
            إذا هذا.هو_قيمة("استمر"):
                أرجع هذا.حلل_استمر()
            
            # أرجع
            إذا هذا.هو_قيمة("أرجع"):
                أرجع هذا.حلل_أرجع()
            
            # اطبع
            إذا هذا.هو_قيمة("اطبع"):
                أرجع هذا.حلل_اطبع()
            
            # تعبير عادي (تعيين أو استدعاء دالة)
            أرجع هذا.حلل_تعبير()
        
        # تحليل تعريف متغير
        دالة حلل_تعريف_متغير():
            متغير سطر = هذا.رمز_حالي().رقم_السطر
            هذا.تقدم()  # تخطي "متغير"
            
            إذا ليس هذا.هو_نوع("معرف"):
                هذا.أضف_خطأ("اسم المتغير مطلوب بعد متغير")
                أرجع None
            
            متغير اسم_المتغير = هذا.رمز_حالي().القيمة
            هذا.تقدم()
            
            إذا ليس هذا.تخطي_رمز("="):
                هذا.أضف_خطأ("علامة = مطلوبة في تعريف المتغير")
                أرجع None
            
            متغير تعبير = هذا.حلل_تعبير()
            إذا تعبير:
                متغير عقدة = عقدة_تحليل.جديد("تعريف_متغير"، اسم_المتغير، سطر)
                عقدة.أضف_طفل(تعبير)
                أرجع عقدة
            
            هذا.أضف_خطأ("تعبير القيمة مطلوب")
            أرجع None
        
        # تحليل تعبير
        دالة حلل_تعبير():
            أرجع هذا.حلل_تعبير_منطقي()
        
        # تحليل تعبير منطقي (أو)
        دالة حلل_تعبير_منطقي():
            متغير تعبير = هذا.حلل_تعبير_مقارنة()
            
            بينما هذا.رمز_حالي() و (هذا.رمز_حالي().النوع == "أو"):
                متغير عملية = هذا.رمز_حالي().القيمة
                هذا.تقدم()
                
                متغير تعبير_يمين = هذا.حلل_تعبير_مقارنة()
                إذا تعبير_يمين:
                    متغير عقدة_جديدة = عقدة_تحليل.جديد("عملية_ثنائية"، عملية، تعبير.رقم_السطر)
                    عقدة_جديدة.أضف_طفل(تعبير)
                    عقدة_جديدة.أضف_طفل(تعبير_يمين)
                    تعبير = عقدة_جديدة
            
            أرجع تعبير
        
        # تحليل تعبير مقارنة
        دالة حلل_تعبير_مقارنة():
            متغير تعبير = هذا.حلل_تعبير_جمع()
            
            بينما هذا.رمز_حالي():
                متغير رمز = هذا.رمز_حالي()
                إذا رمز.النوع في ["==", "!=", ">", "<", ">=", "<="]:
                    هذا.تقدم()
                    متغير تعبير_يمين = هذا.حلل_تعبير_جمع()
                    إذا تعبير_يمين:
                        متغير عقدة_جديدة = عقدة_تحليل.جديد("عملية_ثنائية"، رمز.النوع، رمز.رقم_السطر)
                        عقدة_جديدة.أضف_طفل(تعبير)
                        عقدة_جديدة.أضف_طفل(تعبير_يمين)
                        تعبير = عقدة_جديدة
                وإلا:
                    توقف
            
            أرجع تعبير
        
        # تحليل تعبير جمع (+, -)
        دالة حلل_تعبير_جمع():
            متغير تعبير = هذا.حلل_تعبير_ضرب()
            
            بينما هذا.رمز_حالي():
                متغير رمز = هذا.رمز_حالي()
                إذا رمز.النوع في ["+", "-"]:
                    هذا.تقدم()
                    متغير تعبير_يمين = هذا.حلل_تعبير_ضرب()
                    إذا تعبير_يمين:
                        متغير عقدة_جديدة = عقدة_تحليل.جديد("عملية_ثنائية"، رمز.النوع، رمز.رقم_السطر)
                        عقدة_جديدة.أضف_طفل(تعبير)
                        عقدة_جديدة.أضف_طفل(تعبير_يمين)
                        تعبير = عقدة_جديدة
                وإلا:
                    توقف
            
            أرجع تعبير
        
        # تحليل تعبير ضرب (*, /, %)
        دالة حلل_تعبير_ضرب():
            متغير تعبير = هذا.حلل_تعبير_أحادي()
            
            بينما هذا.رمز_حالي():
                متغير رمز = هذا.رمز_حالي()
                إذا رمز.النوع في ["*", "/", "%"]:
                    هذا.تقدم()
                    متغير تعبير_يمين = هذا.حلل_تعبير_أحادي()
                    إذا تعبير_يمين:
                        متغير عقدة_جديدة = عقدة_تحليل.جديد("عملية_ثنائية"، رمز.النوع، رمز.رقم_السطر)
                        عقدة_جديدة.أضف_طفل(تعبير)
                        عقدة_جديدة.أضف_طفل(تعبير_يمين)
                        تعبير = عقدة_جديدة
                وإلا:
                    توقف
            
            أرجع تعبير
        
        # تحليل تعبير أحادي (+, -, !)
        دالة حلل_تعبير_أحادي():
            متغير رمز = هذا.رمز_حالي()
            
            إذا رمز و رمز.النوع في ["+", "-", "ليس"]:
                هذا.تقدم()
                متغير تعبير = هذا.حلل_تعبير_أساسي()
                إذا تعبير:
                    متغير عقدة_جديدة = عقدة_تحليل.جديد("عملية_أحادية"، رمز.النوع، رمز.رقم_السطر)
                    عقدة_جديدة.أضف_طفل(تعبير)
                    أرجع عقدة_جديدة
            
            أرجع هذا.حلل_تعبير_أساسي()
        
        # تحليل تعبير أساسي (معرف، رقم، نص، قوسين)
        دالة حلل_تعبير_أساسي():
            متغير رمز = هذا.رمز_حالي()
            
            إذا ليس رمز:
                هذا.أضف_خطأ("تعبير غير متوقع")
                أرجع None
            
            # رقم حرفي
            إذا رمز.النوع == "رقم":
                هذا.تقدم()
                أرجع عقدة_تحليل.جديد("رقم_حرفي"، رمز.القيمة، رمز.رقم_السطر)
            
            # نص حرفي
            إذا رمز.النوع == "نص_حرفي":
                هذا.تقدم()
                أرجع عقدة_تحليل.جديد("نص_حرفي"، رمز.القيمة، رمز.رقم_السطر)
            
            # معرف
            إذا رمز.النوع == "معرف":
                متغير معرف = رمز
                هذا.تقدم()
                
                # التحقق من قوس مربع (وصول لمصفوفة)
                إذا هذا.تخطي_رمز("["):
                    متغير فهرس = هذا.حلل_تعبير()
                    إذا ليس هذا.تخطي_رمز("]"):
                        هذا.أضف_خطأ("قوس مربع إغلاق ] مطلوب")
                        أرجع None
                    
                    متغير عقدة_فهرس = عقدة_تحليل.جديد("وصول_مصفوفة"، معرف.القيمة، معرف.رقم_السطر)
                    عقدة_فهرس.أضف_طفل(فهرس)
                    أرجع عقدة_فهرس
                
                # التحقق من نقطة (وصول لخاصية)
                إذا هذا.تخطي_رمز("."):
                    متغير اسم_الخاصية = هذا.رمز_حالي()
                    إذا اسم_الخاصية و اسم_الخاصية.النوع == "معرف":
                        هذا.تقدم()
                        متغير عقدة_خاصية = عقدة_تحليل.جديد("وصول_خاصية"، معرف.القيمة، معرف.رقم_السطر)
                        عقدة_خاصية.أضف_طفل(عقدة_تحليل.جديد("معرف"، اسم_الخاصية.القيمة، اسم_الخاصية.رقم_السطر))
                        أرجع عقدة_خاصية
                    
                    هذا.أضف_خطأ("اسم الخاصية مطلوب بعد النقطة")
                    أرجع None
                
                # التحقق من قوس فتح (استدعاء دالة)
                إذا هذا.تخطي_رمز("("):
                    مصفوفة الوسائط = []
                    
                    إذا ليس هذا.تخطي_رمز(")"):
                        بينما صحيح:
                            متغير وسيط = هذا.حلل_تعبير()
                            إذا وسيط:
                                الوسائط.أضف(وسيط)
                            
                            إذا هذا.تخطي_رمز(")"):
                                توقف
                            
                            إذا ليس هذا.تخطي_رمز("،"):
                                هذا.أضف_خطأ("فاصلة أو قوس إغلاق مطلوب")
                                توقف
                    
                    متغير عقدة_استدعاء = عقدة_تحليل.جديد("استدعاء_دالة"، معرف.القيمة، معرف.رقم_السطر)
                    لكل وسيط in الوسائط:
                        عقدة_استدعاء.أضف_طفل(وسيط)
                    أرجع عقدة_استدعاء
                
                # معرف عادي
                أرجع عقدة_تحليل.جديد("معرف"، معرف.القيمة، معرف.رقم_السطر)
            
            # قوس فتح
            إذا هذا.تخطي_رمز("("):
                متغير تعبير = هذا.حلل_تعبير()
                إذا ليس هذا.تخطي_رمز(")"):
                    هذا.أضف_خطأ("قوس إغلاق ) مطلوب")
                أرجع تعبير
            
            هذا.أضف_خطأ("تعبير غير متوقع: " + رمز.النوع)
            هذا.تقدم()
            أرجع None
        
        # تحليل إذا
        دالة حلل_إذا():
            متغير سطر = هذا.رمز_حالي().رقم_السطر
            هذا.تقدم()  # تخطي "إذا"
            
            إذا ليس هذا.تخطي_رمز("("):
                هذا.أضف_خطأ("قوس فتح ( مطلوب بعد إذا")
                أرجع None
            
            متغير شرط = هذا.حلل_تعبير()
            
            إذا ليس هذا.تخطي_رمز(")"):
                هذا.أضف_خطأ("قوس إغلاق ) مطلوب بعد الشرط")
                أرجع None
            
            إذا ليس هذا.تخطي_رمز(":"):
                هذا.أضف_خطأ("نقطتان : مطلوبتان بعد شرط إذا")
                أرجع None
            
            مصفوفة الجسم = []
            بينما هذا.رمز_حالي() و ليس هذا.رمز_حالي().النوع في ["وإلا", "نهاية_سطر"]:
                متغير بيان = هذا.حلل_بيان()
                إذا بيان:
                    الجسم.أضف(بيان)
            
            متغير عقدة_إذا = عقدة_تحليل.جديد("إذا"، ""، سطر)
            عقدة_إذا.أضف_طفل(شرط)
            عقدة_إذا.أضف_طفل(عقدة_تحليل.جديد("كتلة"، ""، سطر))
            
            لكل بيان in الجسم:
                عقدة_إذا.العقد_الأبناء[1].أضف_طفل(بيان)
            
            # التحقق من "وإلا"
            إذا هذا.تخطي_رمز("وإلا"):
                إذا ليس هذا.تخطي_رمز(":"):
                    هذا.أضف_خطأ("نقطتان : مطلوبتان بعد وإلا")
                    أرجع عقدة_إذا
                
