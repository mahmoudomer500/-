// ── 9. اختبار المعادلات ──
اطبع("━━━ 9. المعادلات ━━━")

// حل معادلة من الدرجة الثانية: x² - 5x + 6 = 0
// الجذور: x = 2, x = 3
أ = 1
ب = -5
ج = 6
المميز = قوة(ب, 2) - 4 * أ * ج
اطبع("المميز =", المميز, "(المتوقع: 1)")

إذا المميز >= 0:
    جذر_مميز = جذر(المميز)
    س1 = (-ب + جذر_مميز) / (2 * أ)
    س2 = (-ب - جذر_مميز) / (2 * أ)
    اطبع("الجذر الأول =", س1, "(المتوقع: 3)")
    اطبع("الجذر الثاني =", س2, "(المتوقع: 2)")
وإلا:
    اطبع("لا توجد جذور حقيقية")

