// اختبار شامل لمكتبة المصفوفات
// ══════════════════════════════════════════════════════════════

اطبع("═══════════════════════════════════════════")
اطبع("  اختبار مكتبة المصفوفات")
اطبع("═══════════════════════════════════════════")
اطبع("")

// ── 1. إنشاء وإضافة عناصر ──
اطبع("━━━ 1. إنشاء وإضافة عناصر ━━━")

أضف(أرقام, 10)
أضف(أرقام, 20)
أضف(أرقام, 30)
أضف(أرقام, 40)
أضف(أرقام, 50)

اطبع("المصفوفة:", أرقام)
اطبع("الطول:", طول(أرقام), "(المتوقع: 5)")

اطبع("")

// ── 2. الوصول للعناصر ──
اطبع("━━━ 2. الوصول للعناصر ━━━")

اطبع("العنصر الأول:", أرقام[0], "(المتوقع: 10)")
اطبع("العنصر الأخير:", أرقام[4], "(المتوقع: 50)")
اطبع("العنصر الأوسط:", أرقام[2], "(المتوقع: 30)")

اطبع("")

// ── 3. تعديل العناصر ──
اطبع("━━━ 3. تعديل العناصر ━━━")

أرقام[1] = 25
اطبع("بعد تعديل العنصر الثاني:", أرقام)
اطبع("العنصر الثاني الآن:", أرقام[1], "(المتوقع: 25)")

اطبع("")

// ── 4. البحث ──
اطبع("━━━ 4. البحث ━━━")

// بحث خطي
مؤشر = -1
لكل i من 0 إلى طول(أرقام) - 1:
    إذا أرقام[i] == 30:
        مؤشر = i
        توقف
اطبع("البحث عن 30: الفهرس =", مؤشر, "(المتوقع: 2)")

مؤشر2 = -1
لكل i من 0 إلى طول(أرقام) - 1:
    إذا أرقام[i] == 99:
        مؤشر2 = i
        توقف
اطبع("البحث عن 99: الفهرس =", مؤشر2, "(المتوقع: -1)")

اطبع("")

// ── 5. الجمع والمتوسط ──
اطبع("━━━ 5. الجمع والمتوسط ━━━")

مجموع = 0
لكل عنصر في أرقام:
    مجموع = مجموع + عنصر
اطبع("المجموع =", مجموع)

عدد = طول(أرقام)
متوسط = مجموع / عدد
اطبع("المتوسط =", متوسط)

اطبع("")

// ── 6. القيم القصوى والدنيا ──
اطبع("━━━ 6. القيم القصوى والدنيا ━━━")

أقصى = أرقام[0]
أدنى = أرقام[0]
لكل عنصر في أرقام:
    إذا عنصر > أقصى:
        أقصى = عنصر
    إذا عنصر < أدنى:
        أدنى = عنصر
اطبع("أقصى قيمة =", أقصى, "(المتوقع: 50)")
اطبع("أدنى قيمة =", أدنى, "(المتوقع: 10)")

اطبع("")

// ── 7. الفرز التصاعدي ──
اطبع("━━━ 7. الفرز التصاعدي ━━━")

أضف(غير_مرتبة, 5)
أضف(غير_مرتبة, 3)
أضف(غير_مرتبة, 8)
أضف(غير_مرتبة, 1)
أضف(غير_مرتبة, 9)
أضف(غير_مرتبة, 2)

اطبع("قبل الفرز:", غير_مرتبة)

// Bubble Sort
ن = طول(غير_مرتبة)
لكل i من 0 إلى ن - 1:
    لكل j من 0 إلى ن - i - 2:
        إذا غير_مرتبة[j] > غير_مرتبة[j + 1]:
            مؤقت = غير_مرتبة[j]
            غير_مرتبة[j] = غير_مرتبة[j + 1]
            غير_مرتبة[j + 1] = مؤقت

اطبع("بعد الفرز:", غير_مرتبة, "(المتوقع: [1, 2, 3, 5, 8, 9])")

اطبع("")

// ── 8. الفرز التنازلي ──
اطبع("━━━ 8. الفرز التنازلي ━━━")

ن2 = طول(غير_مرتبة)
لكل i من 0 إلى ن2 - 1:
    لكل j من 0 إلى ن2 - i - 2:
        إذا غير_مرتبة[j] < غير_مرتبة[j + 1]:
            مؤقت2 = غير_مرتبة[j]
            غير_مرتبة[j] = غير_مرتبة[j + 1]
            غير_مرتبة[j + 1] = مؤقت2

اطبع("تنازلي:", غير_مرتبة, "(المتوقع: [9, 8, 5, 3, 2, 1])")

اطبع("")

// ── 9. عكس المصفوفة ──
اطبع("━━━ 9. عكس المصفوفة ━━━")

أضف(عكس_تجربة, 1)
أضف(عكس_تجربة, 2)
أضف(عكس_تجربة, 3)
أضف(عكس_تجربة, 4)
أضف(عكس_تجربة, 5)

اطبع("قبل العكس:", عكس_تجربة)

// عكس يدوي
طول_عكس = طول(عكس_تجربة)
لكل i من 0 إلى طول_عكس / 2 - 1:
    مؤقت3 = عكس_تجربة[i]
    عكس_تجربة[i] = عكس_تجربة[طول_عكس - 1 - i]
    عكس_تجربة[طول_عكس - 1 - i] = مؤقت3

اطبع("بعد العكس:", عكس_تجربة, "(المتوقع: [5, 4, 3, 2, 1])")

اطبع("")

// ── 10. مصفوفة النصوص ──
اطبع("━━━ 10. مصفوفة النصوص ━━━")

أضف(أسماء, "أحمد")
أضف(أسماء, "محمد")
أضف(أسماء, "فاطمة")
أضف(أسماء, "علي")

اطبع("الأسماء:")
لكل i من 0 إلى طول(أسماء) - 1:
    اطبع("  ", i + 1, ".", أسماء[i])

اطبع("")

// ── 11. التكرار عبر المصفوفة ──
اطبع("━━━ 11. التكرار عبر المصفوفة ━━━")

اطبع("عبر 'لكل عنصر في':")
لكل اسم في أسماء:
    اطبع("  مرحبا,", اسم)

اطبع("")

// ── 12. مصفوفة مختلطة ──
اطبع("━━━ 12. مصفوفة مختلطة ━━━")

أضف(مختلطة, 1)
أضف(مختلطة, "نص")
أضف(مختلطة, 3.14)
أضف(مختلطة, صحيح)
أضف(مختلطة, خطأ)

اطبع("مصفوفة مختلطة:")
لكل i من 0 إلى طول(مختلطة) - 1:
    اطبع("  عنصر", i, "=", مختلطة[i], "النوع:", نوع(مختلطة[i]))

اطبع("")
