// ══════════════════════════════════════════════════════════════
// اختبار شامل لمكتبة النظام
// ══════════════════════════════════════════════════════════════

اطبع("═══════════════════════════════════════════")
اطبع("  اختبار مكتبة النظام")
اطبع("═══════════════════════════════════════════")
اطبع("")

// ── 1. الانتظار ──
اطبع("━━━ 1. الانتظار ━━━")

اطبع("قبل الانتظار...")
انتظر(100)
اطبع("بعد الانتظار 100 مللي ثانية")

اطبع("")

// ── 2. نوع القيمة ──
اطبع("━━━ 2. نوع القيمة ━━━")

اطبع("نوع(42) =", نوع(42))
اطبع("نوع('مرحبا') =", نوع("مرحبا"))
اطبع("نوع(لاشيء) =", نوع(لاشيء))
اطبع("نوع(صحيح) =", نوع(صحيح))
اطبع("نوع(خطأ) =", نوع(خطأ))

اطبع("")

// ── 3. الثوابت المنطقية ──
اطبع("━━━ 3. الثوابت المنطقية ━━━")

اطبع("صحيح =", صحيح, "(المتوقع: 1)")
اطبع("خطأ =", خطأ, "(المتوقع: 0)")
اطبع("لاشيء =", نوع(لاشيء))

اطبع("")

// ── 4. العمليات المنطقية ──
اطبع("━━━ 4. العمليات المنطقية ━━━")

إذا صحيح و صحيح:
    اطبع("صحيح و صحيح = صحيح")
وإلا:
    اطبع("صحيح و صحيح = خطأ")

إذا صحيح أو خطأ:
    اطبع("صحيح أو خطأ = صحيح")
وإلا:
    اطبع("صحيح أو خطأ = خطأ")

إذا ليس خطأ:
    اطبع("ليس خطأ = صحيح")
وإلا:
    اطبع("ليس خطأ = خطأ")

اطبع("")

// ── 5. المقارنات ──
اطبع("━━━ 5. المقارنات ━━━")

إذا 5 > 3:
    اطبع("5 > 3 : صحيح")
إذا 5 >= 5:
    اطبع("5 >= 5: صحيح")
إذا 3 < 5:
    اطبع("3 < 5 : صحيح")
إذا 3 <= 3:
    اطبع("3 <= 3: صحيح")
إذا 5 == 5:
    اطبع("5 == 5: صحيح")
إذا 5 != 3:
    اطبع("5 != 3: صحيح")

اطبع("")

// ── 6. العمليات الحسابية ──
اطبع("━━━ 6. العمليات الحسابية ━━━")

اطبع("10 + 3 =", 10 + 3)
اطبع("10 - 3 =", 10 - 3)
اطبع("10 * 3 =", 10 * 3)
اطبع("10 / 3 =", 10 / 3)
اطبع("10 % 3 =", 10 % 3)

اطبع("")

// ── 7. حلقة while ──
اطبع("━━━ 7. حلقة while ━━━")

عداد = 1
طالما عداد <= 5:
    اطبع("  العداد =", عداد)
    عداد = عداد + 1

اطبع("")

// ── 8. حلقة for ──
اطبع("━━━ 8. حلقة for ━━━")

لكل i من 1 إلى 5:
    اطبع("  i =", i)

اطبع("")

// ── 9. الشروط المتعددة ──
اطبع("━━━ 9. الشروط المتعددة ━━━")

درجة = 85

إذا درجة >= 90:
    اطبع("الدرجة", درجة, ": ممتاز")
وإلا إذا درجة >= 80:
    اطبع("الدرجة", درجة, ": جيد جداً")
وإلا إذا درجة >= 70:
    اطبع("الدرجة", درجة, ": جيد")
وإلا:
    اطبع("الدرجة", درجة, ": يحتاج تحسين")

اطبع("")
اطبع("═══════════════════════════════════════════")
اطبع("  ✅ اكتمل اختبار النظام بنجاح")
اطبع("═══════════════════════════════════════════")
