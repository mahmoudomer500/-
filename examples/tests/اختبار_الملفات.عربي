اطبع("═══════════════════════════════════════════")
اطبع("  اختبار مكتبة الملفات")
اطبع("═══════════════════════════════════════════")
اطبع("")

// ── 1. كتابة وقراءة ملف نصي ──
اطبع("━━━ 1. كتابة وقراءة ملف نصي ━━━")

اكتب_ملف("اختبار_كتابة.txt", "هذا نص تجريبي للاختبار")
محتوى = اقرأ_ملف("اختبار_كتابة.txt")
اطبع("المحتوى المكتوب:", محتوى)

اكتب_ملف("اختبار_كتابة.txt", "محتوى جديد تم استبداله")
محتوى_جديد = اقرأ_ملف("اختبار_كتابة.txt")
اطبع("بعد الاستبدال:", محتوى_جديد)

اطبع("")

// ── 2. فتح ملف وقراءة سطر بسطر ──
اطبع("━━━ 2. فتح ملف وقراءة سطر بسطر ━━━")

اكتب_ملف("اختبار_أسطر.txt", "السطر الأول" + "\n" + "السطر الثاني" + "\n" + "السطر الثالث")

مقبض = افتح_ملف("اختبار_أسطر.txt", "r")
إذا مقبض != "0":
    سطر1 = اقرأ_سطر(مقبض)
    اطبع("السطر 1:", سطر1)
    سطر2 = اقرأ_سطر(مقبض)
    اطبع("السطر 2:", سطر2)
    سطر3 = اقرأ_سطر(مقبض)
    اطبع("السطر 3:", سطر3)
    أغلق_ملف(مقبض)
وإلا:
    اطبع("❌ فشل فتح الملف")

اطبع("")

// ── 3. قراءة الملف كاملاً ──
اطبع("━━━ 3. قراءة الملف كاملاً ━━━")

مقبض2 = افتح_ملف("اختبار_أسطر.txt", "r")
إذا مقبض2 != "0":
    كل_المحتوى = اقرأ_كل(مقبض2)
    اطبع("كل المحتوى:")
    اطبع(كل_المحتوى)
    أغلق_ملف(مقبض2)
وإلا:
    اطبع("❌ فشل فتح الملف")

اطبع("")

// ── 4. التحقق من وجود ملف ──
اطبع("━━━ 4. التحقق من وجود ملف ━━━")

موجود1 = هل_ملف_موجود("اختبار_كتابة.txt")
اطبع("هل 'اختبار_كتابة.txt' موجود:", موجود1, "(المتوقع: 1)")

موجود2 = هل_ملف_موجود("غير_موجود.txt")
اطبع("هل 'غير_موجود.txt' موجود:", موجود2, "(المتوقع: 0)")

اطبع("")

// ── 5. المجلد الحالي ──
اطبع("━━━ 5. المجلد الحالي ━━━")

مجلد = المجلد_الحالي()
اطبع("المجلد الحالي:", مجلد)

اطبع("")

// ── 6. قائمة الملفات ──
اطبع("━━━ 6. قائمة الملفات ━━━")

ملفات = قائمة_الملفات(".")
اطبع("عدد الملفات في المجلد الحالي:", طول(ملفات))
لكل i من 0 إلى طول(ملفات) - 1:
    إذا i < 10:
        اطبع("  ملف", i, "=", ملفات[i])

اطبع("")

// ── 7. كتابة متعددة ──
اطبع("━━━ 7. كتابة متعددة ━━━")

اكتب_ملف("اختبار_متعدد.txt", "السطر الأول\n")
اكتب_ملف("اختبار_متعدد.txt", "السطر الثاني\n")
اطبع("تم الكتابة بنجاح")

محتوى_متعدد = اقرأ_ملف("اختبار_متعدد.txt")
اطبع("المحتوى:", محتوى_متعدد)

اطبع("")
