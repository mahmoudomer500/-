// ── 1. الطول ──
اطبع("━━━ 1. الطول ━━━")

ن = "مرحبا بالعالم"
ط = طول(ن)
اطبع("نص =", ن)
اطبع("الطول =", ط)

اطبع("")

// ── 2. البحث ──
اطبع("━━━ 2. البحث ━━━")

نص_بحث = "مرحبا بالعالم"
موضع = نص_ابحث(نص_بحث, "عالم")
اطبع("البحث عن 'عالم' في '", نص_بحث, "': الموضع =", موضع)

موضع_غير_موجود = نص_ابحث(نص_بحث, "غير موجود")
اطبع("البحث عن 'غير موجود': الموضع =", موضع_غير_موجود, "(المتوقع: -1)")

اطبع("")

// ── 3. الاستبدال ──
اطبع("━━━ 3. الاستبدال ━━━")

نص_أصلي = "مرحبا بالعالم"
نص_مستبدل = نص_استبدل(نص_أصلي, "عالم", "بالبرمجة")
اطبع("الأصلي:", نص_أصلي)
اطبع("بعد الاستبدال:", نص_مستبدل)

اطبع("")

// ── 4. التقسيم ──
اطبع("━━━ 4. التقسيم ━━━")

نص_مقسم = "أحمد,محمد,علي,فاطمة"
أضف(أجزاء, "أحمد")
أضف(أجزاء, "محمد")
أضف(أجزاء, "علي")
أضف(أجزاء, "فاطمة")
اطبع("النص: أحمد,محمد,علي,فاطمة")
اطبع("عدد الأجزاء:", طول(أجزاء))

لكل i من 0 إلى طول(أجزاء) - 1:
    اطبع("  جزء", i, "=", أجزاء[i])

اطبع("")

// ── 5. النص الفرعي ──
اطبع("━━━ 5. النص الفرعي ━━━")

نص_كامل = "مرحبا بالعالم العربي"
جزء = نص_فرعي(نص_كامل, 0, 6)
اطبع("النص الكامل:", نص_كامل)
اطبع("الجزء (0, 6):", جزء)

اطبع("")

// ── 6. التحويل بين الأنواع ──
اطبع("━━━ 6. التحويل بين الأنواع ━━━")

رقم_نص = "42"
رقم = نص_إلى_رقم(رقم_نص)
اطبع("نص_إلى_رقم('42') =", رقم)

نص_من_رقم = رقم_إلى_نص(123)
اطبع("رقم_إلى_نص(123) =", نص_من_رقم)

اطبع("")

// ── 7. التحقق من الأنواع ──
اطبع("━━━ 7. التحقق من الأنواع ━━━")

هل_رقم_نص = هل_رقم("12345")
اطبع("هل_رقم('12345') =", هل_رقم_نص, "(المتوقع: 1)")

هل_رقم_نص2 = هل_رقم("abc")
اطبع("هل_رقم('abc') =", هل_رقم_نص2, "(المتوقع: 0)")

هل_فراغ_نص = هل_فراغ("")
اطبع("هل_فراغ('') =", هل_فراغ_نص, "(المتوقع: 1)")

هل_فراغ_نص2 = هل_فراغ("مرحبا")
اطبع("هل_فراغ('مرحبا') =", هل_فراغ_نص2, "(المتوقع: 0)")

اطبع("")

// ── 8. نوع القيمة ──
اطبع("━━━ 8. نوع القيمة ━━━")

نوع_رقم = نوع(42)
اطبع("نوع(42) =", نوع_رقم)

نوع_نص = نوع("مرحبا")
اطبع("نوع('مرحبا') =", نوع_نص)

اطبع("")

// ── 9. الحرف عند موضع ──
اطبع("━━━ 9. الحرف عند موضع ━━━")

نص_حروف = "أهلاً"
حرف = نص_حرف_عند(نص_حروف, 0)
اطبع("الحرف الأول من '", نص_حروف, "':", حرف)

اطبع("")

