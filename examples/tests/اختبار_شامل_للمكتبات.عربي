// إنشاء
أضف(أرقام, 5)
أضف(أرقام, 3)
أضف(أرقام, 8)
أضف(أرقام, 1)
أضف(أرقام, 9)
اطبع("✓ المصفوفة:", أرقام)
اطبع("✓ الطول:", طول(أرقام))

// وصول
اطبع("✓ العنصر الأول:", أرقام[0])
اطبع("✓ العنصر الأخير:", أرقام[4])

// تعديل
أرقام[2] = 100
اطبع("✓ بعد التعديل:", أرقام)

// بحث
مؤشر = -1
لكل i من 0 إلى طول(أرقام) - 1:
    إذا أرقام[i] == 100:
        مؤشر = i
        توقف
اطبع("✓ البحث عن 100: الفهرس =", مؤشر)

// فرز (Bubble Sort)
ن = طول(أرقام)
لكل i من 0 إلى ن - 1:
    لكل j من 0 إلى ن - i - 2:
        إذا أرقام[j] > أرقام[j + 1]:
            مؤقت = أرقام[j]
            أرقام[j] = أرقام[j + 1]
            أرقام[j + 1] = مؤقت
اطبع("✓ بعد الفرز:", أرقام)

// عكس
لكل i من 0 إلى ن / 2 - 1:
    مؤقت2 = أرقام[i]
    أرقام[i] = أرقام[ن - 1 - i]
    أرقام[ن - 1 - i] = مؤقت2
اطبع("✓ بعد العكس:", أرقام)

