دالة جمع(أ، ب):
    أرجع أ + ب

دالة ترحيب(اسم):
    أرجع "مرحباً " + اسم

دالة عاملي(ن):
    إذا ن <= 1:
        أرجع 1
    وإلا:
        أرجع ن * عاملي(ن - 1)

