# اختبار التطبيقات التجريبية للمترجم العربي
# هذا الملف يختبر جميع التطبيقات التي تم تطويرها في الأسبوع الرابع

استورد "Arabic2DGame.h"

# ────────────────────────────────────────────────────────
# اختبار لعبة المنصة 2D
# ────────────────────────────────────────────────────────

دالة اختبار_لعبة_المنصة() {
    اكتب "🚀 بدء اختبار لعبة المنصة 2D العربية...\n"

    # إنشاء كائن اللعبة
    لعبة_منصة = Arabic2DGame()

    # تهيئة اللعبة
    اذا لعبة_منصة.تهيئة() {
        اكتب "✅ تم تهيئة اللعبة بنجاح\n"

        # تشغيل اللعبة لفترة قصيرة للاختبار
        اكتب "🎮 تشغيل اللعبة لمدة 5 ثوانٍ للاختبار...\n"
        لعبة_منصة.تشغيل_للاختبار(5.0)  # دالة افتراضية للاختبار

        # اختبار الحصول على النقاط والأرواح
        نقاط = لعبة_منصة.احصل_النقاط()
        أرواح = لعبة_منصة.احصل_الأرواح()

        اكتب "📊 النقاط: " + نقاط + " | الأرواح: " + أرواح + "\n"

        # إيقاف اللعبة
        لعبة_منصة.أوقف()
        اكتب "✅ انتهى اختبار اللعبة\n"

    } وإلا {
        اكتب "❌ فشل في تهيئة اللعبة\n"
    }
}

# ────────────────────────────────────────────────────────
# اختبار محرر النصوص العربي
# ────────────────────────────────────────────────────────

دالة اختبار_محرر_النصوص() {
    اكتب "📝 بدء اختبار محرر النصوص العربي...\n"

    # إنشاء كائن المحرر
    محرر = ArabicTextEditorApp()

    # تهيئة المحرر
    اذا محرر.تهيئة() {
        اكتب "✅ تم تهيئة المحرر بنجاح\n"

        # اختبار الكتابة والحفظ
        نص_اختبار = "مرحباً بالعالم العربي!\nهذا اختبار لمحرر النصوص العربي.\n\n"
        نص_اختبار += "يمكننا كتابة نصوص عربية مع دعم كامل للغة العربية.\n"
        نص_اختبار += "المحرر يدعم الحفظ والتحميل من الملفات.\n"

        # محاكاة الكتابة في المحرر
        محرر.اكتب_النص(نص_اختبار)

        # حفظ الملف
        مسار_الملف = "test_arabic_text.txt"
        اذا محرر.احفظ_الملف(مسار_الملف) {
            اكتب "✅ تم حفظ الملف: " + مسار_الملف + "\n"
        } وإلا {
            اكتب "❌ فشل في حفظ الملف\n"
        }

        # تحميل الملف ومقارنة المحتوى
        اذا محرر.احمل_الملف(مسار_الملف) {
            نص_محمل = محرر.احصل_النص()
            اذا نص_محمل == نص_اختبار {
                اكتب "✅ تم تحميل الملف وتطابق المحتوى\n"
            } وإلا {
                اكتب "❌ المحتوى المحمل لا يتطابق\n"
            }
        } وإلا {
            اكتب "❌ فشل في تحميل الملف\n"
        }

        # إيقاف المحرر
        محرر.أوقف()
        اكتب "✅ انتهى اختبار المحرر\n"

    } وإلا {
        اكتب "❌ فشل في تهيئة المحرر\n"
    }
}

# ────────────────────────────────────────────────────────
# اختبار أداة الرسم
# ────────────────────────────────────────────────────────

دالة اختبار_أداة_الرسم() {
    اكتب "🎨 بدء اختبار أداة الرسم العربية...\n"

    # إنشاء كائن أداة الرسم
    أداة_رسم = ArabicDrawingApp()

    # تهيئة الأداة
    اذا أداة_رسم.تهيئة() {
        اكتب "✅ تم تهيئة أداة الرسم بنجاح\n"

        # اختبار الرسم
        اكتب "🖌️ اختبار الرسم بالقلم...\n"

        # محاكاة رسم خط
        نقاط_الخط = [
            [100, 100],
            [150, 120],
            [200, 140],
            [250, 160]
        ]

        أداة_رسم.ارسم_خط(نقاط_الخط, "أسود", 2.0)

        # رسم مستطيل
        أداة_رسم.ارسم_مستطيل([300, 100, 100, 80], "أزرق", صحيح)

        # رسم دائرة
        أداة_رسم.ارسم_دائرة([500, 150, 50], "أحمر", صحيح)

        عدد_الضربات = أداة_رسم.احصل_عدد_الضربات()
        اكتب "📊 عدد الضربات المرسومة: " + عدد_الضربات + "\n"

        # حفظ الصورة
        مسار_الصورة = "test_drawing.png"
        اذا أداة_رسم.احفظ_الصورة(مسار_الصورة) {
            اكتب "✅ تم حفظ الصورة: " + مسار_الصورة + "\n"
        } وإلا {
            اكتب "❌ فشل في حفظ الصورة\n"
        }

        # مسح اللوحة
        أداة_رسم.امسح_اللوحة()
        اكتب "🧽 تم مسح اللوحة\n"

        # إيقاف الأداة
        أداة_رسم.أوقف()
        اكتب "✅ انتهى اختبار أداة الرسم\n"

    } وإلا {
        اكتب "❌ فشل في تهيئة أداة الرسم\n"
    }
}

# ────────────────────────────────────────────────────────
# اختبار تطبيق إدارة المهام
# ────────────────────────────────────────────────────────

دالة اختبار_إدارة_المهام() {
    اكتب "📋 بدء اختبار تطبيق إدارة المهام...\n"

    # إنشاء كائن إدارة المهام
    مدير_مهام = ArabicTaskManagerApp()

    # تهيئة التطبيق
    اذا مدير_مهام.تهيئة() {
        اكتب "✅ تم تهيئة تطبيق إدارة المهام بنجاح\n"

        # إضافة مهام تجريبية
        مهام_اختبار = [
            ["إنهاء مشروع المترجم العربي", "إكمال جميع المتطلبات والاختبارات"],
            ["كتابة التقرير النهائي", "توثيق جميع الميزات والتحسينات"],
            ["اختبار الأداء", "قياس سرعة المترجم واستخدام الذاكرة"],
            ["إعداد الوثائق", "كتابة دليل المستخدم والمطور"]
        ]

        اكتب "➕ إضافة مهام تجريبية...\n"
        لكل مهمة في مهام_اختبار {
            مدير_مهام.أضف_مهمة(مهمة[0], مهمة[1])
        }

        عدد_المهام = مدير_مهام.احصل_عدد_المهام()
        اكتب "📊 عدد المهام المضافة: " + عدد_المهام + "\n"

        # تبديل حالة بعض المهام
        اكتب "✅ تحديث حالة بعض المهام...\n"
        مدير_مهام.بدل_حالة_مهمة(1)  # إكمال المهمة الأولى
        مدير_مهام.بدل_حالة_مهمة(3)  # إكمال المهمة الثالثة

        عدد_المكتملة = مدير_مهام.احصل_عدد_المكتملة()
        اكتب "📈 عدد المهام المكتملة: " + عدد_المكتملة + "\n"

        # حذف مهمة
        اكتب "🗑️ حذف مهمة...\n"
        مدير_مهام.احذف_مهمة(2)  # حذف المهمة الثانية

        عدد_المهام_الجديد = مدير_مهام.احصل_عدد_المهام()
        اكتب "📊 عدد المهام بعد الحذف: " + عدد_المهام_الجديد + "\n"

        # مسح المهام المكتملة
        اكتب "🧹 مسح المهام المكتملة...\n"
        مدير_مهام.امسح_المكتملة()

        عدد_المهام_النهائي = مدير_مهام.احصل_عدد_المهام()
        اكتب "📊 عدد المهام بعد المسح: " + عدد_المهام_النهائي + "\n"

        # إيقاف التطبيق
        مدير_مهام.أوقف()
        اكتب "✅ انتهى اختبار إدارة المهام\n"

    } وإلا {
        اكتب "❌ فشل في تهيئة تطبيق إدارة المهام\n"
    }
}

# ────────────────────────────────────────────────────────
# الدالة الرئيسية للاختبار
# ────────────────────────────────────────────────────────

دالة رئيسية() {
    اكتب "🎯 بدء اختبار التطبيقات التجريبية للمترجم العربي\n"
    اكتب "=" * 60 + "\n"

    # اختبار جميع التطبيقات
    اختبار_لعبة_المنصة()
    اكتب "\n"

    اختبار_محرر_النصوص()
    اكتب "\n"

    اختبار_أداة_الرسم()
    اكتب "\n"

    اختبار_إدارة_المهام()
    اكتب "\n"

    اكتب "=" * 60 + "\n"
    اكتب "🎉 انتهى جميع اختبارات التطبيقات التجريبية!\n"
    اكتب "📈 تم تطوير واختبار 4 تطبيقات تجريبية:\n"
    اكتب "   1. لعبة منصة 2D عربية\n"
    اكتب "   2. محرر نصوص عربي\n"
    اكتب "   3. أداة رسم عربية\n"
    اكتب "   4. تطبيق إدارة مهام\n"

    أعد 0
}
