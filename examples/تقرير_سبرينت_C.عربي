# تقرير_انجاز_سبرينت_C
# تقرير فحص إنجاز سبرينت C بناءً على الملفات الموجودة

# استيراد المكونات
محلل_لغوي = استورد "محلل_لغوي"
محلل_نحوي = استورد "محلل_نحوي"
مولد_كود = استورد "مولد_كود"

دالة تقرير_انجاز_سبرينت_C():
    اطبع("=" * 60)
    اطبع("📋 تقرير فحص إنجاز سبرينت C")
    اطبع("=" * 60)
    
    # فحص وجود الملفات الأساسية
    اطبع("1️⃣ فحص الملفات الأساسية:")
    
    # فحص المحلل اللغوي
    متغير له_محلل_لغوي = ملف_موجود("محلل_لغوي.عربي")
    إذا له_محلل_لغوي:
        اطبع("   ✅ محلل_لغوي.عربي - موجود")
    وإلا:
        اطبع("   ❌ محلل_لغوي.عربي - مفقود")
    
    # فحص المحلل النحوي
    متغير له_محلل_نحوي = ملف_موجود("محلل_نحوي.عربي")
    إذا له_محلل_نحوي:
        اطبع("   ✅ محلل_نحوي.عربي - موجود")
    وإلا:
        اطبع("   ❌ محلل_نحوي.عربي - مفقود")
    
    # فحص مولد الكود
    متغير له_مولد_كود = ملف_موجود("مولد_كود.عربي")
    إذا له_مولد_كود:
        اطبع("   ✅ مولد_كود.عربي - موجود")
    وإلا:
        اطبع("   ❌ مولد_كود.عربي - مفقود")
    
    اطبع("\n2️⃣ فحص متطلبات سبرينت C:")
    
    # الهدف 1: بناء محلل لغوي عربي
    إذا له_محلل_لغوي:
        اطبع("   ✅ بناء Lexer عربي - مكتمل")
        متغير محلل = محلل_لغوي.جديد("متغير أ = 5")
        متغير رموز = محلل.حلل()
        إذا طول(رموز) > 0:
            اطبع(f"      ✅ اختبار المحلل اللغوي نجح - {طول(رموز)} رمز")
        وإلا:
            اطبع("      ❌ فشل اختبار المحلل اللغوي")
    وإلا:
        اطبع("   ❌ بناء Lexer عربي - غير مكتمل")
    
    # الهدف 2: بناء محلل نحوي عربي وإنتاج AST
    إذا له_محلل_نحوي:
        اطبع("   ✅ بناء Parser عربي - مكتمل")
        
        # اختبار المحلل النحوي مع رمز بسيط
        متغير كود_اختبار = "متغير العدد = 42"
        متغير محلل_نحوي_اختبار = محلل_نحوي.جديد([رموز.جديد("متغير"، "متغير"، 1), رموز.جديد("معرف"، "العدد"، 1), رموز.جديد("="، "="، 1), رموز.جديد("رقم"، "42"، 1)])
        
        إذا محلل_نحوي_اختبار:
            اطبع("      ✅ إنشاء Parser نجح")
        وإلا:
           اطبع("      ❌ فشل إنشاء Parser")
    وإلا:
        اطبع("   ❌ بناء Parser عربي - غير مكتمل")
    
    # الهدف 3: ربط AST العربي بمولد الكود وتشغيل برامج بسيطة
    إذا له_مولد_كود:
        اطبع("   ✅ بناء مولد كود عربي - مكتمل")
        
        # اختبار مولد الكود
        متغير مولد = مولد_كود.جديد()
        إذا مولد:
            اطبع("      ✅ إنشاء مولد الكود نجح")
        وإلا:
            اطبع("      ❌ فشل إنشاء مولد الكود")
    وإلا:
        اطبع("   ❌ بناء مولد كود عربي - غير مكتمل")
    
    # النتيجة النهائية
    اطبع("\n3️⃣ النتيجة النهائية:")
    
    متغير عدد_المكونات_المكتملة = 0
    إذا له_محلل_لغوي:
        عدد_المكونات_المكتملة = عدد_المكونات_المكتملة + 1
    إذا له_محلل_نحوي:
        عدد_المكونات_المكتملة = عدد_المكونات_المكتملة + 1
    إذا له_مولد_كود:
        عدد_المكونات_المكتملة = عدد_المكونات_المكتملة + 1
    
    إذا عدد_المكونات_المكتملة == 3:
        اطبع("   ✅ سبرينت C مكتمل بنسبة 100%")
        اطبع("   🎉 جميع المتطلبات الثلاثة متوفرة")
    وإلا إذا عدد_المكونات_المكتملة >= 2:
        متغير نسبة_الانجاز = (عدد_المكونات_المكتملة / 3) * 100
        اطبع(f"   ⚠️ سبرينت C مكتمل بنسبة {نسبة_الانجاز}%")
        اطبع("   📝 مكوّن واحد أو أكثر يحتاج إصلاح")
    وإلا:
        اطبع("   ❌ سبرينت C غير مكتمل")
        اطبع("   🔧 يحتاج إلى عمل إضافي كبير")
    
    اطبع("\n4️⃣ التوصيات:")
    
    إذا عدد_المكونات_المكتملة == 3:
        اطبع("   • اختبار شامل للتكامل بين المكونات")
        اطبع("   • إنشاء اختبار برامج بسيطة فعلية")
        اطبع("   • التحقق من جودة الكود المولد")
    وإلا:
        اطبع("   • إكمال المكوّنات المفقودة")
       اطبع("   • إصلاح المشاكل الموجودة")
        اطبع("   • إعادة اختبار جميع المكوّنات")
    
    أرجع {
        "محلل_لغوي": له_محلل_لغوي,
        "محلل_نحوي": له_محلل_نحوي,
        "مولد_كود": له_مولد_كود,
        "مكتمل": عدد_المكونات_المكتملة == 3,
        "نسبة_الانجاز": (عدد_المكونات_المكتملة / 3) * 100
    }

# دالة مساعدة للتحقق من وجود الملف
دالة ملف_موجود(اسم_الملف):
    محاولة:
        فتح(اسم_الملف، "قراءة")
        أرجع صحيح
    خطأ:
        أرجع خطأ

# تشغيل التقرير
نتائج_التقرير = تقرير_انجاز_سبرينت_C()

اطبع("\n" + "=" * 60)
إذا نتائج_التقرير["مكتمل"]:
    اطبع("🎉 تهانينا! سبرينت C مكتمل بنجاح")
وإلا:
    نسبة = نتائج_التقرير["نسبة_الانجاز"]
    إذا نسبة >= 66:
        اطبع(f"⚠️ سبرينت C قريب من الاكتمال ({نسبة}%)")
    وإلا:
        اطبع(f"❌ سبرينت C يحتاج إلى عمل إضافي ({نسبة}%)")
اطبع("=" * 60)