// الثوابت الرياضية الأساسية
ثابت π = 3.141592653589793
ثابت e = 2.718281828459045
ثابت φ = 1.618033988749895  // النسبة الذهبية

فئة رياضيات {
    // دوال العمليات الحسابية الأساسية
    دالة الضرب(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
        إرجاع أ * ب
    }

    دالة القيمة_المطلقة(عدد: عدد_عشري): عدد_عشري {
        إذا (عدد < 0) {
            إرجاع -عدد
        }
        إرجاع عدد
    }

    دالة العلامة(عدد: عدد_عشري): عدد_صحيح {
        إذا (عدد > 0) {
            إرجاع 1
        } وإلا إذا (عدد < 0) {
            إرجاع -1
        } وإلا {
            إرجاع 0
        }
    }

    دالة الحد_الأقصى(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
        إذا (أ > ب) {
            إرجاع أ
        }
        إرجاع ب
    }

    دالة الحد_الأدنى(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
        إذا (أ < ب) {
            إرجاع أ
        }
        إرجاع ب
    }

    دالة تقريب(عدد: عدد_عشري): عدد_صحيح {
        متغير الجزء_العشري = عدد - عدد.الجزء_الصحيح()
        إذا (الجزء_العشري >= 0.5) {
            إرجاع عدد.الجزء_الصحيح() + 1
        } وإلا {
            إرجاع عدد.الجزء_الصحيح()
        }
    }

    دالة تقريب_لأعلى(عدد: عدد_عشري): عدد_صحيح {
        متغير الجزء_الصحيح = عدد.الجزء_الصحيح()
        متغير الجزء_العشري = عدد - الجزء_الصحيح
        إذا (الجزء_العشري > 0) {
            إرجاع الجزء_الصحيح + 1
        }
        إرجاع الجزء_الصحيح
    }

    دالة تقريب_لأسفل(عدد: عدد_عشري): عدد_صحيح {
        إرجاع عدد.الجزء_الصحيح()
    }

    // دوال الأسس واللوغاريتمات
    دالة التربيع(عدد: عدد_عشري): عدد_عشري {
        إرجاع عدد * عدد
    }

    دالة التكعيب(عدد: عدد_عشري): عدد_عشري {
        إرجاع عدد * عدد * عدد
    }

    دالة الجذر_التربيعي(عدد: عدد_عشري): عدد_عشري {
        إذا (عدد < 0) {
            إرجاع 0.0  // خطأ: لا يمكن حساب جذر الرقم السالب
        }
        إذا (عدد == 0 أو عدد == 1) {
            إرجاع عدد
        }

        متغير تخمين = عدد / 2.0
        متغير دقة = 0.000001
        متغير تكرار = 0

        بينما (تكرار < 100) {  // حد أقصى للتكرارات
            متغير تخمين_جديد = (تخمين + عدد / تخمين) / 2.0
            إذا (هذا.القيمة_المطلقة(تخمين_جديد - تخمين) < دقة) {
                كسر
            }
            تخمين = تخمين_جديد
            تكرار = تكرار + 1
        }
        إرجاع تخمين
    }

    دالة الأس(القاعدة: عدد_عشري، الأس: عدد_عشري): عدد_عشري {
        إذا (القاعدة == 0) {
            إرجاع 0.0
        }
        إذا (الأس == 0) {
            إرجاع 1.0
        }
        إذا (الأس == 1) {
            إرجاع القاعدة
        }

        // تنفيذ بسيط باستخدام خوارزمية الضرب المتكرر
        متغير نتيجة = 1.0
        متغير أس_مطلق = هذا.القيمة_المطلقة(الأس)
        متغير أس_صحيح = أس_مطلق.الجزء_الصحيح()

        لـ (متغير ع = 0؛ ع < أس_صحيح؛ ع = ع + 1) {
            نتيجة = نتيجة * القاعدة
        }

        إذا (الأس < 0) {
            نتيجة = 1.0 / نتيجة
        }

        إرجاع نتيجة
    }

    دالة اللوغاريتم_الطبيعي(عدد: عدد_عشري): عدد_عشري {
        إذا (عدد <= 0) {
            إرجاع 0.0  // خطأ
        }
        إذا (عدد == 1) {
            إرجاع 0.0
        }

        // تنفيذ تقريبي بسيط
        متغير نتيجة = 0.0
        متغير مصطلح = (عدد - 1) / (عدد + 1)
        متغير مصطلح_تربيع = مصطلح * مصطلح
        متغير ع = 1

        بينما (ع < 20) {  // دقة محدودة
            نتيجة = نتيجة + مصطلح / ع
            مصطلح = مصطلح * مصطلح_تربيع
            ع = ع + 2
        }
        إرجاع 2 * نتيجة
    }

    دالة اللوغاريتم_العشري(عدد: عدد_عشري): عدد_عشري {
        إرجاع هذا.اللوغاريتم_الطبيعي(عدد) / هذا.اللوغاريتم_الطبيعي(10.0)
    }

    // دوال مثلثية
    دالة الجيب(زاوية_بالراديان: عدد_عشري): عدد_عشري {
        // تنفيذ سلسلة تايلور للجيب
        متغير نتيجة = 0.0
        متغير مصطلح = زاوية_بالراديان
        متغير علامة = 1
        متغير مقسوم = 1

        لـ (متغير ن = 0؛ ن < 10؛ ن = ن + 1) {
            نتيجة = نتيجة + علامة * مصطلح / مقسوم
            مصطلح = مصطلح * زاوية_بالراديان * زاوية_بالراديان
            مقسوم = مقسوم * (2 * ن + 2) * (2 * ن + 3)
            علامة = -علامة
        }
        إرجاع نتيجة
    }

    دالة جيب_تمام(زاوية_بالراديان: عدد_عشري): عدد_عشري {
        إرجاع هذا.الجيب(π/2 - زاوية_بالراديان)
    }

    دالة الظل(زاوية_بالراديان: عدد_عشري): عدد_عشري {
        إرجاع هذا.الجيب(زاوية_بالراديان) / هذا.جيب_تمام(زاوية_بالراديان)
    }

    دالة الجيب_الزائدي(زاوية_بالراديان: عدد_عشري): عدد_عشري {
        متغير جيب = هذا.الجيب(زاوية_بالراديان)
        إرجاع هذا.الجذر_التربيعي(1 - جيب * جيب)
    }

    // دوال تحويل الزوايا
    دالة راديان_إلى_درجة(راديان: عدد_عشري): عدد_عشري {
        إرجاع راديان * 180.0 / π
    }

    دالة درجة_إلى_راديان(درجة: عدد_عشري): عدد_عشري {
        إرجاع درجة * π / 180.0
    }

    // دوال الأرقام العشوائية
    دالة عشوائي(): عدد_عشري {
        // تنفيذ بسيط - في الواقع سيستخدم مولد أرقام عشوائية حقيقي
        إرجاع 0.5  // قيمة ثابتة للاختبار
    }

    دالة عشوائي_بين(الحد_الأدنى: عدد_عشري، الحد_الأقصى: عدد_عشري): عدد_عشري {
        متغير نطاق = الحد_الأقصى - الحد_الأدنى
        إرجاع الحد_الأدنى + هذا.عشوائي() * نطاق
    }

    دالة عشوائي_صحيح(الحد_الأقصى: عدد_صحيح): عدد_صحيح {
        إرجاع (هذا.عشوائي() * الحد_الأقصى).الجزء_الصحيح()
    }

    دالة عشوائي_صحيح_بين(الحد_الأدنى: عدد_صحيح، الحد_الأقصى: عدد_صحيح): عدد_صحيح {
        متغير نطاق = الحد_الأقصى - الحد_الأدنى + 1
        إرجاع الحد_الأدنى + هذا.عشوائي_صحيح(نطاق)
    }

    // دوال إحصائية أساسية
    دالة المتوسط(أرقام: قائمة): عدد_عشري {
        إذا (أرقام.فارغ()) {
            إرجاع 0.0
        }

        متغير مجموع = 0.0
        لـ (متغير ع = 0؛ ع < أرقام.الحصول_على_الحجم()؛ ع = ع + 1) {
            مجموع = مجموع + أرقام.الحصول(ع)
        }
        إرجاع مجموع / أرقام.الحصول_على_الحجم()
    }

    دالة الوسيط(أرقام: قائمة): عدد_عشري {
        إذا (أرقام.فارغ()) {
            إرجاع 0.0
        }

        متغير قائمة_مرتبة = أرقام.نسخ()
        قائمة_مرتبة.فرز()

        متغير حجم = قائمة_مرتبة.الحصول_على_الحجم()
        متغير منتصف = حجم / 2

        إذا (حجم % 2 == 1) {
            إرجاع قائمة_مرتبة.الحصول(منتصف)
        } وإلا {
            متغير أ = قائمة_مرتبة.الحصول(منتصف - 1)
            متغير ب = قائمة_مرتبة.الحصول(منتصف)
            إرجاع (أ + ب) / 2.0
        }
    }

    دالة المنوال(أرقام: قائمة): عدد_عشري {
        إذا (أرقام.فارغ()) {
            إرجاع 0.0
        }

        متغير عد_التكرارات = خريطة_جديدة()
        متغير أكبر_عد = 0
        متغير المنوال = أرقام.الحصول(0)

        لـ (متغير ع = 0؛ ع < أرقام.الحصول_على_الحجم()؛ ع = ع + 1) {
            متغير رقم = أرقام.الحصول(ع)
            متغير عد_حالي = عد_التكرارات.الحصول(رقم)
            إذا (عد_حالي == لا_شيء) {
                عد_التكرارات.وضع(رقم، 1)
                عد_حالي = 1
            } وإلا {
                عد_التكرارات.وضع(رقم، عد_حالي + 1)
                عد_حالي = عد_حالي + 1
            }

            إذا (عد_حالي > أكبر_عد) {
                أكبر_عد = عد_حالي
                المنوال = رقم
            }
        }
        إرجاع المنوال
    }

    // دوال رياضية متقدمة
    دالة المعامل_الثنائي(ن: عدد_صحيح، ك: عدد_صحيح): عدد_صحيح {
        إذا (ك < 0 أو ك > ن) {
            إرجاع 0
        }
        إذا (ك == 0 أو ك == ن) {
            إرجاع 1
        }

        متغير نتيجة = 1
        متغير ك_أصغر = هذا.الحد_الأدنى(ك، ن - ك)

        لـ (متغير ع = 1؛ ع <= ك_أصغر؛ ع = ع + 1) {
            نتيجة = نتيجة * (ن - ك_أصغر + ع) / ع
        }
        إرجاع نتيجة.الجزء_الصحيح()
    }

    دالة العاملي(عدد: عدد_صحيح): عدد_صحيح {
        إذا (عدد < 0) {
            إرجاع 0
        }
        إذا (عدد == 0 أو عدد == 1) {
            إرجاع 1
        }

        متغير نتيجة = 1
        لـ (متغير ع = 2؛ ع <= عدد؛ ع = ع + 1) {
            نتيجة = نتيجة * ع
        }
        إرجاع نتيجة
    }

    // دوال هندسية أساسية
    دالة مساحة_الدائرة(نصف_القطر: عدد_عشري): عدد_عشري {
        إرجاع π * هذا.التربيع(نصف_القطر)
    }

    دالة محيط_الدائرة(نصف_القطر: عدد_عشري): عدد_عشري {
        إرجاع 2 * π * نصف_القطر
    }

    دالة مساحة_المستطيل(طول: عدد_عشري، عرض: عدد_عشري): عدد_عشري {
        إرجاع طول * عرض
    }

    دالة مساحة_المثلث(قاعدة: عدد_عشري، ارتفاع: عدد_عشري): عدد_عشري {
        إرجاع قاعدة * ارتفاع / 2.0
    }

    دالة مساحة_المربع(ضلع: عدد_عشري): عدد_عشري {
        إرجاع هذا.التربيع(ضلع)
    }

    // دوال المسافات
    دالة المسافة_بين_نقطتين(س1: عدد_عشري، ص1: عدد_عشري، س2: عدد_عشري، ص2: عدد_عشري): عدد_عشري {
        متغير فرق_س = س2 - س1
        متغير فرق_ص = ص2 - ص1
        إرجاع هذا.الجذر_التربيعي(فرق_س * فرق_س + فرق_ص * فرق_ص)
    }

    // دوال التحقق من الأرقام
    دالة هل_عدد_أولي(عدد: عدد_صحيح): منطقي {
        إذا (عدد <= 1) {
            إرجاع خطأ
        }
        إذا (عدد <= 3) {
            إرجاع صحيح
        }
        إذا (عدد % 2 == 0 أو عدد % 3 == 0) {
            إرجاع خطأ
        }

        متغير ع = 5
        بينما (ع * ع <= عدد) {
            إذا (عدد % ع == 0 أو عدد % (ع + 2) == 0) {
                إرجاع خطأ
            }
            ع = ع + 6
        }
        إرجاع صحيح
    }

    دالة هل_عدد_مثالي(عدد: عدد_صحيح): منطقي {
        إذا (عدد <= 0) {
            إرجاع خطأ
        }

        متغير مجموع_المقسمات = 0
        لـ (متغير ع = 1؛ ع < عدد؛ ع = ع + 1) {
            إذا (عدد % ع == 0) {
                مجموع_المقسمات = مجموع_المقسمات + ع
            }
        }
        إرجاع مجموع_المقسمات == عدد
    }

    دالة أكبر_مقسوم_مشترك(أ: عدد_صحيح، ب: عدد_صحيح): عدد_صحيح {
        أ = هذا.القيمة_المطلقة(أ)
        ب = هذا.القيمة_المطلقة(ب)

        بينما (ب != 0) {
            متغير مؤقت = ب
            ب = أ % ب
            أ = مؤقت
        }
        إرجاع أ
    }

    دالة أصغر_مضاعف_مشترك(أ: عدد_صحيح، ب: عدد_صحيح): عدد_صحيح {
        متغير حاصل_الضرب = أ * ب
        متغير أكبر_مقسوم = هذا.أكبر_مقسوم_مشترك(أ، ب)
        إرجاع حاصل_الضرب / أكبر_مقسوم
    }
}

// دالة منشئ للصنف
دالة رياضيات_جديدة(): رياضيات {
    إرجاع جديد رياضيات()
}

// دوال مساعدة عامة
دالة جذر_تربيعي(عدد: عدد_عشري): عدد_عشري {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.الجذر_التربيعي(عدد)
}

دالة جيب(زاوية: عدد_عشري): عدد_عشري {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.الجيب(زاوية)
}

دالة عشوائي(): عدد_عشري {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.عشوائي()
}

دالة الحد_الأقصى(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.الحد_الأقصى(أ، ب)
}

دالة الحد_الأدنى(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.الحد_الأدنى(أ، ب)
}

دالة تقريب(عدد: عدد_عشري): عدد_صحيح {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.تقريب(عدد)
}

دالة العاملي(عدد: عدد_صحيح): عدد_صحيح {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.العاملي(عدد)
}

دالة ضرب(أ: عدد_عشري، ب: عدد_عشري): عدد_عشري {
    إرجاع أ * ب
}

دالة هل_عدد_أولي(عدد: عدد_صحيح): منطقي {
    متغير رياضيات = رياضيات_جديدة()
    إرجاع رياضيات.هل_عدد_أولي(عدد)
}
