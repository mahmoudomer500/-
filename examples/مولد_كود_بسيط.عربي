# مولد_كود_بسيط.عربي
# نسخة مبسطة من مولد الكود

صف تعليمات_آلة:
    عام:
        نص النوع
        نص المعامل_الأول
        نص المعامل_الثاني
        نص المعامل_الثالث
        رقم رقم_السطر
        
        دالة جديد(نوع، معامل1 = ""، معامل2 = ""، معامل3 = ""، سطر = 0):
            هذا.النوع = نوع
            هذا.المعامل_الأول = معامل1
            هذا.المعامل_الثاني = معامل2
            هذا.المعامل_الثالث = معامل3
            هذا.رقم_السطر = سطر
        
        دالة إلى_نص():
            أرجع هذا.النوع + " " + هذا.المعامل_الأول + " " + هذا.المعامل_الثاني

صف مولد_كود:
    خاص:
        مصفوفة التعليمات
        رقم العداد
        
    عام:
        دالة جديد():
            هذا.التعليمات = []
            هذا.العداد = 0
        
        دالة جديد_تعليمه(نوع، م1 = ""، م2 = ""):
            هذا.العداد = هذا.العداد + 1
            أرجع تعليمات_آلة.جديد(نوع، م1، م2، ""، هذا.العداد)
        
        دالة أضف(تعليمه):
            هذا.التعليمات.أضف(تعليمه)
        
        دالة اطبع():
            متغير ط = 0
            بينما ط < طول(هذا.التعليمات):
                متغير ت = هذا.التعليمات[ط]
                اطبع(ت.النوع + " " + ت.المعامل_الأول + " " + ت.المعامل_الثاني)
                ط = ط + 1
        
        # توليد برنامج بسيط
        دالة توليد(متغير1، متغير2، نتيجة):
            هذا.أضف(هذا.جديد_تعليمه("LOAD", متغير1))
            هذا.أضف(هذا.جديد_تعليمه("LOAD", متغير2))
            هذا.أضف(هذا.جديد_تعليمه("ADD", "ACC"))
            هذا.أضف(هذا.جديد_تعليمه("STORE", نتيجة))
            هذا.أضف(هذا.جديد_تعليمه("HALT"))
