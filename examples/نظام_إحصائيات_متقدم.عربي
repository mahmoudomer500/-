"""

            # استبدال القيم
            بناء = هذا.مؤشرات_الأداء["البناء"]
            أداء = هذا.مؤشرات_الأداء["الأداء"]

            تقرير = استبدال(تقرير, "{التاريخ}", التاريخ_والوقت_الحالي())
