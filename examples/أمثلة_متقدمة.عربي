# مثال 3: معالجة الملفات المتقدمة
# ========================================

اطبع("\n📄 مثال 3: معالجة الملفات المتقدمة")

دالة احسب_عدد_الكلمات(نص)
    متغير عدد_الكلمات = 0
    متغير في_كلمة = خطأ
    متغير فهرس = 0

    طالما فهرس < طول(نص)
        متغير حرف = نص[فهرس]
        إذا حرف != " " و حرف != "\t" و حرف != "\n"
            إذا لا في_كلمة
                عدد_الكلمات = عدد_الكلمات + 1
                في_كلمة = صحيح
            نهاية
        وإلا
            في_كلمة = خطأ
        نهاية
        فهرس = فهرس + 1
    نهاية

    ارجع عدد_الكلمات
نهاية

دالة اقرأ_ملف_نصي(اسم_الملف)
    # محاولة قراءة الملف
    متغير محتوى = اقرأ_ملف(اسم_الملف)
    إذا محتوى == ""
        ارجع "خطأ: لا يمكن قراءة الملف " + اسم_الملف
    نهاية

    متغير عدد_السطور = 1  # على الأقل سطر واحد إذا كان الملف غير فارغ
    متغير فهرس = 0
    طالما فهرس < طول(محتوى)
        إذا محتوى[فهرس] == "\n"
            عدد_السطور = عدد_السطور + 1
        نهاية
        فهرس = فهرس + 1
    نهاية

    متغير عدد_الكلمات = احسب_عدد_الكلمات(محتوى)
    متغير عدد_الحروف = طول(محتوى)

    ارجع "إحصائيات الملف " + اسم_الملف + ":\n" +
         "عدد السطور: " + عدد_السطور + "\n" +
         "عدد الكلمات: " + عدد_الكلمات + "\n" +
         "عدد الحروف: " + عدد_الحروف
نهاية

