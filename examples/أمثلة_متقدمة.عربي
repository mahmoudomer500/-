# مثال 1: نظام إدارة المكتبة
# ========================================

اطبع("\n📚 مثال 1: نظام إدارة المكتبة")

صنف كتاب
    خاصية عنوان = ""
    خاصية مؤلف = ""
    خاصية isbn = ""
    خاصية متوفر = صحيح

    دالة إنشاء(معامل_عنوان, معامل_مؤلف, معامل_isbn)
        هذا.عنوان = معامل_عنوان
        هذا.مؤلف = معامل_مؤلف
        هذا.isbn = معامل_isbn
        هذا.متوفر = صحيح
    نهاية

    دالة اقترض()
        إذا هذا.متوفر
            هذا.متوفر = خطأ
            اطبع("تم اقتراض الكتاب: " + هذا.عنوان)
        وإلا
            اطبع("الكتاب غير متوفر: " + هذا.عنوان)
        نهاية
    نهاية

    دالة أعد()
        هذا.متوفر = صحيح
        اطبع("تم إعادة الكتاب: " + هذا.عنوان)
    نهاية
نهاية

صنف مكتبة
    خاصية اسم = ""
    خاصية كتب = []

    دالة إنشاء(معامل_اسم)
        هذا.اسم = معامل_اسم
        هذا.كتب = []
    نهاية

    دالة أضف_كتاب(كتاب)
        هذا.كتب = هذا.كتب + [كتاب]
        اطبع("تم إضافة الكتاب: " + كتاب.عنوان)
    نهاية

    دالة ابحث_بالعنوان(عنوان_مطلوب)
        متغير فهرس = 0
        طالما فهرس < طول(هذا.كتب)
            إذا هذا.كتب[فهرس].عنوان == عنوان_مطلوب
                ارجع هذا.كتب[فهرس]
            نهاية
            فهرس = فهرس + 1
        نهاية
        ارجع لا_شيء  # لم يتم العثور
    نهاية

    دالة عرض_الكتب_المتوفرة()
        اطبع("الكتب المتوفرة في مكتبة " + هذا.اسم + ":")
        متغير فهرس = 0
        طالما فهرس < طول(هذا.كتب)
            إذا هذا.كتب[فهرس].متوفر
                اطبع("  - " + هذا.كتب[فهرس].عنوان + " بقلم " + هذا.كتب[فهرس].مؤلف)
            نهاية
            فهرس = فهرس + 1
        نهاية
    نهاية
نهاية

# استخدام نظام المكتبة
متغير مكتبة_جامعة = جديد مكتبة("مكتبة الجامعة")

متغير كتاب1 = جديد كتاب("البرمجة بلغة C++", "أحمد محمد", "123456789")
