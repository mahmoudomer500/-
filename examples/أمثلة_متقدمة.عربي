صنف طالب يمتد شخص
    خاصية رقم_الطالب = 0
    خاصية التخصص = ""
    خاصية الدرجات = []

    دالة إنشاء(معامل_اسم, معامل_عمر, معامل_رقم, معامل_تخصص)
        # استدعاء دالة الأب
        هذا.إنشاء(معامل_اسم, معامل_عمر)
