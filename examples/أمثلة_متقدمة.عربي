# مثال 4: خوارزميات البحث والترتيب
# ========================================

اطبع("\n🔍 مثال 4: خوارزميات البحث والترتيب")

دالة بحث_خطي(قائمة, قيمة_مطلوبة)
    متغير فهرس = 0
    طالما فهرس < طول(قائمة)
        إذا قائمة[فهرس] == قيمة_مطلوبة
            ارجع فهرس
        نهاية
        فهرس = فهرس + 1
    نهاية
    ارجع -1  # لم يتم العثور
نهاية

دالة بحث_ثنائي(قائمة, قيمة_مطلوبة)
    متغير بداية = 0
    متغير نهاية = طول(قائمة) - 1

    طالما بداية <= نهاية
        متغير منتصف = (بداية + نهاية) / 2
        إذا قائمة[منتصف] == قيمة_مطلوبة
            ارجع منتصف
        وإلا إذا قائمة[منتصف] < قيمة_مطلوبة
            بداية = منتصف + 1
        وإلا
            نهاية = منتصف - 1
        نهاية
    نهاية

    ارجع -1  # لم يتم العثور
نهاية

دالة رتب_بالفقاعات(قائمة)
    متغير ن = طول(قائمة)
    متغير فهرس_خارجي = 0

    طالما فهرس_خارجي < ن - 1
        متغير فهرس_داخلي = 0
        طالما فهرس_داخلي < ن - فهرس_خارجي - 1
            إذا قائمة[فهرس_داخلي] > قائمة[فهرس_داخلي + 1]
                # تبديل العناصر
                متغير مؤقت = قائمة[فهرس_داخلي]
                قائمة[فهرس_داخلي] = قائمة[فهرس_داخلي + 1]
                قائمة[فهرس_داخلي + 1] = مؤقت
            نهاية
            فهرس_داخلي = فهرس_داخلي + 1
        نهاية
        فهرس_خارجي = فهرس_خارجي + 1
    نهاية

    ارجع قائمة
نهاية

