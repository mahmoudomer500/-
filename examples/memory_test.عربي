# اختبار تحسينات إدارة الذاكرة
# اختبار المصفوفات والكائنات المعقدة

متغير مصفوفة_كبيرة[1000]

# ملء المصفوفة
لكل عداد من 0 إلى 999
    مصفوفة_كبيرة[عداد] = عداد * 2
نهاية

# إنشاء مصفوفة ثانوية
متغير مصفوفة_ثانوية[500]
لكل عداد من 0 إلى 499
    مصفوفة_ثانوية[عداد] = مصفوفة_كبيرة[عداد] + مصفوفة_كبيرة[عداد + 500]
نهاية

# اختبار الدوال
دالة معالجة_مصفوفة(المصفوفة, الحجم)
    متغير مجموع = 0
    لكل أي من 0 إلى الحجم - 1
        مجموع = مجموع + المصفوفة[أي]
    نهاية
    ارجع مجموع
نهاية

متغير نتيجة1 = معالجة_مصفوفة(مصفوفة_كبيرة, 1000)
متغير نتيجة2 = معالجة_مصفوفة(مصفوفة_ثانوية, 500)

اطبع "نتيجة المصفوفة الكبيرة: " نتيجة1
اطبع "نتيجة المصفوفة الثانوية: " نتيجة2
اطبع "اختبار إدارة الذاكرة مكتمل!"
