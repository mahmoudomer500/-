## مثال شامل

```عربي
# برنامج حساب المضروب
متغير العدد = 5
متغير النتيجة = 1

دالة مضروب(رقم):
    متغير عداد = 1
    متغير ناتج = 1
    
    بينما عداد <= رقم:
        ناتج = ناتج * عداد
        عداد = عداد + 1
    
    أرجع ناتج

متغير مضروب_العدد = مضروب(العدد)
اطبع("مضروب " + العدد + " = " + مضروب_العدد)

# اختبار شرطي
إذا مضروب_العدد == 120:
    اطبع("النتيجة صحيحة!")
وإلا:
    اطبع("خطأ في الحساب")
```

## تشغيل النظام

```عربي
# إنشاء مترجم شامل
متغير مترجم = مترجم_عربي_شامل.جديد()

# ترجمة البرنامج
متغير نتيجة = مترجم.ترجم_برنامج(كود_البرنامج)

# عرض النتائج
إذا نتيجة["نجح"]:
    اطبع("✅ نجح الترجمة")
    اطبع("عدد الرموز: " + نتيجة["إحصائيات"]["عدد_الرموز"])
    اطبع("عدد التعليمات: " + نتيجة["إحصائيات"]["عدد_التعليمات"])
وإلا:
    اطبع("❌ فشل الترجمة: " + نتيجة["خطأ"])
```

